+const std::vector<std::uint8_t>& LabelsBlock()
+{
+  // (Its own read: the screens' cache of files belongs to the video thread.) The mod directories are set
+  // at boot, before the first frame.
+  static const std::vector<std::uint8_t> block = [] {
+    for (const std::filesystem::path& dir : s_mod_directories)
+    {
+      std::ifstream in(dir / "srnp_etiquettes" / "files" / "GTSE", std::ios::binary);
+      if (!in)
+        continue;
+      const std::vector<std::uint8_t> raw((std::istreambuf_iterator<char>(in)), std::istreambuf_iterator<char>());
+      const std::vector<std::uint8_t> d = Decompress(raw);
+      static constexpr char kMark[] = "SRNPLBL1";
+      for (std::size_t i = 0; i + 0x20 <= d.size(); i += 4)
+        if (std::memcmp(d.data() + i, kMark, 8) == 0)
+          return std::vector<std::uint8_t>(d.begin() + static_cast<std::ptrdiff_t>(i), d.end());
+    }
+    return std::vector<std::uint8_t>{};
+  }();
+  return block;
+}
