+// Tournament Edition: the labels' colour, by the racer's character (+0xBA), comes from the US game's table
+// of 17 (0x805BE500, TE 0x8035D7D4), so TE's new characters (17-22) read what follows it: black labels
+// (2026-11-26). TE's own table of 23, the one its HUD reads, is at 0x80372D48 (Silver EBEBEB, Metal Sonic
+// 1239B8, Emerl BD9322, Blaze AC7FF5, Chaos 5ECFFF, Tikal FF8138). The 1P labels' lookup goes there:
+// addi r3, r22, 0 -> lis r3, 0x8037; extsb r0, r0 -> slwi r0, r0, 2 (a character is under 128);
+// slwi r0, r0, 2 -> addic r0, r0, 0x2D48 (addi would read r0 as 0; the carry is not read after); then
+// lwzx r0, r3, r0 reads 0x80372D48 + 4 x character.
+void TeLabelColours()
+{
+  struct Word
+  {
+    std::uint32_t us, original, ours;
+  };
+  static constexpr Word kWords[] = {
+      {0x8042F708, 0x38760000, 0x3C608037}, {0x8042F728, 0x7C000774, 0x5400103A}, {0x8042F734, 0x5400103A, 0x30002D48}};
+  static bool told = false;
+  bool ours = true, game = true;
+  for (const Word& w : kWords)
+  {
+    const std::uint32_t now = Read32(At(w.us));
+    ours = ours && now == w.ours;
+    game = game && now == w.original;
+  }
+  if (ours)
+    return;
+  if (!game)
+  {
+    if (!told)
+      std::fprintf(stderr, "[srnp labels] labels' colours: not TE's code here, left alone\n");
+    told = true;
+    return;
+  }
+  for (const Word& w : kWords)
+    WriteWords(At(w.us), &w.ours, 1);
+  std::fprintf(stderr, "[srnp labels] labels' colours from TE's table of 23 characters\n");
+}
