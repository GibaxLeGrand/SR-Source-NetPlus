+}
+std::uint32_t Bl(std::uint32_t from, std::uint32_t to)
+{
+  return 0x48000001u | ((to - from) & 0x03FFFFFCu);
+}
+// The routine for the game that runs, at RoutineAt(): its calls to the game's functions (the quad, the
+// texture's loader and binder) at their places, the current texture read through r13 at its place, the
+// tags' entry and table at theirs. 0 in the first word if a place is missing.
+const std::vector<std::uint32_t>& RoutineCode()
+{
+  static std::vector<std::uint32_t> code;
+  static Game made_for = Game::Other;
+  if (made_for == CurrentGame() && !code.empty())
+    return code;
+  made_for = CurrentGame();
+  code.assign(kRoutineCode.begin(), kRoutineCode.end());
+  const std::uint32_t at = RoutineAt();
+  // r13 (the small data's base): Sonic Riders US 0x802238C0, TE 0x8042DA60 (__init_registers).
+  const std::uint32_t r13 = OnTE() ? 0x8042DA60u : 0x802238C0u;
+  for (std::size_t i = 0; i < code.size(); ++i)
+  {
+    const std::uint32_t w = kRoutineCode[i];
+    const std::uint32_t us_here = kRoutine + 4u * static_cast<std::uint32_t>(i);
+    const std::uint32_t here = at + 4u * static_cast<std::uint32_t>(i);
+    if ((w >> 26) == 18u && (w & 1u))  // bl a function of the game's
+    {
+      std::uint32_t d = w & 0x03FFFFFCu;
+      if (d & 0x02000000u)
+        d |= 0xFC000000u;
+      const std::uint32_t target = At(us_here + d);
+      code[i] = target ? Bl(here, target) : 0;
+      if (!target)
+        code[0] = 0;
+    }
+    else if ((w >> 16) == 0x808Du)  // lwz r4, d(r13): the current texture
+    {
+      const std::uint32_t us_var = 0x802238C0u + static_cast<std::uint32_t>(static_cast<std::int16_t>(w & 0xFFFFu));
+      const std::uint32_t var = At(us_var);
+      code[i] = (w & 0xFFFF0000u) | ((var - r13) & 0xFFFFu);
+      if (!var)
+        code[0] = 0;
+    }
+    else if (w == 0x616B4F40u)  // ori r11, r11, kTagTable
+      code[i] = 0x616B0000u | (TagTableAt() & 0xFFFFu);
+    else if (w == 0x60634F00u)  // ori r3, r3, kTagEntry
+      code[i] = 0x60630000u | (TagEntryAt() & 0xFFFFu);
+  }
+  return code;
+}
