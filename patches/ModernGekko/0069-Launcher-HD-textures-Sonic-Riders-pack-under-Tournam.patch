     return success ? 0 : 1;
   }
 
@@ -6238,31 +6246,49 @@ int main(int argc, char** argv)
         install_status = textures_install.status;
         install_error = textures_install.error;
       }
-      const auto start_install = [&](const fs::path& folder, const std::string& game) {
+      const auto start_install = [&](const fs::path& folder, const std::string& game, bool base) {
