       const std::string game = argv[++i];
       hd_textures_only = std::make_pair(game, TextPath(argv[++i]));
     }
@@ -2786,14 +2789,19 @@ int main(int argc, char** argv)
     }
     moderngekko::frontend::textures::InstallState state;
     state.running = true;
-    const bool success = moderngekko::frontend::textures::InstallPack(
-        hd_textures_only->second, user_directory / "Mods", game, name, &state);
+    namespace textures = moderngekko::frontend::textures;
+    const std::string mod_id = hd_textures_base ? textures::BaseModId(game) : textures::ModId(game);
+    const std::string mod_name = hd_textures_base
+                                     ? std::string("HD textures (Sonic Riders' pack, under the ") + name + " one)"
+                                     : std::string("HD textures (") + name + ")";
+    const bool success = textures::InstallPack(hd_textures_only->second, user_directory / "Mods", game,
+                                               mod_id, mod_name, &state);
     std::lock_guard lock(state.mutex);
     if (!success)
       std::cerr << "hd textures: " << state.error << '\n';
     else
-      std::cout << "hd textures: " << state.status << " in "
-                << PathText(user_directory / "Mods" / moderngekko::frontend::textures::ModId(game)) << '\n';
+      std::cout << "hd textures: " << state.status << " (" << PathText(user_directory / "Mods" / mod_id)
