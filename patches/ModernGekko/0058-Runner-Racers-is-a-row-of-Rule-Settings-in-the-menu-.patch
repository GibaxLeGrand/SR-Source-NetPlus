-  const std::uint8_t* d = data >= 0x80000000u ? GuestByte(data) : nullptr;
-  if (!t || t[20] != 22 || !d || d[156] != 2)
+  std::uint8_t* d = data >= 0x80000000u ? GuestByte(data) : nullptr;
+  const bool shown = t && t[20] == 3 && d && d[29] == 0 && (d[31] == 8 || d[31] == 9);
+  if (!shown)
   {
+    PatchRulesMenu(false);
     s_rules_row = -1;
     return;
   }
+  PatchRulesMenu(true);
+  if (!s_rules_patched)
+    return;
+  if (d[31] == 8)
+    d[31] = 9;
+  MoveDefault();
+  const int cursor = static_cast<std::int8_t>(d[30]);
   static int held = 0;
   const GCPadStatus s = ::Pad::GetStatus(0);
-  const bool l = (s.button & 0x0040) != 0 || s.triggerLeft > 170;
-  const bool r = (s.button & 0x0020) != 0 || s.triggerRight > 170;
-  if (l != r)
+  const bool left = cursor == 6 && ((s.button & 0x0001) != 0 || s.stickX < 128 - 60);
+  const bool right = cursor == 6 && ((s.button & 0x0002) != 0 || s.stickX > 128 + 60);
+  if (left != right)
   {
     // A press, then again every 6 frames once held for 20.
     if (held == 0 || (held > 20 && held % 6 == 0))
     {
-      const int v = std::clamp(MenuRacers() + (r ? 1 : -1), 1, 8);
+      const int v = std::clamp(MenuRacers() + (right ? 1 : -1), 1, 8);
       if (v != MenuRacers())
       {
         SetNbRacers(v);
@@ -1286,6 +1375,16 @@ void RulesMenuOnFrame()
   }
   else
     held = 0;
+  // A on Default (entry 7) resets the game's rows: the racers too (8, the game's).
+  static bool a_before = false;
+  const bool a = (s.button & 0x0100) != 0;
+  if (a && !a_before && cursor == 7 && MenuRacers() != 8)
+  {
+    SetNbRacers(8);
+    std::fprintf(stderr, "[srnp relay] Rule Settings: Default, 8 racers\n");
+  }
+  a_before = a;
+  s_rules_selected = cursor == 6;
   s_rules_row = MenuRacers();
 }
 
@@ -1691,4 +1790,9 @@ int RulesRowRacers()
 {
   return s_rules_row.load();
 }
