@@ -1246,36 +1247,124 @@ std::uint32_t FindMenuTask()
 
 // The racers on Rule Settings (Gibax, 2026-11-26: "on est capable de choisir le nombre de racers par
 // course, faudrait ajouter cette option au jeu normal (même endroit qu'on ajuste les laps) in game, pour
-// du offline aussi"). The menus' task 0x8050EDB8 (its data at [task + 16]) is in its state 22 on Track
-// Select and Rule Settings; its data's +156 is 2 on Rule Settings (4 on Track Select), +158 the cursor
-// (RAM dumps of 2026-11-26). There a row "Racers" is drawn under Air Lost (DrawRulesRow); L and R, which
-// that menu leaves alone (measured), change it, 1 to 8 (8: the game's). The host's choice goes to the
-// relay with the course and laps (SendRules); alone, OfflineRacersFrame writes it into the race.
+// du offline aussi"; then: Default beside CONTINUE, the row reached with the cursor like the others, in
+// the menu's own font, its value in their column). Rule Settings is the task 0x805A6660 (made by Track
+// Select, 0x80534AC4): its data ([task + 16]) has the rows' masks in the rules word (+0, six words), the
+// menu's kind (+29: 0 for Free Race), the cursor (+30), the entries (+31: eight, the six rows, Default,
+// CONTINUE), the values (+32), maxima (+38), minima (+44); its input (0x805A68C4) moves the cursor over
+// the entries, changes a row's value with left/right when the cursor is under entries - 2, writes the
+// rows into the rules word on A at CONTINUE (entries - 1) and resets them on A at Default (entries - 2).
+// The elements' highlights follow entries - 1 and - 2 too (0x805A74DC, 0x805A759C). Here, while the Free
+// Race menu shows: nine entries (the row "Racers" at 6, Default 7, CONTINUE 8); the game's rows stay
+// six (four words: left, right, CONTINUE's and Default's loops count entries - 3); the runner changes
+// the racers with left/right on entry 6; Default's element (its 2D object, 0x805A759C: a 3x4 matrix at
+// its head, x at +12, y at +28) moves beside CONTINUE; the row is drawn with the menu's own pictures
+// (DrawRulesRow). The host's choice goes to the relay with the course and laps (SendRules); alone,
+// OfflineRacersFrame writes it into the race.
 std::atomic<int> s_rules_row{-1};  // the count shown on Rule Settings (-1: not there)
+std::atomic<bool> s_rules_selected{false};
+struct RulesWord
+{
+  std::uint32_t address, original, patched;
+};
+constexpr RulesWord kRulesWords[] = {
+    {0x805A699C, 0x3803FFFE, 0x3803FFFD},  // addi r0, r3, -2 (left: a row) -> -3
+    {0x805A6A00, 0x3803FFFE, 0x3803FFFD},  // addi r0, r3, -2 (right: a row) -> -3
+    {0x805A6A78, 0x3804FFFE, 0x3804FFFD},  // addi r0, r4, -2 (CONTINUE: the rows written) -> -3
+    {0x805A6C30, 0x5405063E, 0x30A0FFFF},  // rlwinm r5, r0, 0, 24, 31 (Default: the rows reset) -> addic r5, r0, -1
+};
+bool s_rules_patched = false;
+
+void PatchRulesMenu(bool on)
+{
+  if (on == s_rules_patched)
+    return;
+  for (const RulesWord& w : kRulesWords)
+    if (GuestWord(w.address) != (on ? w.original : w.patched))
+    {
+      static bool told = false;
+      if (!told)
+        std::fprintf(stderr, "[srnp relay] Rule Settings: 0x%08X holds %08X: left alone\n", w.address,
+                     GuestWord(w.address));
+      told = true;
+      return;
+    }
+  auto& jit = Core::System::GetInstance().GetJitInterface();
+  for (const RulesWord& w : kRulesWords)
+  {
+    if (std::uint8_t* p = GuestByte(w.address))
+    {
+      const std::uint32_t v = on ? w.patched : w.original;
+      p[0] = static_cast<std::uint8_t>(v >> 24);
+      p[1] = static_cast<std::uint8_t>(v >> 16);
+      p[2] = static_cast<std::uint8_t>(v >> 8);
+      p[3] = static_cast<std::uint8_t>(v);
+    }
+    jit.InvalidateICache(w.address, 4, true);
+  }
+  s_rules_patched = on;
+  std::fprintf(stderr, "[srnp relay] Rule Settings: %s\n", on ? "the racers' row (nine entries)" : "the game's");
+}
+
+// Default beside CONTINUE: its 2D object (the pool at [0x80682EF8], 128 objects of 192 bytes, the
+// element's function at +48) moved by its matrix (measured: x -130, y +29 puts it left of CONTINUE).
+void MoveDefault()
+{
+  const std::uint32_t pool = GuestWord(0x80682EF8u);
+  if (pool < 0x80000000u)
+    return;
+  for (std::uint32_t k = 0; k < 128; ++k)
+  {
+    const std::uint32_t object = pool + 192 * k;
+    if (GuestWord(object + 48) != 0x805A759Cu)
+      continue;
+    if (std::uint8_t* m = GuestByte(object))
+    {
+      constexpr std::uint32_t kX = 0xC3020000u, kY = 0x41E80000u;  // -130.0f, 29.0f
+      for (const auto& [offset, value] : {std::pair{12u, kX}, std::pair{28u, kY}})
+      {
+        m[offset] = static_cast<std::uint8_t>(value >> 24);
+        m[offset + 1] = static_cast<std::uint8_t>(value >> 16);
+        m[offset + 2] = static_cast<std::uint8_t>(value >> 8);
+        m[offset + 3] = static_cast<std::uint8_t>(value);
+      }
+    }
+    return;
+  }
+}
 
 void RulesMenuOnFrame()
 {
   static std::uint32_t task = 0;
-  if (task == 0 || GuestWord(task) != 0x8050EDB8u)
-    task = FindTask(0x8050EDB8u);
+  if (task == 0 || GuestWord(task) != 0x805A6660u)
+    task = FindTask(0x805A6660u);
   const std::uint8_t* t = task ? GuestByte(task) : nullptr;
