+// Race over: the AI finishes for the seats still driven (the game's CPUs only: the AI of a racer that
+// was human at the start reads data the game did not make, 2026-11-25), and the code words come back.
+static void RaceOver(std::uint8_t* racers)
+{
+  for (std::size_t k = 0; k < 8; ++k)
+    if (!s_seats[k].released && s_seats[k].written == 0 && s_seats[k].cpu_at_start)
+      racers[k * kRacerSize + kControl] = racers[k * kRacerSize + kCpuFlag] = 1;
+  s_race = false;
+  PatchHud(0);
+  PatchAnimation(false);
+  PatchZones(false);
+  PatchSeatDisplays(-1);
+  PatchIntro(-1, 0);
+  PatchFinish(-1, 0);
+  PatchCameras(racers, -1, -1);
+  PatchTest(false);
+}
+
+void MenusOnPort0()
+{
+  // The menus after the race read the players' controller structures (0x8040BC60: from racer 0, as
+  // many racers as players, a player's only, +0xBD == 0, OR-ed into 0x80612B30); out of the lockstep,
+  // racer 0 points to port 0's structure as in a 1P game, the pad this machine's player drives.
+  std::uint8_t* racer = Guest(kRacers, kRacerSize);
+  if (!racer)
+    return;
+  Put32(racer, kGamePads);
+  racer[kCpuFlag] = 0;
+}
+
+void EndRace()
+{
+  std::uint8_t* racers = Guest(kRacers, 8 * kRacerSize);
+  if (!s_race || !racers)
+    return;
+  RaceOver(racers);
+  std::fprintf(stderr, "[srnp racers] race ended by the runner (a state is loaded over it): racers back to the game\n");
+}
