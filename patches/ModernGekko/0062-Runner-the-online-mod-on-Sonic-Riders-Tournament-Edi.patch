diff --git a/src/runtime/srnp_game.cpp b/src/runtime/srnp_game.cpp
new file mode 100644
index 0000000..0b3b663
--- /dev/null
+++ b/src/runtime/srnp_game.cpp
@@ -0,0 +1,127 @@
+// SR-Source Net Plus: the games the online mod knows. See srnp_game.hpp.
+// SPDX-License-Identifier: GPL-3.0-or-later
+#include "srnp_game.hpp"
+
+#include <algorithm>
+#include <atomic>
+#include <cstdio>
+
+namespace srnp
+{
+namespace
+{
+struct Range
+{
+  std::uint32_t us_start, us_end, te_start;
+};
+constexpr Range kTE[] = {
+#include "srnp_game_te.inc"
+};
+
+std::atomic<Game> s_game{Game::Other};
+
+// The shape of an instruction: its opcode and registers, without the immediate or the branch's distance.
+std::uint32_t Shape(std::uint32_t w)
+{
+  const std::uint32_t op = w >> 26;
+  if (op == 18)  // b, bl
+    return w & 0xFC000003u;
+  if (op == 16)  // bc
+    return w & 0xFFFF0003u;
+  if ((op >= 7 && op <= 15) || (op >= 24 && op <= 29) || (op >= 32 && op <= 55))  // 16-bit immediate
+    return w & 0xFFFF0000u;
+  return w;
+}
+
+bool DForm(std::uint32_t op)
+{
+  return (op >= 7 && op <= 15) || (op >= 24 && op <= 29) || (op >= 32 && op <= 55);
+}
+
+std::int32_t Sext(std::uint32_t v, int bits)
+{
+  const std::uint32_t m = 1u << (bits - 1);
+  return static_cast<std::int32_t>((v ^ m) - m);
+}
+}  // namespace
+
+void SetGameId(const std::string& id)
+{
+  const Game g = id == "GXEE8P" ? Game::Riders : id == "GXSRTE" ? Game::TE : Game::Other;
+  s_game.store(g);
+  std::fprintf(stderr, "[srnp game] %s: %s\n", id.c_str(), GameName());
+}
+
+Game CurrentGame()
+{
+  return s_game.load(std::memory_order_relaxed);
+}
+
+const char* GameName()
+{
+  switch (CurrentGame())
+  {
+  case Game::Riders:
+    return "Sonic Riders (US)";
+  case Game::TE:
+    return "Sonic Riders Tournament Edition";
+  default:
+    return "not a game of the online mod";
+  }
+}
+
+std::uint32_t At(std::uint32_t us)
+{
+  switch (CurrentGame())
+  {
+  case Game::Riders:
+    return us;
+  case Game::TE:
+  {
+    const Range* end = kTE + sizeof(kTE) / sizeof(kTE[0]);
+    const Range* r = std::upper_bound(kTE, end, us,
+                                      [](std::uint32_t a, const Range& x) { return a < x.us_start; });
+    if (r == kTE)
+      return 0;
+    --r;
+    return us < r->us_end ? r->te_start + (us - r->us_start) : 0;
+  }
+  default:
+    return 0;
+  }
+}
+
+bool SameInstruction(std::uint32_t us_word, std::uint32_t word)
+{
+  if (CurrentGame() != Game::TE)
+    return word == us_word;
+  return Shape(word) == Shape(us_word);
+}
+
+std::uint32_t InGame(std::uint32_t us_address, std::uint32_t us_word, std::uint32_t us_original,
+                     std::uint32_t original)
+{
+  if (CurrentGame() != Game::TE)
+    return us_word;
+  const std::uint32_t op = us_word >> 26;
+  const std::uint32_t at = At(us_address);
+  if ((op == 18 || op == 16) && (us_word & 2u) == 0 && at != 0)
+  {
+    // A relative branch: to its target's place.
+    const std::int32_t d = op == 18 ? Sext(us_word & 0x03FFFFFCu, 26) : Sext(us_word & 0xFFFCu, 16);
+    const std::uint32_t target = At(us_address + static_cast<std::uint32_t>(d));
+    if (target != 0)
+    {
+      const std::uint32_t rel = target - at;
+      return op == 18 ? (us_word & 0xFC000003u) | (rel & 0x03FFFFFCu) : (us_word & 0xFFFF0003u) | (rel & 0xFFFCu);
+    }
+    return 0;  // no place for the target: no word
+  }
+  // The same instruction (opcode, rD, rA) with another immediate: the change on TE's own immediate (the
+  // racers' low half plus a seat's offset, a constant compared...). Another instruction: as written (its
+  // immediate a field's offset or a constant; one holding an address is made for the game by the caller).
+  if (DForm(op) && (us_word & 0xFFFF0000u) == (us_original & 0xFFFF0000u))
+    return (us_word & 0xFFFF0000u) | ((original + (us_word - us_original)) & 0xFFFFu);
+  return us_word;
+}
+}  // namespace srnp
diff --git a/src/runtime/srnp_game.hpp b/src/runtime/srnp_game.hpp
new file mode 100644
index 0000000..40a9bd7
--- /dev/null
+++ b/src/runtime/srnp_game.hpp
@@ -0,0 +1,48 @@
+// SR-Source Net Plus: the games the online mod knows, and where Sonic Riders US's addresses are in
+// Tournament Edition.
+// SPDX-License-Identifier: GPL-3.0-or-later
+//
+// The mod's code is written with Sonic Riders US's addresses (GXEE8P: main.dol and _Main.rel loaded at
+// 0x803FBD00). Tournament Edition (GXSRTE, 2.4.6.1: everything in main.dol) has the same code for the most
+// part, moved, and the same structures (a racer is 0x1080 bytes, its fields at the same offsets: measured
+// on 2026-11-26). At(us) gives a US address's place in the game that runs, from a table of ranges made from
+// the two games' code (srnp_game_te.inc, by work/te/adresses/carte.py and genere_inc.py: code matched by
+// the instructions' shape, data by the instructions that compute their addresses).
+#pragma once
+
+#include <cstdint>
+#include <string>
+
+namespace srnp
+{
+enum class Game
+{
+  Other,
+  Riders,  // Sonic Riders US, GXEE8P
+  TE,      // Sonic Riders Tournament Edition, GXSRTE
+};
+
+// The disc's ID, at boot (dolphin_runtime.cpp, before the hooks are set).
+void SetGameId(const std::string& id);
+Game CurrentGame();
+const char* GameName();
+
+// A Sonic Riders US address in the game that runs: itself on GXEE8P; on TE, its place from the table, or
+// 0 if the table has none (the caller then leaves that part out).
+std::uint32_t At(std::uint32_t us);
+
+// An instruction found in the game where the mod expects the US one: the same word on GXEE8P; on TE the
+// same opcode and registers (the immediates and the branches' distances move with the code and data).
+bool SameInstruction(std::uint32_t us_word, std::uint32_t word);
+
+// The mod's word for a site of the game's code, in the game that runs. On GXEE8P, us_word. On TE: a relative
+// branch (b, bl, bc) goes to its US target's place in TE (a cave in low memory stays where it is); the same
+// instruction as the US original with another 16-bit immediate gets the US change on TE's original (an
+// address's low half plus an offset, a constant compared: the change is the same, TE's base its own);
+// anything else as is (a word holding an address of its own is made for the game by the caller).
+// us_original is the US word at us_address, original the game's word there. 0 when it cannot be made (a
+// branch whose target has no place in TE).
+std::uint32_t InGame(std::uint32_t us_address, std::uint32_t us_word, std::uint32_t us_original,
+                     std::uint32_t original);
+
+}  // namespace srnp
