@@ -40,6 +40,7 @@
 #include <string>
 #include <vector>
 
+#include "Core/HW/DSP.h"
 #include "Core/HW/Memmap.h"
 #include "Core/System.h"
 #include "Core/HW/GCPad.h"
@@ -548,9 +549,49 @@ std::uint32_t GameFrameHookAddress()
   return address;
 }
 
+// SRNP_ARAMDUMP=<frame>,<frame>...:<folder> (tests): the 16 MB of ARAM written to
+// <folder>/aram_<frame>.bin at those frames of the game.
+void AramDump(std::uint64_t frame)
+{
+  static const auto plan = [] {
+    std::pair<std::vector<std::uint64_t>, std::string> p;
+    const char* v = std::getenv("SRNP_ARAMDUMP");
+    if (!v)
+      return p;
+    const std::string text(v);
+    const std::size_t colon = text.find(':', 2);
+    if (colon == std::string::npos)
+      return p;
+    p.second = text.substr(colon + 1);
+    std::size_t at = 0;
+    while (at < colon)
+    {
+      p.first.push_back(std::strtoull(text.c_str() + at, nullptr, 10));
+      const std::size_t comma = text.find(',', at);
+      if (comma == std::string::npos || comma > colon)
+        break;
+      at = comma + 1;
+    }
+    return p;
+  }();
+  if (plan.first.empty() || std::find(plan.first.begin(), plan.first.end(), frame) == plan.first.end())
+    return;
+  const u8* aram = Core::System::GetInstance().GetDSP().GetARAMPtr();
+  const std::string path = plan.second + "/aram_" + std::to_string(frame) + ".bin";
+  if (std::FILE* f = std::fopen(path.c_str(), "wb"))
+  {
+    std::fwrite(aram, 1, DSP::ARAM_SIZE, f);
+    std::fclose(f);
+    std::fprintf(stderr, "[srnp relay] ARAM written at frame %llu: %s\n",
+                 static_cast<unsigned long long>(frame), path.c_str());
+  }
+}
+
 void GameFrameHook(CPUState*)
 {
-  RelayStep(s_game_frames.fetch_add(1, std::memory_order_relaxed) + 1);
+  const std::uint64_t frame = s_game_frames.fetch_add(1, std::memory_order_relaxed) + 1;
+  AramDump(frame);
+  RelayStep(frame);
 }
 
 std::uint64_t RelayGameFrames()
