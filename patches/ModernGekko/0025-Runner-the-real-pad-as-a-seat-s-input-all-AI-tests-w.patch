+    }
   }
   if (!s_race)
     return false;
@@ -603,12 +637,19 @@ bool DriveRacers(const std::vector<Pad>& pads, int camera_seat, int camera_seat2
       {
         // SRNP_IA_JOUEUR=1 (tests): simulated players: the AI drives, but the racer stays a player's
         // (+0xBD = 0: the humans' rules, and its "nP" label rather than "COM").
-        static const bool simulated = [] {
+        // SRNP_IA_JOUEURS=<n>: only seats 0 to n-1 are simulated players.
+        static const std::size_t simulated_seats = [] {
           const char* v = std::getenv("SRNP_IA_JOUEUR");
-          return v && *v == '1';
+          const char* n = std::getenv("SRNP_IA_JOUEURS");
+          if (n && *n)
+            return static_cast<std::size_t>(std::atoi(n));
+          return static_cast<std::size_t>(v && *v == '1' ? 8 : 0);
         }();
+        const bool simulated = k < simulated_seats;
         racer[kControl] = 1;
         racer[kCpuFlag] = simulated ? 0 : 1;  // the AI, with the CPUs' rules (or a player's)
+        // Back to the game's own controller structure of that racer, as the game's CPUs have it.
+        Put32(racer, kGamePads + static_cast<std::uint32_t>(k) * kPadSize);
         seat.released = true;
         std::fprintf(stderr, "[srnp racers] racer %zu: seat %zu gives it to the AI%s\n", k, k,
