       racer[kControl] = racer[0xBD] = 1;
+    else if (all_cpu == 1)
+      racer[0xBD] = 1;
   }
 }
 }  // namespace
@@ -559,7 +580,8 @@ bool DriveRacers(const std::vector<Pad>& pads, int camera_seat, int camera_seat2
     s_race_start = s_frames;
     s_seats = {};
     for (std::size_t k = 0; k < 8; ++k)
-      s_seats[k].cpu_at_start = racers[k * kRacerSize + kControl] == 1;
+      s_seats[k].cpu_at_start = racers[k * kRacerSize + kControl] == 1 ||
+                                (AllCpuMode() == 1 && racers[k * kRacerSize + kCpuFlag] == 1);
     std::memset(seat_pads, 0, 8 * kPadSize);
     std::fprintf(stderr, "[srnp racers] race of %u racers: %zu seats drive racers 0-%zu\n", count,
                  std::min<std::size_t>(pads.size(), count),
@@ -567,6 +589,18 @@ bool DriveRacers(const std::vector<Pad>& pads, int camera_seat, int camera_seat2
     PatchHud(camera_seat);
     PatchAnimation(true);
     PatchTest(true);
+    // SRNP_HUMAINS=<hex mask> (tests): racer k gets the humans' flag (+0xBD = 0) when bit k is set,
