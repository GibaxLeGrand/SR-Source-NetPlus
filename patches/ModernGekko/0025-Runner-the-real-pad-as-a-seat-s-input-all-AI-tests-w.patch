-    // SRNP_TOUS_CPU=1 makes every racer a CPU, as before.
-    static const bool all_cpu = [] {
-      const char* v = std::getenv("SRNP_TOUS_CPU");
-      return v && *v == '1';
-    }();
-    if (all_cpu || k >= Read32(kPlayerCount))
+    // SRNP_TOUS_CPU=1 flags the players' racers CPU too (see AllCpuMode).
+    const int all_cpu = AllCpuMode();
