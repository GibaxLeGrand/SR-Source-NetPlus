 {
@@ -164,9 +166,74 @@ std::uint64_t Mix(std::uint64_t x)
   return x;
 }
 
+// The SDK's PADClamp on one stick: dead zone `min`, then an octagon of radius `max` (`xy` on the
+// diagonals), as the game's PADRead gives it.
+void ClampStick(int* px, int* py, int max, int xy, int min)
+{
+  int x = *px, y = *py;
+  const int sx = x < 0 ? -1 : 1, sy = y < 0 ? -1 : 1;
+  x = x < 0 ? -x : x;
+  y = y < 0 ? -y : y;
+  x = x <= min ? 0 : x - min;
+  y = y <= min ? 0 : y - min;
+  if (x || y)
+  {
+    const int d = xy * y <= xy * x ? xy * x + (max - xy) * y : xy * y + (max - xy) * x;
+    if (xy * max < d)
+    {
+      x = xy * max * x / d;
+      y = xy * max * y / d;
+    }
+  }
+  *px = sx * x;
+  *py = sy * y;
+}
+
+std::uint8_t ClampTrigger(int t, int min, int max)
+{
+  return static_cast<std::uint8_t>(t <= min ? 0 : std::min(t, max) - min);
+}
+
+// SRNP_INPUT=manette: this machine's real pad, read from the emulated controller of a port the game
+// does not see (GCPad4 by default, SRNP_MANETTE_PORT=<1-4>: its SI device set to None in Dolphin.ini,
+// the pad named as its device in GCPadNew.ini), as the relay's seat input. The game only gets it back
+// through the relay, SRNP_DELAY frames later, on every machine at once.
+Pad RealPad()
+{
+  static const int port = [] {
+    const char* v = std::getenv("SRNP_MANETTE_PORT");
+    const int p = v ? std::atoi(v) : 4;
+    return p >= 1 && p <= 4 ? p - 1 : 3;
+  }();
+  const GCPadStatus s = ::Pad::GetStatus(port);
+  // PAD_BUTTON_* -> the relay's bits: A B X Y Z Start Up Down Left Right L R.
+  static constexpr std::uint16_t kButtons[] = {0x0100, 0x0200, 0x0400, 0x0800, 0x0010, 0x1000,
+                                               0x0008, 0x0004, 0x0001, 0x0002, 0x0040, 0x0020};
+  unsigned bits = 0;
+  for (unsigned i = 0; i < std::size(kButtons); ++i)
+    if (s.button & kButtons[i])
+      bits |= 1u << i;
+  int x = static_cast<int>(s.stickX) - 128, y = static_cast<int>(s.stickY) - 128;
+  int cx = static_cast<int>(s.substickX) - 128, cy = static_cast<int>(s.substickY) - 128;
+  ClampStick(&x, &y, 72, 40, 15);
+  ClampStick(&cx, &cy, 59, 31, 15);
+  Pad pad{};
+  pad[0] = static_cast<std::uint8_t>(bits >> 8);
+  pad[1] = static_cast<std::uint8_t>(bits);
+  pad[2] = static_cast<std::uint8_t>(static_cast<std::int8_t>(x));
+  pad[3] = static_cast<std::uint8_t>(static_cast<std::int8_t>(y));
+  pad[4] = static_cast<std::uint8_t>(static_cast<std::int8_t>(cx));
+  pad[5] = static_cast<std::uint8_t>(static_cast<std::int8_t>(cy));
+  pad[6] = ClampTrigger(s.triggerLeft, 30, 180);
+  pad[7] = ClampTrigger(s.triggerRight, 30, 180);
+  return pad;
+}
+
 Pad LocalInput(std::uint64_t frame, int seat)
 {
   Pad pad{};
+  if (s_relay.input_mode == "manette")
+    return RealPad();
   if (s_relay.input_mode == "ia")
   {
     // Every seat gives its racer to the AI (seat 0 presses Start in the menus, as in "course").
