     }
     const std::uint32_t rd = (read.original >> 21) & 31u;
     Put32(c, read.original);
-    Put32(c + 4, 0x38000000u | rd << 21 | rd << 16 |
-                     ((0u - static_cast<std::uint32_t>(seat)) & 0xFFFFu));  // addi rD, rD, -seat
+    // addi rD, rD, -seat; for r0, addic (addi takes rA = r0 as 0; the carry it sets is not read after
+    // these reads)
+    Put32(c + 4, (rd == 0 ? 0x30000000u : 0x38000000u) | rd << 21 | rd << 16 |
+                     ((0u - static_cast<std::uint32_t>(seat)) & 0xFFFFu));
