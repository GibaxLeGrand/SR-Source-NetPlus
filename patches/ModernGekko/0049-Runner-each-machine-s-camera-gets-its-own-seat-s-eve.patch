+std::array<std::uint8_t, 8> s_camera_of{0, 1, 2, 3, 4, 5, 6, 7};
+bool s_cameras_patched = false;
+
+// The camera of each racer's events: the seat's racer's camera 0, the second seat's camera 1, each by
+// a swap with the racer that had it.
+std::array<std::uint8_t, 8> CameraOf(int seat, int seat2)
+{
+  std::array<std::uint8_t, 8> of{0, 1, 2, 3, 4, 5, 6, 7};
+  const auto place = [&of](int racer, std::uint8_t camera) {
+    if (racer < 0 || racer >= 8)
+      return;
+    for (std::size_t k = 0; k < of.size(); ++k)
+      if (of[k] == camera)
+      {
+        std::swap(of[k], of[static_cast<std::size_t>(racer)]);
+        return;
+      }
+  };
+  place(seat, 0);
+  if (seat2 != seat)
+    place(seat2, 1);
+  return of;
+}
+
+void WriteCameraSlots(std::uint8_t* racers)
+{
+  for (std::size_t k = 0; k < 8; ++k)
+    racers[k * kRacerSize + kCameraSlot] = s_cameras_patched ? s_camera_of[k] : 0;
+}
+
+// seat < 0: the game's reads back.
+void PatchCameras(std::uint8_t* racers, int seat, int seat2)
+{
+  static const bool off = [] {
+    const char* v = std::getenv("SRNP_CAMERAS");
+    return v && *v == '0';
+  }();
+  const std::array<std::uint8_t, 8> of = CameraOf(seat, seat2);
+  const bool on = !off && seat >= 0 && of != CameraOf(0, 0);  // seat 0 alone: the game's own reads
+  if (on == s_cameras_patched)
+    return;
+  const std::uint32_t from = on ? 0x1029u : kCameraSlot, to = on ? kCameraSlot : 0x1029u;
+  for (const std::uint32_t address : kCameraIndexReads)
+  {
+    const std::uint32_t word = Read32(address);
+    if ((word >> 26) != 34u || (word & 0xFFFFu) != from)  // lbz rD, from(rA)
+    {
+      std::fprintf(stderr, "[srnp racers] cameras: 0x%08X holds %08X, not lbz 0x%X: left alone\n",
+                   address, word, from);
+      return;
+    }
+  }
+  s_camera_of = of;
+  s_cameras_patched = on;
+  WriteCameraSlots(racers);  // before the code reads them
+  auto& jit = Core::System::GetInstance().GetJitInterface();
+  for (const std::uint32_t address : kCameraIndexReads)
+  {
+    if (std::uint8_t* p = Guest(address, 4))
+      Put32(p, (Get32(p) & 0xFFFF0000u) | to);
+    jit.InvalidateICache(address, 4, true);
+  }
+  if (on)
+    std::fprintf(stderr, "[srnp racers] cameras: racer events to cameras %u %u %u %u %u %u %u %u\n", of[0],
+                 of[1], of[2], of[3], of[4], of[5], of[6], of[7]);
+  else
+    std::fprintf(stderr, "[srnp racers] cameras: the game's\n");
+}
+
 // Displays the game starts for its players only (racer index under the player count, 0x8021B8C8: 1 in
 // the 1P race), so racer 0's on every screen: during the race the runner starts them for its seat's racer
 // instead. Each is a few code words, checked against the game's before they are written and put back
@@ -870,6 +996,7 @@ bool DriveRacers(const std::vector<Pad>& pads, int camera_seat, int camera_seat2
     PatchAnimation(true);
     PatchZones(true);
     PatchSeatDisplays(camera_seat);
+    PatchCameras(racers, camera_seat, camera_seat2);
     PatchTest(true);
     // SRNP_BD5=<address>,... (test, hexadecimal): those reads of the CPUs' flag (lbz rD, 0xBD(rA))
     // see racer 5 as a CPU, through code in free low memory (0x80001810-0x80002C00, zero in races):
@@ -946,6 +1073,7 @@ bool DriveRacers(const std::vector<Pad>& pads, int camera_seat, int camera_seat2
     PatchAnimation(false);
     PatchZones(false);
     PatchSeatDisplays(-1);
+    PatchCameras(racers, -1, -1);
     PatchTest(false);
     std::fprintf(stderr, "[srnp racers] race over (0x%X, loading %u, scene %u): racers back to the game\n",
                  phase, Read32(kRaceLoading), Read32(kRaceScene));
@@ -1005,6 +1133,7 @@ bool DriveRacers(const std::vector<Pad>& pads, int camera_seat, int camera_seat2
     racer[kCpuFlag] = cpu_rules ? 1 : 0;
     seat.written = 0;
   }
+  WriteCameraSlots(racers);  // the camera of each racer's events (PatchCameras)
   if (camera_seat >= 0 && camera_seat < 8)
     if (std::uint8_t* camera = Guest(kCameraRacer, 1))
       *camera = static_cast<std::uint8_t>(camera_seat);
@@ -1036,7 +1165,9 @@ std::uint64_t RacersHash()
       // when the displays shown for this machine's seat alone have taken slots (measured with Gibax,
       // Amy, 2026-11-25: 0x803DFD08 against 0x803DFC48, one 0xC0 slot apart; the race the same); and
       // +0x894, the same for the display task 0x804A4F2C started for this machine's seat alone.
-      {0x894, 0x89C}};
+      {0x894, 0x89C},
+      // The camera of the racer's events, this machine's (PatchCameras).
+      {0x106C, 0x106D}};
   // Bits of the drawing only: 0x10000 of the flags +0xBAC (and of +0xBB8, last frame's copy) is set
   // by the characters' drawing functions (table 0x805E3FF0) for a racer the camera sees, and only the
   // drawing (0x8040B438, 0x8040AA78) tests it (2026-11-25). {byte, bits left out}.
