+    0x80588FB4, 0x80589014, 0x805890C0, 0x80589120, 0x80589360, 0x805893C0, 0x80589DD4,
+    0x80589E34, 0x80589FD4, 0x8058A034, 0x8058A900, 0x8058A960, 0x8058AA04, 0x8058AA64,
+    0x8058AB08, 0x8058AB68, 0x8058CAEC, 0x8058CB08, 0x80597A80, 0x805A0BE8,
