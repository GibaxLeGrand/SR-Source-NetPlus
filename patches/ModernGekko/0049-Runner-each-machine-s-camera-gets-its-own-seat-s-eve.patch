+    0x8048D7BC, 0x8048E440, 0x8048E470, 0x8048E770, 0x8048E904, 0x8048E9F8, 0x8048ECF0,
+    0x8048ED28, 0x8048F684, 0x8048F980, 0x80491AA0, 0x80491B10, 0x80491EE4, 0x804920D8,
