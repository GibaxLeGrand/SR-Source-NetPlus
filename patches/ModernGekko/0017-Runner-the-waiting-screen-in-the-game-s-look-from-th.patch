+// SR-Source Net Plus: pictures of the game's own files. See srnp_game_textures.hpp.
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#include "srnp_game_textures.hpp"
+
+#include "VideoCommon/AbstractGfx.h"
+#include "VideoCommon/AbstractTexture.h"
+#include "VideoCommon/Present.h"
+#include "VideoCommon/TextureConfig.h"
+
+#include <cstdint>
+#include <cstdio>
+#include <cstring>
+#include <fstream>
+#include <iterator>
+#include <map>
+#include <memory>
+#include <utility>
+#include <vector>
+
+namespace srnp
+{
+namespace
+{
+std::filesystem::path s_root;
+
+std::uint32_t Be32(const std::vector<std::uint8_t>& d, std::size_t at)
+{
+  return at + 4 <= d.size() ?
+             static_cast<std::uint32_t>(d[at]) << 24 | static_cast<std::uint32_t>(d[at + 1]) << 16 |
+                 static_cast<std::uint32_t>(d[at + 2]) << 8 | d[at + 3] :
+             0;
+}
+std::uint16_t Be16(const std::vector<std::uint8_t>& d, std::size_t at)
+{
+  return at + 2 <= d.size() ? static_cast<std::uint16_t>(d[at] << 8 | d[at + 1]) : 0;
+}
+
+// The game's LZSS: a header of 0x20 bytes (0x80000001, the size), then bits, most significant first:
+// 0 and a raw byte, or 1, a distance and a length (8 bits each), copied back from the output.
+std::vector<std::uint8_t> Decompress(const std::vector<std::uint8_t>& src)
+{
+  if (Be32(src, 0) != 0x80000001u)
+    return src;
+  const std::uint32_t size = Be32(src, 4);
+  std::vector<std::uint8_t> out;
+  out.reserve(size);
+  std::size_t bit = 0x20 * 8;
+  const std::size_t end = src.size() * 8;
+  const auto read = [&](int n) {
+    std::uint32_t v = 0;
+    for (int i = 0; i < n && bit < end; ++i, ++bit)
+      v = v << 1 | ((src[bit >> 3] >> (7 - (bit & 7))) & 1u);
+    return v;
+  };
+  while (out.size() < size && bit < end)
+  {
+    if (read(1))
+    {
+      const std::uint32_t distance = read(8), length = read(8);
+      if (distance == 0 || distance > out.size())
+        break;
+      const std::size_t from = out.size() - distance;
+      for (std::uint32_t i = 0; i < length; ++i)
+        out.push_back(out[from + i]);
+    }
+    else
+    {
+      out.push_back(static_cast<std::uint8_t>(read(8)));
+    }
+  }
+  return out;
+}
+
+std::uint32_t Rgb5a3(std::uint16_t v)  // to RGBA8 (bytes r, g, b, a in memory order)
+{
+  std::uint32_t r, g, b, a;
+  if (v & 0x8000)
+  {
+    r = (v >> 10 & 31) * 255 / 31, g = (v >> 5 & 31) * 255 / 31, b = (v & 31) * 255 / 31, a = 255;
+  }
+  else
+  {
+    r = (v >> 8 & 15) * 17, g = (v >> 4 & 15) * 17, b = (v & 15) * 17, a = (v >> 12 & 7) * 255 / 7;
+  }
+  return r | g << 8 | b << 16 | a << 24;
+}
+
+struct Decoded
+{
+  int width = 0, height = 0;
+  std::vector<std::uint32_t> rgba;
+};
+
+// The index-th GVR texture of the file (CI4 or CI8 with an RGB5A3 palette, as the game's menus have).
+Decoded Decode(const std::vector<std::uint8_t>& d, int index)
+{
+  Decoded out;
+  std::size_t at = 0;
+  int k = -1;
+  for (;;)
+  {
+    std::size_t found = std::string::npos;
+    for (std::size_t i = at; i + 4 <= d.size(); ++i)
+      if (d[i] == 'G' && d[i + 1] == 'C' && d[i + 2] == 'I' && d[i + 3] == 'X')
+      {
+        found = i;
+        break;
+      }
+    if (found == std::string::npos)
+      return out;
+    if (++k == index)
+    {
+      at = found;
+      break;
+    }
+    at = found + 4;
+  }
+  const std::size_t g = at + 0x10;
+  if (Be32(d, g) != 0x47565254u)  // "GVRT"
+    return out;
+  const int format = d[g + 0xB];
+  const int w = Be16(d, g + 0xC), h = Be16(d, g + 0xE);
+  if ((format != 8 && format != 9) || w <= 0 || h <= 0 || w > 1024 || h > 1024)
+    return out;
+  const int colours = format == 9 ? 256 : 16;
+  std::size_t p = g + 0x10;
+  std::vector<std::uint32_t> palette(static_cast<std::size_t>(colours));
+  for (int c = 0; c < colours; ++c)
+    palette[static_cast<std::size_t>(c)] = Rgb5a3(Be16(d, p + 2u * static_cast<std::size_t>(c)));
+  p += 2u * static_cast<std::size_t>(colours);
+  out.width = w, out.height = h;
+  out.rgba.assign(static_cast<std::size_t>(w) * static_cast<std::size_t>(h), 0);
+  // Tiles: 8x4 texels for CI8, 8x8 for CI4 (two texels a byte, high nibble first).
+  const int tw = 8, th = format == 9 ? 4 : 8;
+  std::size_t n = 0;
+  for (int ty = 0; ty < h; ty += th)
+    for (int tx = 0; tx < w; tx += tw)
+      for (int y = 0; y < th; ++y)
+        for (int x = 0; x < tw; ++x, ++n)
+        {
+          const std::size_t byte = p + (format == 9 ? n : n / 2);
+          if (byte >= d.size())
+            return out;
+          const int v = format == 9 ? d[byte] : (n % 2 == 0 ? d[byte] >> 4 : d[byte] & 15);
+          if (tx + x < w && ty + y < h)
+            out.rgba[static_cast<std::size_t>(ty + y) * static_cast<std::size_t>(w) +
+                     static_cast<std::size_t>(tx + x)] = palette[static_cast<std::size_t>(v)];
+        }
+  return out;
+}
+
+struct Loaded
+{
+  std::unique_ptr<AbstractTexture> texture;
+  float width = 0.0f, height = 0.0f;
+  bool failed = false;
+  const void* presenter = nullptr;
+};
+std::map<std::string, std::vector<std::uint8_t>> s_files;  // decompressed, by path
+std::map<std::pair<std::string, int>, Loaded> s_textures;
+std::vector<std::filesystem::path> s_mod_directories;
+
+const std::vector<std::uint8_t>& File(const std::filesystem::path& path)
+{
+  const std::string key = path.string();
+  auto found = s_files.find(key);
+  if (found == s_files.end())
+  {
+    std::ifstream in(path, std::ios::binary);
+    std::vector<std::uint8_t> raw((std::istreambuf_iterator<char>(in)), std::istreambuf_iterator<char>());
+    found = s_files.emplace(key, Decompress(raw)).first;
+    std::fprintf(stderr, "[srnp screens] %s: %zu bytes read\n", key.c_str(), found->second.size());
+  }
+  return found->second;
+}
+
+// The cached texture of a picture, made from `decode` the first time (or after the video backend
+// changed); a picture that can't be had is not tried again.
+template <typename F>
+GamePicture Cached(const std::string& file, int index, F decode)
+{
+  GamePicture result;
+  if (!g_gfx || !g_presenter)
+    return result;
+  Loaded& t = s_textures[{file, index}];
+  if (!(t.texture && t.presenter == g_presenter.get()))
+  {
+    if (t.failed)
+      return result;
+    if (t.texture)
+      (void)t.texture.release();  // a texture of a video backend that is gone can't be destroyed
+    const Decoded picture = decode();
+    if (picture.rgba.empty())
+    {
+      std::fprintf(stderr, "[srnp screens] %s: no picture %d\n", file.c_str(), index);
+      t.failed = true;
+      return result;
+    }
+    const TextureConfig config(static_cast<u32>(picture.width), static_cast<u32>(picture.height), 1, 1, 1,
+                               AbstractTextureFormat::RGBA8, 0, AbstractTextureType::Texture_2DArray);
+    t.texture = g_gfx->CreateTexture(config, "SR-Source Net Plus screen");
+    if (!t.texture)
+    {
+      t.failed = true;
+      return result;
+    }
+    t.texture->Load(0, static_cast<u32>(picture.width), static_cast<u32>(picture.height),
+                    static_cast<u32>(picture.width), reinterpret_cast<const u8*>(picture.rgba.data()),
+                    picture.rgba.size() * 4);
+    t.width = static_cast<float>(picture.width), t.height = static_cast<float>(picture.height);
+    t.presenter = g_presenter.get();
+  }
+  result.texture = *t.texture;
+  result.width = t.width, result.height = t.height, result.ok = true;
+  return result;
+}
+
+// C8 texels (tiles of 8x4) with a palette of 256 RGB5A3 colours.
+Decoded DecodeC8(const std::vector<std::uint8_t>& d, std::size_t palette, std::size_t texels, int w, int h)
+{
+  Decoded out;
+  if (w <= 0 || h <= 0 || texels + static_cast<std::size_t>(w) * static_cast<std::size_t>(h) > d.size())
+    return out;
+  out.width = w, out.height = h;
+  out.rgba.assign(static_cast<std::size_t>(w) * static_cast<std::size_t>(h), 0);
+  std::size_t n = texels;
+  for (int ty = 0; ty < h; ty += 4)
+    for (int tx = 0; tx < w; tx += 8)
+      for (int y = 0; y < 4; ++y)
+        for (int x = 0; x < 8; ++x, ++n)
+          if (tx + x < w && ty + y < h)
+            out.rgba[static_cast<std::size_t>(ty + y) * static_cast<std::size_t>(w) + static_cast<std::size_t>(tx + x)] =
+                Rgb5a3(Be16(d, palette + 2u * d[n]));
+  return out;
+}
+}  // namespace
+
+void SetGameRoot(const std::filesystem::path& root)
+{
+  s_root = root;
+}
+
+void SetModDirectories(const std::vector<std::filesystem::path>& directories)
+{
+  s_mod_directories = directories;
+}
+
+GamePicture GameTexture(const std::string& file, int index)
+{
+  return Cached(file, index, [&] { return Decode(File(s_root / "files" / file), index); });
+}
+
+GamePicture LabelsTexture()
+{
+  return Cached("srnp_etiquettes", 0, [] {
+    for (const std::filesystem::path& dir : s_mod_directories)
+    {
+      std::error_code ec;
+      const std::filesystem::path gtse = dir / "srnp_etiquettes" / "files" / "GTSE";
+      if (!std::filesystem::exists(gtse, ec))
+        continue;
+      const std::vector<std::uint8_t>& d = File(gtse);
+      static constexpr char kMark[] = "SRNPLBL1";
+      for (std::size_t i = 0; i + 0x20 <= d.size(); i += 4)
+      {
+        if (std::memcmp(d.data() + i, kMark, 8) != 0)
+          continue;
+        const int w = Be16(d, i + 8), h = Be16(d, i + 10);
+        if (Be32(d, i + 12) != 9)
+          break;
+        return DecodeC8(d, i + Be32(d, i + 16), i + Be32(d, i + 20), w, h);
+      }
+    }
+    return Decoded{};
+  });
+}
+}  // namespace srnp
diff --git a/src/runtime/srnp_game_textures.hpp b/src/runtime/srnp_game_textures.hpp
