+++ b/src/runtime/srnp_game_textures.hpp
@@ -0,0 +1,37 @@
+// SR-Source Net Plus: pictures of the game's own files, for the runner's screens (srnp_waiting_screen.cpp).
+// SPDX-License-Identifier: GPL-3.0-or-later
+//
+// The pictures are read from the player's game (<game root>/files/<name>), never from this repository:
+// the file is decompressed (the game's LZSS: 0x80000001, the size, then a bit stream), its N-th GVR
+// texture ("GCIX"/"GVRT") is found, its CI4 or CI8 texels decoded with their RGB5A3 palette, and the
+// picture made into a texture of the video backend that ImGui can draw. All on the video thread.
+#pragma once
+
+#include <filesystem>
+#include <string>
+#include <vector>
+
+#include <imgui.h>
+
+namespace srnp
+{
+// Where the game's files are (the runtime's game root); set before the first screen is drawn.
+void SetGameRoot(const std::filesystem::path& root);
+
+// The index-th texture of a file of the game, ready for ImGui (nullptr if it can't be had), and its size.
+struct GamePicture
+{
+  ImTextureRef texture;
+  float width = 0.0f, height = 0.0f;
+  bool ok = false;
+};
+GamePicture GameTexture(const std::string& file, int index);
+
+// The mods' folders (the runtime's mod directories): for the labels mod's own texture.
+void SetModDirectories(const std::vector<std::filesystem::path>& directories);
+
+// "5P".."8P", 36x30 side by side, from the labels mod (srnp_etiquettes: its GTSE ends with a block
+// "SRNPLBL1": u16 width, u16 height, u32 GX format 9, u32 palette offset, u32 texels offset; 256
+// RGB5A3 colours, then C8 texels). Not ok without the mod.
+GamePicture LabelsTexture();
+}  // namespace srnp
diff --git a/src/runtime/srnp_waiting_screen.cpp b/src/runtime/srnp_waiting_screen.cpp
index 4e11196..51170bf 100644
--- a/src/runtime/srnp_waiting_screen.cpp
+++ b/src/runtime/srnp_waiting_screen.cpp
@@ -12,6 +12,7 @@
 // over a paused game, the last frame is presented again, on the video thread, with the screen over it.
 
 #include "srnp_relay.hpp"
+#include "srnp_game_textures.hpp"
 
 #include <imgui.h>
 
@@ -65,6 +66,150 @@ void Label(ImDrawList* list, ImFont* font, ImVec2 centre, float unit, const char
   TextCentred(list, font, unit * 0.85f, centre, Rgba(255, 255, 255), text);
 }
 
+// The game's pictures (srnp_game_textures.hpp): TSGME, the menus ("?" 110, the panel 116, "ARE YOU
+// READY?" 38), GTSE, the race HUD (the atlas 5: the labels and the characters' heads).
+constexpr const char* kMenus = "TSGME";
+constexpr const char* kHud = "GTSE";
+// Each character's head in the HUD atlas, 38x30, as the game's table at 0x805D3DB4 has them (entries
+// 5 + character): Sonic, Tails, Knuckles, Amy, Jet, Storm, Wave, Eggman, Cream, Rouge, Shadow, Super
+// Sonic (Sonic's), NiGHTS, AiAi, Ulala, E-10000G, E-10000R.
+constexpr ImVec2 kHeads[17] = {{0, 120},   {38, 120},  {76, 120}, {114, 120}, {0, 150},   {38, 150},
+                               {76, 150},  {114, 150}, {152, 120}, {152, 150}, {190, 120}, {0, 120},
+                               {190, 150}, {0, 180},   {0, 210},  {38, 180},  {38, 210}};
+
+void Picture(ImDrawList* list, const GamePicture& p, ImVec2 a, ImVec2 b, ImVec2 uv0 = ImVec2(0, 0),
+             ImVec2 uv1 = ImVec2(1, 1), ImU32 tint = IM_COL32_WHITE)
+{
+  if (p.ok)
+    list->AddImage(p.texture, a, b, uv0, uv1, tint);
+}
+
+// The game's label ("1P".."4P", "COM": the HUD atlas, 36x30 at (76 + 36 k, 60), as the game's table at
+// 0x805D3DB4 has them); "5P".."8P" from the labels mod (srnp_etiquettes: 36x30 side by side), or drawn
+// in the game's colours without it.
+void GameLabel(ImDrawList* list, ImFont* font, ImVec2 centre, float unit, int seat, bool com)
+{
+  const float w = unit * 2.4f, h = w * 30.0f / 36.0f;
+  const ImVec2 a(centre.x - w * 0.5f, centre.y - h * 0.5f), b(centre.x + w * 0.5f, centre.y + h * 0.5f);
+  const GamePicture atlas = GameTexture(kHud, 5);
+  if (atlas.ok && (com || seat < 4))
+  {
+    const float u = com ? 220.0f : 76.0f + 36.0f * static_cast<float>(seat);
+    Picture(list, atlas, a, b, ImVec2(u / atlas.width, 60.0f / atlas.height),
+            ImVec2((u + 36.0f) / atlas.width, 90.0f / atlas.height));
+    return;
+  }
+  const GamePicture ours = LabelsTexture();
+  if (ours.ok && !com && seat >= 4 && seat < 8)
+  {
+    const float u = 36.0f * static_cast<float>(seat - 4);
+    Picture(list, ours, a, b, ImVec2(u / ours.width, 0.0f), ImVec2((u + 36.0f) / ours.width, 30.0f / ours.height));
+    return;
+  }
+  char text[8];
+  std::snprintf(text, sizeof(text), com ? "COM" : "%dP", seat + 1);
+  Label(list, font, centre, unit, text, com);
+}
+
+// Gibax's mockup in the game's look: the blue of the menus (Player Entry), the game's "ARE YOU READY?",
+// one card a seat on the menus' rounded panel, with the game's label and the character's select icon
+// (its head and name), faded and bluish while the player is on the way.
+void DrawWithGamePictures(const WaitView& view, ImDrawList* list, ImFont* font, ImVec2 display)
+{
+  const int seats = std::min(view.seats, 8);
+  const auto state = [&](int k) {
+    return k < static_cast<int>(view.states.size()) ? view.states[static_cast<std::size_t>(k)] : 'O';
+  };
+  int left = 0, ready = 0;
+  for (int k = 0; k < seats; ++k)
+  {
+    left += state(k) == 'X';
+    ready += state(k) == 'V';
+  }
+  const int players = seats - left;
+
+  // The menus' blue, darker at the top, and light bands across, as Player Entry has.
+  list->AddRectFilledMultiColor(ImVec2(0, 0), display, Rgba(10, 28, 92), Rgba(10, 28, 92), Rgba(36, 104, 196),
+                                Rgba(36, 104, 196));
+  for (int i = 0; i < 6; ++i)
+  {
+    const float y = display.y * (0.18f + 0.13f * static_cast<float>(i));
+    list->AddRectFilled(ImVec2(0, y), ImVec2(display.x, y + display.y * 0.012f), Rgba(160, 200, 255, 0.07f));
+  }
+  const float unit = std::min(display.y / 15.0f, display.x / (seats * 3.4f + 1.0f));
+
+  // The game's "ARE YOU READY?" (the top of the menus' picture 38), then the counts.
+  const GamePicture ready_picture = GameTexture(kMenus, 38);
+  if (ready_picture.ok)
+  {
+    const float w = display.x * 0.42f, h = w * 40.0f / 256.0f;
+    Picture(list, ready_picture, ImVec2(display.x * 0.5f - w * 0.5f, display.y * 0.04f),
+            ImVec2(display.x * 0.5f + w * 0.5f, display.y * 0.04f + h), ImVec2(0, 0), ImVec2(1, 40.0f / 256.0f));
+  }
+  char line[64];
+  std::snprintf(line, sizeof(line), "%d Players    %d Racers    %d/%d Ready", players, seats, ready, players);
+  TextCentred(list, font, unit * 0.95f, ImVec2(display.x * 0.5f, display.y * 0.19f), Rgba(255, 255, 255), line);
+
+  const GamePicture panel = GameTexture(kMenus, 116);
+  const float column = display.x / static_cast<float>(seats + 1);
