 int SeatCharacter(int seat);
 int SeatGear(int seat);
 
+// The game's gears (41) and whether a character may ride one (the gear table, in the game's memory
+// once its REL is loaded: false for every gear before).
+int GearCount();
+bool GearAllowed(int gear, int character);
+
 // FNV-1a 64 of the 8 racers, without the fields that follow the camera (measured on 2026-11-25).
 std::uint64_t RacersHash();
 
diff --git a/src/runtime/srnp_relay.cpp b/src/runtime/srnp_relay.cpp
