From d1f2680a595f4ea681130c80e53300c7bb28c9ec Mon Sep 17 00:00:00 2001
From: GibaxLeGrand <48137851+GibaxLeGrand@users.noreply.github.com>
Date: Wed, 25 Nov 2026 20:33:19 +0100
Subject: [PATCH] Runner: the lobby offers only the gears the character may
 ride, by name

Up/down in the lobby steps through the gears the game's table lets the character ride (all 41 if the
table is not in memory), and a change of character moves a forbidden gear to the first allowed one, as
the race would. The cards name the gear (the modding community's names, in the table's order; checked
against who may ride them: 7 Sonic alone, 18 Super Sonic, Eggman's first 25, 30-32 and 37-39 the speed,
fly and power types). The runner logs the table once. SRNP_LOBBY_KEYS=<L R U D A B...> plays presses
through the pad's path for tests.
Measured with 2 runners: Sonic -> Ulala, gear 2 (AUTO SLIDER); Shadow -> Eggman moves to 25 then down
to 34 and 33 (SUPER HANG ON, HANG ON); A, B, A logged by the relay; 12 identical checksums.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/runtime/srnp_racers.cpp         | 24 ++++++++++++
 src/runtime/srnp_racers.hpp         |  5 +++
 src/runtime/srnp_relay.cpp          | 59 +++++++++++++++++++++++------
 src/runtime/srnp_waiting_screen.cpp | 24 ++++++++++--
 4 files changed, 97 insertions(+), 15 deletions(-)

diff --git a/src/runtime/srnp_racers.cpp b/src/runtime/srnp_racers.cpp
index 3201a65..52c9ec4 100644
--- a/src/runtime/srnp_racers.cpp
+++ b/src/runtime/srnp_racers.cpp
@@ -461,6 +461,30 @@ int SeatGear(int seat)
   return seat >= 0 && seat < 8 ? Lobby()[static_cast<std::size_t>(seat)].gear : -1;
 }
 
+int GearCount()
+{
+  return kGears;
+}
+
+bool GearAllowed(int gear, int character)
+{
+  // Once, in the log: who may ride each gear as the game's table says (one bit a character).
+  static const bool logged = [] {
+    std::string line;
+    for (int g = 0; g < kGears; ++g)
+    {
+      char text[16];
+      std::snprintf(text, sizeof(text), " %d:%05X", g,
+                    Read32(kGearTable + static_cast<std::uint32_t>(g) * 0x1D0u) & 0x1FFFFu);
+      line += text;
+    }
+    std::fprintf(stderr, "[srnp racers] gears, who may ride them (bit = character):%s\n", line.c_str());
+    return true;
+  }();
+  (void)logged;
+  return character >= 0 && character < 32 && GearAllows(gear, character);
+}
+
 long long RaceFrame()
 {
   return s_race ? static_cast<long long>(s_frames - s_race_start) : -1;
diff --git a/src/runtime/srnp_racers.hpp b/src/runtime/srnp_racers.hpp
