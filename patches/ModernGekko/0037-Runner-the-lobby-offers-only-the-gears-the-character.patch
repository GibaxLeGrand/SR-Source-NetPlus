+// Super Sonic), up/down the gear (only those the character may ride), A ready, B back to choosing.
+// Tests: SRNP_LOBBY_AUTO=<c>/<g>/<seconds>[/<back>]: that choice, then ready, after that many seconds;
+// with <back>, B that many seconds later (back to choosing), then A again after as many.
+// SRNP_LOBBY_KEYS=<L R U D A B...>: those presses in place of the pad's, one every 0.5 s after 3 s.
 struct LobbyLocal
 {
   int character = 0, gear = 0;
@@ -565,12 +566,31 @@ bool LobbyStep(LobbyLocal* l)
     ++l->auto_step;
     return true;
   }
-  g_controller_interface.UpdateInput();  // the game stands still: nothing else reads the pads now
-  const Pad pad = s_relay.input_mode == "manette" ? RealPad() : Pad{};
-  unsigned bits = (static_cast<unsigned>(pad[0]) << 8) | pad[1];
-  const int x = static_cast<std::int8_t>(pad[2]), y = static_cast<std::int8_t>(pad[3]);
-  bits |= (x < -40 ? 0x100u : 0u) | (x > 40 ? 0x200u : 0u) | (y > 40 ? 0x40u : 0u) |
-          (y < -40 ? 0x80u : 0u);
+  unsigned bits = 0;
+  static const char* keys = std::getenv("SRNP_LOBBY_KEYS");
+  if (keys && *keys)
+  {
+    // Tests: the pad's presses from a string (L R U D A B), one every 0.5 s (held 0.25 s) after 3 s.
+    const long long ms =
+        std::chrono::duration_cast<std::chrono::milliseconds>(std::chrono::steady_clock::now() - l->since).count() -
+        3000;
+    const std::size_t i = ms >= 0 ? static_cast<std::size_t>(ms / 500) : std::strlen(keys);
+    if (i < std::strlen(keys) && ms % 500 < 250)
+    {
+      const char k = keys[i];
+      bits = k == 'L' ? 0x100u : k == 'R' ? 0x200u : k == 'U' ? 0x40u : k == 'D' ? 0x80u : k == 'A' ? 0x1u :
+             k == 'B' ? 0x2u : 0u;
+    }
+  }
+  else
+  {
+    g_controller_interface.UpdateInput();  // the game stands still: nothing else reads the pads now
+    const Pad pad = s_relay.input_mode == "manette" ? RealPad() : Pad{};
+    bits = (static_cast<unsigned>(pad[0]) << 8) | pad[1];
+    const int x = static_cast<std::int8_t>(pad[2]), y = static_cast<std::int8_t>(pad[3]);
+    bits |= (x < -40 ? 0x100u : 0u) | (x > 40 ? 0x200u : 0u) | (y > 40 ? 0x40u : 0u) |
+            (y < -40 ? 0x80u : 0u);
+  }
   const unsigned pressed = bits & ~l->previous;
   l->previous = bits;
   if (l->ready)
@@ -588,14 +608,31 @@ bool LobbyStep(LobbyLocal* l)
     while (c == 11);  // not Super Sonic
     return c;
   };
+  // The gears the character may ride (the game's table), all of them if the table is not there.
+  const int gears = GearCount();
+  const auto any_gear = [&](int c) {
+    for (int g = 0; g < gears; ++g)
+      if (GearAllowed(g, c))
+        return true;
+    return false;
+  };
+  const auto next_gear = [&](int g, int step, int c) {
+    const bool filter = any_gear(c);
+    do
+      g = (g + step + gears) % gears;
+    while (filter && !GearAllowed(g, c));
+    return g;
+  };
   if (pressed & 0x100u)
     l->character = next(l->character, -1), changed = true;
   if (pressed & 0x200u)
     l->character = next(l->character, 1), changed = true;
+  if (changed && any_gear(l->character) && !GearAllowed(l->gear, l->character))
+    l->gear = next_gear(gears - 1, 1, l->character);  // the first gear it may ride, as the race would
   if (pressed & 0x40u)
-    l->gear = (l->gear + 1) % 40, changed = true;
+    l->gear = next_gear(l->gear, 1, l->character), changed = true;
   if (pressed & 0x80u)
-    l->gear = (l->gear + 39) % 40, changed = true;
+    l->gear = next_gear(l->gear, -1, l->character), changed = true;
   if (changed)
     LobbySend(seat, *l);
   if (pressed & 0x1u)
