diff --git a/src/runtime/srnp_relay.cpp b/src/runtime/srnp_relay.cpp
index b6c624a..bdf9efc 100644
--- a/src/runtime/srnp_relay.cpp
+++ b/src/runtime/srnp_relay.cpp
@@ -958,6 +958,7 @@ namespace
 {
 std::atomic<std::uint64_t> s_game_frames{0};
 void RelayStep(std::uint64_t frame);
+void RulesMenuOnFrame();
 }  // namespace
 
 void SetStartState(const std::string& path)
@@ -1055,6 +1056,9 @@ bool PauseAtGameFrame()
 
 void RelayOnFrame(std::uint64_t frame)
 {
+  RulesMenuOnFrame();
+  if (!RelayConfigured())
+    OfflineRacersFrame();
   PadCheckOnFrame(frame);
   if (GameFrameHookAddress() != 0)
     return;  // the relay steps in the game's main loop
@@ -1240,6 +1244,51 @@ std::uint32_t FindMenuTask()
   return FindTask(kMenuTaskFunction);
 }
 
+// The racers on Rule Settings (Gibax, 2026-11-26: "on est capable de choisir le nombre de racers par
+// course, faudrait ajouter cette option au jeu normal (même endroit qu'on ajuste les laps) in game, pour
+// du offline aussi"). The menus' task 0x8050EDB8 (its data at [task + 16]) is in its state 22 on Track
+// Select and Rule Settings; its data's +156 is 2 on Rule Settings (4 on Track Select), +158 the cursor
+// (RAM dumps of 2026-11-26). There a row "Racers" is drawn under Air Lost (DrawRulesRow); L and R, which
+// that menu leaves alone (measured), change it, 1 to 8 (8: the game's). The host's choice goes to the
+// relay with the course and laps (SendRules); alone, OfflineRacersFrame writes it into the race.
+std::atomic<int> s_rules_row{-1};  // the count shown on Rule Settings (-1: not there)
+
+void RulesMenuOnFrame()
+{
+  static std::uint32_t task = 0;
+  if (task == 0 || GuestWord(task) != 0x8050EDB8u)
+    task = FindTask(0x8050EDB8u);
+  const std::uint8_t* t = task ? GuestByte(task) : nullptr;
+  const std::uint32_t data = task ? GuestWord(task + 16) : 0;
+  const std::uint8_t* d = data >= 0x80000000u ? GuestByte(data) : nullptr;
+  if (!t || t[20] != 22 || !d || d[156] != 2)
+  {
+    s_rules_row = -1;
+    return;
+  }
+  static int held = 0;
+  const GCPadStatus s = ::Pad::GetStatus(0);
+  const bool l = (s.button & 0x0040) != 0 || s.triggerLeft > 170;
+  const bool r = (s.button & 0x0020) != 0 || s.triggerRight > 170;
+  if (l != r)
+  {
+    // A press, then again every 6 frames once held for 20.
+    if (held == 0 || (held > 20 && held % 6 == 0))
+    {
+      const int v = std::clamp(MenuRacers() + (r ? 1 : -1), 1, 8);
+      if (v != MenuRacers())
+      {
+        SetNbRacers(v);
+        std::fprintf(stderr, "[srnp relay] Rule Settings: %d racers\n", v);
+      }
+    }
+    ++held;
+  }
+  else
+    held = 0;
+  s_rules_row = MenuRacers();
+}
+
 // Back to Menu: the race manager (the task 0x804337A8) acts on the menu's choice in its state 9
 // (0x80433AB0: once 0x806129CE says decided, 0x80436D04); it gets there from the race (7) through 8
 // when a player of the game ([0x806129B5]) has finished, which never happens when the game's racers
@@ -1638,4 +1687,8 @@ void RelayStep(std::uint64_t frame)
   }
 }
 }  // namespace
+int RulesRowRacers()
+{
+  return s_rules_row.load();
+}
 }  // namespace srnp
diff --git a/src/runtime/srnp_relay.hpp b/src/runtime/srnp_relay.hpp
index 200d269..b82eb72 100644
--- a/src/runtime/srnp_relay.hpp
+++ b/src/runtime/srnp_relay.hpp
@@ -65,6 +65,10 @@ void RedrawWhileWaiting();
 // present).
 void WaitingVeilOnPresent();
 
+// The racers chosen on the game's Rule Settings while it shows (-1 otherwise): the row drawn under Air
+// Lost, changed with L and R (online and alone).
+int RulesRowRacers();
+
 // Phase 2 (SRNP_RACERS=1, native core): the relay steps once per frame of the game, at the head of
 // Sonic Riders' main loop (0x805B8290: the pads are read, then the game's tasks run, then the frame is
 // drawn), through a StaticRecomp host hook. Inputs are then applied, and checksums taken, at the same
diff --git a/src/runtime/srnp_waiting_screen.cpp b/src/runtime/srnp_waiting_screen.cpp
index 7764ed4..c931028 100644
--- a/src/runtime/srnp_waiting_screen.cpp
+++ b/src/runtime/srnp_waiting_screen.cpp
@@ -432,12 +432,48 @@ void Draw(const WaitView& view)
 }
 }  // namespace
 
+// The "Racers" row of Rule Settings (srnp_relay.cpp, RulesMenuOnFrame): under Air Lost, as the game's
+// rows (measured on its screen, 2026-11-26: labels from 22.7 % to 41.8 % of the width, rows every 6.66 %
+// of the height from 25.4 %; Default and CONTINUE at the right from 65.6 %): the label's plate, the
+// count between two arrows (left of Default), and L and R beside the arrows.
+void DrawRulesRow(int racers)
+{
+  ImDrawList* list = ImGui::GetForegroundDrawList();
+  ImFont* font = ImGui::GetFont();
+  const ImVec2 display = ImGui::GetIO().DisplaySize;
+  if (!list || !font || display.x <= 0.0f || display.y <= 0.0f)
+    return;
+  const float y = display.y * 0.653f, h = display.y * 0.052f;
+  const ImVec2 a(display.x * 0.2266f, y - h * 0.5f), b(display.x * 0.4178f, y + h * 0.5f);
+  list->AddRectFilled(ImVec2(a.x + 3, a.y + 3), ImVec2(b.x + 3, b.y + 3), Rgba(10, 12, 40, 0.6f), h * 0.12f);
+  list->AddRectFilled(a, b, Rgba(122, 128, 196), h * 0.12f);
+  list->AddRectFilled(a, ImVec2(b.x, a.y + h * 0.35f), Rgba(160, 166, 222), h * 0.12f);
+  list->AddRect(a, b, Rgba(28, 30, 70), h * 0.12f, 0, std::max(2.0f, h * 0.05f));
+  const ImVec2 label(a.x + (b.x - a.x) * 0.5f, y);
+  if (!NameTextCentred(list, "Racers", label, h * 0.78f, Rgba(40, 42, 76), (b.x - a.x) * 0.9f))
+    TextCentred(list, font, h * 0.7f, label, Rgba(40, 42, 76), "Racers");
+  char count[8];
+  std::snprintf(count, sizeof(count), "%02d", racers);
+  const ImVec2 value(display.x * 0.530f, y);
+  if (!NameTextCentred(list, count, value, h * 0.9f, IM_COL32_WHITE))
+    TextCentred(list, font, h * 0.8f, value, IM_COL32_WHITE, count);
+  const float s = h * 0.36f;
+  const ImU32 arrow = Rgba(176, 182, 212);
+  const float lx = display.x * 0.466f, rx = display.x * 0.594f;
+  list->AddTriangleFilled(ImVec2(lx - s, y), ImVec2(lx + s * 0.8f, y - s), ImVec2(lx + s * 0.8f, y + s), arrow);
+  list->AddTriangleFilled(ImVec2(rx + s, y), ImVec2(rx - s * 0.8f, y - s), ImVec2(rx - s * 0.8f, y + s), arrow);
+  TextCentred(list, font, h * 0.42f, ImVec2(lx - s * 2.4f, y), Rgba(255, 214, 64), "L");
+  TextCentred(list, font, h * 0.42f, ImVec2(rx + s * 2.4f, y), Rgba(255, 214, 64), "R");
+}
+
 void WaitingVeilOnPresent()
 {
   // While the game runs under the veil (not while it waits: RedrawWhileWaiting draws then).
   const WaitView view = RelayWaitView();
   if (view.veil && !view.waiting)
     Draw(view);
+  else if (const int racers = RulesRowRacers(); racers > 0)
+    DrawRulesRow(racers);
 }
 
 void RedrawWhileWaiting()
