+// ---- The results screen's tags, in the font of the game's names ----
+// The letters the game has (in its names, DR.EGGMAN ... E-10000R) are taken from "GoalResult_01_E" in
+// RAM once the file is loaded, so nothing of the game is in this source: a letter is the k-th piece of
+// strong fill (indices F, E, D; 4-connected, 2 texels at least) of a name, with the texels nearest to it
+// (the outline and halo), its outline completed by a generated one (a letter between two others shares
+// theirs). The others are fills defined here (kDrawn) with the generated outline. A tag is laid out
+// like the game's names (fills 1 texel apart, the strongest index wins where two letters touch),
+// centred like them, in its racer's 16-row band of our texture, which takes the names' palette.
+// Prototype and previews: work\etiquettes\police_resultats.py.
+using Pixels = std::map<std::pair<int, int>, std::uint8_t>;
+
+constexpr bool IsFill(std::uint8_t v)
+{
+  return v == 0xF || v == 0xE || v == 0xD || v == 0x8 || v == 0xC;
+}
+constexpr bool IsStrong(std::uint8_t v)
+{
+  return v == 0xF || v == 0xE || v == 0xD;
+}
+// the names' palette: 0 clear, 1-7 the halo (black, growing alpha, 3 and 6 white), 8 C D E F the fill's
+// greys and white, 9 A the dark greys inside the outline, B the black outline
+constexpr std::array<int, 16> kPrio = {0, 1, 4, 2, 5, 6, 3, 7, 12, 9, 10, 8, 11, 13, 14, 15};
+
+struct Source
+{
+  char c;
+  int col, row, k;  // the name in column col (x 0/128), row row (20 texels each), its k-th letter
+};
+constexpr Source kSources[] = {
+    {'A', 0, 11, 0}, {'C', 0, 9, 4}, {'D', 0, 2, 3},  {'E', 0, 5, 4}, {'G', 0, 5, 3},  {'H', 0, 2, 1},
+    {'I', 0, 9, 3},  {'J', 1, 1, 0}, {'K', 0, 1, 0},  {'L', 0, 7, 1}, {'M', 1, 0, 1},  {'N', 0, 9, 2},
+    {'O', 0, 9, 1},  {'R', 0, 5, 0}, {'S', 0, 9, 0},  {'T', 0, 8, 0}, {'U', 0, 5, 2},  {'V', 0, 10, 2},
+    {'W', 0, 10, 0}, {'Y', 1, 0, 2}, {'-', 1, 3, 1},  {'0', 1, 3, 3}, {'1', 1, 3, 2},  {'.', 0, 0, 2},
+};
+
+Pixels FillOf(const Pixels& g)
+{
+  Pixels out;
+  for (const auto& [p, v] : g)
+    if (IsFill(v))
+      out[p] = v;
+  return out;
+}
+
+// The generated outline, the game's profile: black up to 1.5 texels from the fill, then the halo.
+Pixels Outline(const Pixels& fill)
+{
+  Pixels out = fill;
+  if (fill.empty())
+    return out;
+  int x0 = 1 << 20, y0 = 1 << 20, x1 = -(1 << 20), y1 = -(1 << 20);
+  for (const auto& [p, v] : fill)
+  {
+    x0 = std::min(x0, p.first);
+    x1 = std::max(x1, p.first);
+    y0 = std::min(y0, p.second);
+    y1 = std::max(y1, p.second);
+  }
+  for (int y = y0 - 4; y <= y1 + 4; ++y)
+    for (int x = x0 - 4; x <= x1 + 4; ++x)
+    {
+      if (fill.count({x, y}))
+        continue;
+      int best = 99;  // squared distance
+      for (int dy = -3; dy <= 3; ++dy)
+        for (int dx = -3; dx <= 3; ++dx)
+          if (fill.count({x + dx, y + dy}))
+            best = std::min(best, dx * dx + dy * dy);
+      // 1.5 -> d2 <= 2.25, 2.0 -> 4, 2.25 -> 5.06, 3.0 -> 9
+      const std::uint8_t v = best <= 2 ? 0xB : best <= 4 ? 7 : best <= 5 ? 4 : best <= 9 ? 2 : 0;
+      if (v)
+        out[{x, y}] = v;
+    }
+  return out;
+}
+
+void Over(Pixels* a, const Pixels& b)
+{
+  for (const auto& [p, v] : b)
+  {
+    auto it = a->find(p);
+    if (it == a->end() || kPrio[v] > kPrio[it->second])
+      (*a)[p] = v;
+  }
+}
+
+// The k-th letter of a name of the names' texture (indices, 256x256), in the name cell's coordinates.
+Pixels GameLetter(const std::vector<std::uint8_t>& idx, const Source& s)
+{
+  const int x0 = 128 * s.col, y0 = 20 * s.row;
+  auto at = [&](int x, int y) { return idx[static_cast<std::size_t>(y) * 256 + static_cast<std::size_t>(x)]; };
+  auto inside = [&](int x, int y) { return x >= x0 && x < x0 + 128 && y >= y0 && y < y0 + 20; };
+  std::map<std::pair<int, int>, int> lab;
+  std::vector<std::pair<int, int>> order;  // labelled texels, in the order they were labelled
+  std::vector<std::vector<std::pair<int, int>>> comps;
+  for (int y = y0; y < y0 + 20; ++y)
+    for (int x = x0; x < x0 + 128; ++x)
+    {
+      if (!IsStrong(at(x, y)) || lab.count({x, y}))
+        continue;
+      const int n = static_cast<int>(comps.size());
+      comps.emplace_back();
+      std::deque<std::pair<int, int>> q{{x, y}};
+      lab[{x, y}] = n;
+      order.push_back({x, y});
+      comps[n].push_back({x, y});
+      while (!q.empty())
+      {
+        const auto [cx, cy] = q.front();
+        q.pop_front();
+        const std::pair<int, int> next[] = {{cx + 1, cy}, {cx - 1, cy}, {cx, cy + 1}, {cx, cy - 1}};
+        for (const auto& [nx, ny] : next)
+          if (inside(nx, ny) && !lab.count({nx, ny}) && IsStrong(at(nx, ny)))
+          {
+            lab[{nx, ny}] = n;
+            order.push_back({nx, ny});
+            comps[n].push_back({nx, ny});
+            q.push_back({nx, ny});
+          }
+      }
+    }
+  std::vector<int> big;
+  for (int n = 0; n < static_cast<int>(comps.size()); ++n)
+    if (comps[n].size() >= 2)
+      big.push_back(n);
+  auto min_x = [&](int n) {
+    int m = 1 << 20;
+    for (const auto& p : comps[n])
+      m = std::min(m, p.first);
+    return m;
+  };
+  std::stable_sort(big.begin(), big.end(), [&](int a, int b) { return min_x(a) < min_x(b); });
+  if (s.k >= static_cast<int>(big.size()))
+    return {};
+  const int target = big[s.k];
+  // every texel that is not clear goes to the nearest piece (breadth first, from all of them at once)
+  std::map<std::pair<int, int>, int> prop = lab;
+  std::deque<std::pair<int, int>> q(order.begin(), order.end());
+  while (!q.empty())
+  {
+    const auto [cx, cy] = q.front();
+    q.pop_front();
+    for (int dx = -1; dx <= 1; ++dx)
+      for (int dy = -1; dy <= 1; ++dy)
+      {
+        const int nx = cx + dx, ny = cy + dy;
+        if (inside(nx, ny) && !prop.count({nx, ny}) && at(nx, ny) != 0)
+        {
+          prop[{nx, ny}] = prop[{cx, cy}];
+          q.push_back({nx, ny});
+        }
+      }
+  }
+  Pixels out;
+  for (const auto& [p, n] : prop)
+    if (n == target)
+      out[{p.first - x0, p.second - y0}] = at(p.first, p.second);
+  return out;
+}
+
+Pixels Drawn(const char* const* rows, int dy)
+{
+  Pixels out;
+  for (int y = 0; rows[y]; ++y)
+    for (int x = 0; rows[y][x]; ++x)
+      if (rows[y][x] != ' ')
+      {
+        const char c = rows[y][x];
+        const int v = c <= '9' ? c - '0' : c - 'A' + 10;
+        out[{x, y + dy}] = static_cast<std::uint8_t>(v);
+      }
+  return out;
+}
+
+// Moves a letter so that its fill starts at x 0 and the top of the capitals is row 0.
+Pixels Normalised(const Pixels& g, bool drawn, char c)
+{
+  int fx = 1 << 20, fy = 1 << 20;
+  for (const auto& [p, v] : g)
+    if (IsFill(v))
+    {
+      fx = std::min(fx, p.first);
+      fy = std::min(fy, p.second);
+    }
+  if (drawn)
+    fy = 0;
+  else if (c == '.')
+    fy -= 8;
+  else if (c == '-')
+    fy -= 6;
+  Pixels out;
+  for (const auto& [p, v] : g)
+    out[{p.first - fx, p.second - fy}] = v;
+  return out;
+}
+
+// The letters the names do not have: fills (palette indices, row by row from `dy`, the capitals' top
+// being row 0), rendered from a TTF Gibax gave (DejaVu Sans Bold Oblique renamed, Bitstream Vera
+// licence) at the names' size: widened, slanted a little more, 11 rows, the greys F E D 8 C
+// (work\etiquettes\police_cpp.py ttf).
+struct DrawnGlyph
+{
+  char c;
+  int dy;
+  const char* rows[16];  // up to nullptr
+};
+const DrawnGlyph kDrawn[] = {
+    {'B', 0, {"   8EEEEDD", "   FFFFFFFF", "   FFFC8FFF", "  8FFD  FFF", "  DFFEDFFF8", "  FFFFFFFE", "  FFE88FFFC", " 8FF8  DFFC", " EFFC CFFF", " FFFFFFFF8", "CFFFFFFEC", nullptr}},
+    {'F', 0, {"   8EEEEEED", "   FFFFFFFD", "   FFF8888", "  8FFD", "  DFFEEEEC", "  FFFFFFFC", "  FFFDDDD", " 8FF8", " EFFC", " FFF", "CFFE", nullptr}},
+    {'P', 0, {"   8EEEEED", "   FFFFFFFF", "   FFF88FFFC", "  8FFD  DFFC", "  DFFC  FFF", "  FFFEEFFFD", "  FFFFFFFD", " 8FFDCCC", " EFFC", " FFF", "CFFE", nullptr}},
+    {'Q', 0, {"    8EFFE8", "  CFFFFFFFE", "  FFFDC8FFFC", " EFF8   DFFD", "CFFE    8FFD", "DFF8    DFF8", "EFFC    FFF", "FFFC   8FFE", "DFFE  8FFFC", "CFFFFFFFFC", " CFFFFFE", "    CFFE", "     DFF8", nullptr}},
+    {'X', 0, {"  CEED   8EE8", "   FFF  8FFE", "   DFF8CFFF", "    FFFFFF", "    EFFFF", "    DFFFC", "   CFFFF8", "  CFFFFFF", "  FFF EFFC", " FFFC 8FFD", "FFFC   FFF", nullptr}},
+    {'Z', 0, {"   EEEEEEEED", "  8FFFFFFFFD", "  C888DFFFF", "      DFFF", "     DFFF", "    DFFE", "   EFFE", "  EFFE", " EFFFC", "DFFFFFFFFD", "FFFFFFFFF8", nullptr}},
+    {'2', 0, {"   CDEFFEC", "   FFFFFFF", "  CF8 CFFFC", "       EFF", "      CFFE", "     8FFE", "    EFFD", "  CFFF8", " 8FFFC", " FFFFFFFD", "8FFFFFFF8", nullptr}},
+    {'3', 0, {"   CEFFFEC", "   EFFFFFF", "   DC CFFFC", "       EFF", "    8DFFF8", "   8FFFFD", "   C8DFFF", "      EFFC", " 8    FFF", "CFFEFFFF8", "8FFFFFEC", "   C", nullptr}},
+    {'4', 0, {"      CEEE", "     CFFFF", "     FFFFD", "    FFEFF8", "   FF8DFF", "  EFD FFF", " EFE CFFD", " FFFFFFFFE", "8FFFFFFFFD", "     FFE", "    CFFD", nullptr}},
+    {'5', 0, {"   CEEEEEEC", "   DFFFFFF", "   FFD8888", "   FF8C", "  8FFFFFE", "  EFFFFFF8", "  C   DFFD", "      8FF8", " D    FFF", " FFFFFFF8", "CFFFFFFC", nullptr}},
+    {'6', 0, {"    8EFFE8", "   FFFFFF8", "  FFF8  8", " DFFC", " FFFFFFF", "8FFFFFFFD", "DFFE  FFE", "DFFC  FFE", "DFF  DFF8", "CFFFEFFE", " DFFFFD", "   C", nullptr}},
+    {'7', 0, {"  DEEEEEEE", "  FFFFFFFF", "  8888FFF8", "     CFFE", "     FFF", "    EFFC", "   8FFD", "   FFF", "  EFFC", " DFF8", "CFFE", nullptr}},
+    {'8', 0, {"   8EFFE8", "  EFFFFFF8", " CFFE 8FFD", " 8FFC 8FFC", " CFFFDFFD", "  EFFFFE", "CFFECEFFC", "FFF  CFF8", "FFE  DFFC", "FFFEEFFE", "CFFFFFD", "   C", nullptr}},
+    {'9', 0, {"   8EFFD", "  EFFFFFE", " 8FFD EFFC", " FFF  8FFC", " FFE  FFFC", " FFFDEFFF", " DFFFFFFF", "  C888FF8", "     FFF", "EFEEFFF", "FFFFFD", "  C", nullptr}},
+    {'!', 0, {"   EED", "   FFD", "  8FFC", "  EFF", "  FFE", "  FF8", "  FF", "  8C", " DD8", "CFF8", "DFF", nullptr}},
+    {'?', 0, {" 8EFFEC", " FFFFFF", "CEC EFF", "    FFF", "   FFFC", " CFFFC", " FFF", " 88C", "CDD", "EFF", "FFE", nullptr}},
+    {'_', 13, {"FFFFFFFD", "8888888C", nullptr}},
