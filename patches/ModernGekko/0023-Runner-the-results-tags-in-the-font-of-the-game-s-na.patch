+// The font: the game's letters, then the drawn ones (kDrawn, generated outline).
+std::map<char, Pixels> ResultsFont(const std::vector<std::uint8_t>& idx)
+{
+  std::map<char, Pixels> font;
+  for (const Source& s : kSources)
+  {
+    const Pixels g = GameLetter(idx, s);
+    if (g.empty())
+      continue;
+    Pixels full = Outline(FillOf(g));
+    Over(&full, g);
+    font[s.c] = Normalised(full, false, s.c);
+  }
+  for (const DrawnGlyph& d : kDrawn)
+    font[d.c] = Normalised(Outline(Drawn(d.rows, d.dy)), true, d.c);
+  return font;
+}
+
+// One tag, laid out and centred like the game's names (fill centre at x 66 of 128), rows relative to the
+// top of the capitals.
+Pixels LayOut(const std::map<char, Pixels>& font, const std::string& tag)
+{
+  Pixels out;
+  int x = 4;
+  for (char c : tag)
+  {
+    if (c == ' ')
+    {
+      x += 6;
+      continue;
+    }
+    auto it = font.find(c);
+    if (it == font.end())
+      it = font.find('?');
+    if (it == font.end())
+      continue;
+    int right = 0;
+    for (const auto& [p, v] : it->second)
+    {
+      const std::pair<int, int> q{x + p.first, p.second};
+      auto o = out.find(q);
+      if (o == out.end() || kPrio[v] > kPrio[o->second])
+        out[q] = v;
+      if (IsFill(v))
+        right = std::max(right, p.first);
+    }
+    x += right + 2;
+  }
+  int x0 = 1 << 20, x1 = -(1 << 20);
+  for (const auto& [p, v] : out)
+    if (IsFill(v))
+    {
+      x0 = std::min(x0, p.first);
+      x1 = std::max(x1, p.first);
+    }
+  if (x1 < x0)
+    return {};
+  const int dx = 66 - (x0 + x1) / 2;
+  Pixels centred;
+  for (const auto& [p, v] : out)
+    centred[{p.first + dx, p.second}] = v;
+  return centred;
+}
+
+// The results' tags: reads the names' texture (its GVR header still in front of it in the loaded GTSE),
+// takes its palette, lays out each racer's tag in its 16-row band (the capitals' top on row 2, as the
+// game's names sit on rows 4-15 of their 20). False when the texture is not there yet.
+bool BuildResults(std::uint32_t gtse, std::array<std::uint8_t, kTagSize * kTagSize / 2>* texels,
+                  std::array<std::uint16_t, 16>* palette, std::array<int, 8>* flags)
+{
+  const std::uint8_t* h = Guest(gtse + kNamesInGtse, 0x40 + 256 * 256 / 2);
+  if (!h || std::memcmp(h, "GCIX", 4) != 0 || std::memcmp(h + 0x10, "GVRT", 4) != 0 || h[0x1B] != 8 ||
+      Get32(h + 0x1C) != 0x01000100u)
+    return false;
+  for (std::size_t i = 0; i < 16; ++i)
+    (*palette)[i] = static_cast<std::uint16_t>((h[0x20 + 2 * i] << 8) | h[0x21 + 2 * i]);
+  std::vector<std::uint8_t> idx(256 * 256);
+  const std::uint8_t* tex = h + 0x40;
+  std::size_t pos = 0;
+  for (int by = 0; by < 256; by += 8)
+    for (int bx = 0; bx < 256; bx += 8)
+    {
+      for (int i = 0; i < 64; ++i)
+      {
+        const std::uint8_t b = tex[pos + static_cast<std::size_t>(i / 2)];
+        idx[static_cast<std::size_t>(by + i / 8) * 256 + static_cast<std::size_t>(bx + i % 8)] =
+            (i % 2) ? (b & 0x0F) : (b >> 4);
+      }
+      pos += 32;
+    }
+  const std::map<char, Pixels> font = ResultsFont(idx);
+  texels->fill(0);
+  for (std::size_t k = 0; k < 8; ++k)
+  {
+    (*flags)[k] = 0;
+    const std::string& tag = Tags()[k];
+    if (tag.empty())
+      continue;
+    for (const auto& [p, v] : LayOut(font, tag))
+    {
+      const int x = p.first, y = p.second + 2;
+      if (x < 0 || x >= static_cast<int>(kTagSize) || y < 0 || y >= 16 || !v)
+        continue;
+      const int ty = static_cast<int>(k) * 16 + y;
+      const std::size_t tile = static_cast<std::size_t>((ty / 8) * (kTagSize / 8) + x / 8);
+      std::uint8_t& byte = (*texels)[tile * 32 + static_cast<std::size_t>((ty % 8) * 4 + (x % 8) / 2)];
+      byte = static_cast<std::uint8_t>((x % 2) ? (byte & 0xF0) | v : (byte & 0x0F) | (v << 4));
+    }
+    (*flags)[k] = 1;
+  }
+  return true;
+}
+
+// The results' table: per racer, its band of the texture (u0 v0 u1 v1) and a flag (u16): 0 = no tag.
+void WriteResTable(const std::array<int, 8>& flags)
+{
+  std::uint8_t* t = Guest(kResTable, 8 * 0x18);
+  if (!t)
+    return;
+  auto put_float = [](std::uint8_t* p, float f) {
+    std::uint32_t v;
+    std::memcpy(&v, &f, 4);
+    Put32(p, v);
+  };
+  for (std::uint32_t k = 0; k < 8; ++k)
+  {
+    std::uint8_t* r = t + k * 0x18;
+    put_float(r + 0x00, 0.0f);
+    put_float(r + 0x04, static_cast<float>(k * 16) / static_cast<float>(kTagSize));
+    put_float(r + 0x08, 1.0f);
+    put_float(r + 0x0C, static_cast<float>(k * 16 + 16) / static_cast<float>(kTagSize));
+    Put32(r + 0x10, flags[k] ? 0x00010000u : 0);
+    Put32(r + 0x14, 0);
+  }
+}
