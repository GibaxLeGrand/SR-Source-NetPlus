 // FNV-1a 64 of the 8 racers, without the fields that follow the camera (measured on 2026-11-25).
 std::uint64_t RacersHash();
diff --git a/src/runtime/srnp_relay.cpp b/src/runtime/srnp_relay.cpp
index 7668877..6ecea9d 100644
--- a/src/runtime/srnp_relay.cpp
+++ b/src/runtime/srnp_relay.cpp
@@ -518,12 +518,14 @@ bool TakePicks(const std::string& line)
 }
 
 // The local seat's choice on the waiting screen: left/right (D-pad or stick) the character (0-16 but
-// Super Sonic), up/down the gear, A ready, B back to choosing. SRNP_LOBBY_AUTO=<c>/<g>/<seconds> (tests):
-// that choice, then ready, after that many seconds.
+// Super Sonic), up/down the gear, A ready, B back to choosing. SRNP_LOBBY_AUTO=<c>/<g>/<seconds>[/<back>]
+// (tests): that choice, then ready, after that many seconds; with <back>, B that many seconds later (back
+// to choosing), then A again after as many.
 struct LobbyLocal
 {
   int character = 0, gear = 0;
   bool ready = false, started = false;
+  int auto_step = 0;
   unsigned previous = 0;
   std::chrono::steady_clock::time_point since;
 };
@@ -544,18 +546,23 @@ bool LobbyStep(LobbyLocal* l)
     l->character = std::max(0, SeatCharacter(seat));
     LobbySend(seat, *l);
   }
-  if (l->ready)
-    return false;
+  const auto set_ready = [&](bool ready) {
+    l->ready = ready;
+    SendLine((ready ? "READY " : "UNREADY ") + std::to_string(seat));
+  };
   static const char* autopick = std::getenv("SRNP_LOBBY_AUTO");
   if (autopick && *autopick)
   {
-    int c = 0, g = 0, seconds = 3;
-    std::sscanf(autopick, "%d/%d/%d", &c, &g, &seconds);
-    if (std::chrono::steady_clock::now() - l->since < std::chrono::seconds(seconds))
+    int c = 0, g = 0, seconds = 3, back = 0;
+    std::sscanf(autopick, "%d/%d/%d/%d", &c, &g, &seconds, &back);
+    const int steps = back > 0 ? 3 : 1;  // ready; with <back>: then back to choosing, then ready again
+    if (l->auto_step >= steps ||
+        std::chrono::steady_clock::now() - l->since < std::chrono::seconds(seconds + back * l->auto_step))
       return false;
-    l->character = c, l->gear = g, l->ready = true;
-    LobbySend(seat, *l);
-    SendLine("READY " + std::to_string(seat));
+    if (l->auto_step == 0)
+      l->character = c, l->gear = g, LobbySend(seat, *l);
+    set_ready(l->auto_step != 1);
+    ++l->auto_step;
     return true;
   }
   g_controller_interface.UpdateInput();  // the game stands still: nothing else reads the pads now
@@ -566,6 +573,14 @@ bool LobbyStep(LobbyLocal* l)
           (y < -40 ? 0x80u : 0u);
   const unsigned pressed = bits & ~l->previous;
   l->previous = bits;
+  if (l->ready)
+  {
+    // Ready: only B, back to choosing (the relay starts the race once nobody is choosing).
+    if (!(pressed & 0x2u))
+      return false;
+    set_ready(false);
+    return true;
+  }
   bool changed = false;
   const auto next = [](int c, int step) {
     do
@@ -585,8 +600,7 @@ bool LobbyStep(LobbyLocal* l)
     LobbySend(seat, *l);
   if (pressed & 0x1u)
   {
-    l->ready = true;
-    SendLine("READY " + std::to_string(seat));
+    set_ready(true);
     changed = true;
   }
   return changed;
@@ -680,8 +694,12 @@ WaitView RelayWaitView()
     view.states = s_wait_states;
   }
   view.local = s_relay.local;
+  view.lobby = LobbyOn();
   for (int k = 0; k < view.seats && k < 8; ++k)
+  {
     view.characters[static_cast<std::size_t>(k)] = SeatCharacter(k);
+    view.gears[static_cast<std::size_t>(k)] = SeatGear(k);
+  }
   return view;
 }
 
diff --git a/src/runtime/srnp_relay.hpp b/src/runtime/srnp_relay.hpp
