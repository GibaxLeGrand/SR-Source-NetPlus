 };
 WaitView RelayWaitView();
 
diff --git a/src/runtime/srnp_waiting_screen.cpp b/src/runtime/srnp_waiting_screen.cpp
index 4a10b21..92bef26 100644
--- a/src/runtime/srnp_waiting_screen.cpp
+++ b/src/runtime/srnp_waiting_screen.cpp
@@ -129,6 +129,25 @@ void GameLabel(ImDrawList* list, ImFont* font, ImVec2 centre, float unit, int se
   Label(list, font, centre, unit, text, com);
 }
 
+// Lobby (SRNP_LOBBY=1): the controls for this machine's seat at the bottom of the screen, in the names'
+// font if there (`name_font`): the choice while it chooses, B once it is ready.
+void LobbyHint(const WaitView& view, ImDrawList* list, ImFont* font, ImVec2 display, float unit, bool name_font)
+{
+  if (!view.lobby || view.local.empty())
+    return;
+  const int seat = view.local.front();
+  const char s = seat < static_cast<int>(view.states.size()) ? view.states[static_cast<std::size_t>(seat)] : 'O';
+  // (the names' font has "/" but no ":")
+  const char* hint = s == 'O' ? "LEFT/RIGHT  CHARACTER      UP/DOWN  GEAR      A  READY" :
+                     s == 'V' ? "B  BACK TO CHOOSING" :
+                                nullptr;
+  if (!hint)
+    return;
+  const ImVec2 at(display.x * 0.5f, display.y * 0.93f);
+  if (!(name_font && NameTextCentred(list, hint, at, unit * 0.75f, Rgba(255, 214, 64), display.x * 0.9f)))
+    TextCentred(list, font, unit * 0.55f, at, Rgba(255, 214, 64), hint);
+}
+
 // Gibax's mockup in the game's look: the blue of the menus (Player Entry), the game's "ARE YOU READY?",
 // one card a seat on the menus' rounded panel, with the game's label and the character's select icon
 // (its head and name), faded and bluish while the player is on the way.
@@ -237,6 +256,17 @@ void DrawWithGamePictures(const WaitView& view, ImDrawList* list, ImFont* font,
       const float q = side_h;
       Picture(list, unknown, ImVec2(x - q * 0.5f, i0.y), ImVec2(x + q * 0.5f, i0.y + q), ImVec2(0, 0), ImVec2(1, 1), tint);
     }
+    // Lobby: the gear chosen, under the head (its number for now: the race corrects a gear the
+    // character may not ride).
+    const int gear = view.gears[static_cast<std::size_t>(k)];
+    if (view.lobby && s != 'X' && gear >= 0)
+    {
+      char text[16];
+      std::snprintf(text, sizeof(text), "GEAR %d", gear);
+      const ImVec2 at(x, top + card_h * 0.745f);
+      if (!(name_font && NameTextCentred(list, text, at, card_h * 0.075f, tint, card_w * 0.9f)))
+        TextCentred(list, font, card_h * 0.06f, at, tint, text);
+    }
     // The state: blue circle (on the way, pulsing), green tick (there), red cross (left).
     const ImVec2 mark(x, top + card_h * 0.88f);
     const float r = unit * 0.42f;
@@ -268,6 +298,7 @@ void DrawWithGamePictures(const WaitView& view, ImDrawList* list, ImFont* font,
     if (mine && !(name_font && NameTextCentred(list, "YOU", ImVec2(x, below), unit * 0.7f, Rgba(255, 214, 64))))
       TextCentred(list, font, unit * 0.5f, ImVec2(x, below), Rgba(255, 214, 64), "YOU");
   }
+  LobbyHint(view, list, font, display, unit, name_font);
 }
 
 void Draw(const WaitView& view)
@@ -346,6 +377,7 @@ void Draw(const WaitView& view)
     if (mine)
       TextCentred(list, font, unit * 0.5f, ImVec2(x, display.y * 0.86f), Rgba(255, 214, 64), "YOU");
   }
+  LobbyHint(view, list, font, display, unit, false);
 }
 }  // namespace
 
