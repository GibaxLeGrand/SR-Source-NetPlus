+
+void SetSeatTag(int seat, const std::string& text)
+{
+  if (seat < 0 || seat >= 8)
+    return;
+  std::string tag;
+  for (const char c : text)
+    if (tag.size() < 8 && c != ',' && static_cast<unsigned char>(c) > ' ')
+      tag += static_cast<char>(std::toupper(static_cast<unsigned char>(c)));
+  {
+    std::lock_guard lock(s_tags_mutex);
+    std::string& now = TagsLocked()[static_cast<std::size_t>(seat)];
+    if (now == tag || tag.empty())
+      return;
+    now = tag;
+  }
+  s_tags_version.fetch_add(1, std::memory_order_relaxed);
+  std::fprintf(stderr, "[srnp labels] seat %d's tag: %s (from the relay)\n", seat, tag.c_str());
 }
 
