@@ -437,6 +441,35 @@ bool Connect()
     if (!SendLine("HELLO " + std::to_string(seat) + " " + std::to_string(s_relay.seats) + " " +
                   std::to_string(s_relay.delay)))
       return false;
+  // Each local seat's tag (SRNP_TAG for the first, else SRNP_TAGS' entry): the relay passes them on.
+  const char* own = std::getenv("SRNP_TAG");
+  for (std::size_t i = 0; i < s_relay.local.size(); ++i)
+  {
+    const int seat = s_relay.local[i];
+    std::string tag = i == 0 && own && *own ? std::string(own) : PlayerTag(seat);
+    std::erase_if(tag, [](char c) { return static_cast<unsigned char>(c) <= ' ' || c == ','; });
+    if (!tag.empty() && !SendLine("TAG " + std::to_string(seat) + " " + tag.substr(0, 8)))
+      return false;
+  }
+  return true;
+}
+
+// TAGS <tag seat 0>,<tag seat 1>,... ("-": none): the players' tags as the relay knows them.
+bool TakeTags(const std::string& line)
+{
+  if (line.rfind("TAGS ", 0) != 0)
+    return false;
+  std::size_t p = 5;
+  for (int seat = 0; seat < 8 && p <= line.size(); ++seat)
+  {
+    const std::size_t q = line.find(',', p);
+    const std::string tag = line.substr(p, q == std::string::npos ? std::string::npos : q - p);
+    if (!tag.empty() && tag != "-")
+      SetSeatTag(seat, tag);
+    if (q == std::string::npos)
+      break;
+    p = q + 1;
+  }
   return true;
 }
 
