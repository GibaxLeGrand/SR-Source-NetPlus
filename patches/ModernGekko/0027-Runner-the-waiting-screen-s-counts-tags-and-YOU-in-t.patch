+std::vector<std::uint8_t> NameFontText(const std::vector<std::uint8_t>& names, const std::string& text,
+                                       int* width)
+{
+  // the font is made once: the names' texture is the same file each time
+  static std::map<char, Pixels> font;
+  static bool made = false;
+  if (!made)
+  {
+    if (names.size() != 256 * 256)
+      return {};
+    font = ResultsFont(names);
+    made = true;
+  }
+  std::string upper(text);
+  for (char& c : upper)
+    c = static_cast<char>(std::toupper(static_cast<unsigned char>(c)));
+  const Pixels laid = Compose(font, upper);
+  int x0 = 1 << 20, x1 = -(1 << 20);
+  for (const auto& [p, v] : laid)
+  {
+    x0 = std::min(x0, p.first);
+    x1 = std::max(x1, p.first);
+  }
+  if (x1 < x0)
+    return {};
+  const int w = x1 - x0 + 1;
+  std::vector<std::uint8_t> out(static_cast<std::size_t>(w) * 16, 0);
+  for (const auto& [p, v] : laid)
+  {
+    const int y = p.second + 2;  // the capitals' top on row 2, as in the game's names
+    if (y >= 0 && y < 16)
+      out[static_cast<std::size_t>(y) * static_cast<std::size_t>(w) + static_cast<std::size_t>(p.first - x0)] = v;
+  }
+  *width = w;
+  return out;
+}
