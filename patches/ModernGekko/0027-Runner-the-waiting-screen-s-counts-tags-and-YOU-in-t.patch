+// GTSE's 7th GVR texture, "GoalResult_01_E" (the results' names, 256x256 CI4): its palette indices,
+// row by row, and its 16 colours.
+bool NamesTexture(std::vector<std::uint8_t>* indices, std::vector<std::uint32_t>* colours)
+{
+  const std::vector<std::uint8_t>& d = File(s_root / "files" / "GTSE");
+  std::size_t at = 0;
+  int k = -1;
+  for (;;)
+  {
+    std::size_t found = std::string::npos;
+    for (std::size_t i = at; i + 4 <= d.size(); ++i)
+      if (d[i] == 'G' && d[i + 1] == 'C' && d[i + 2] == 'I' && d[i + 3] == 'X')
+      {
+        found = i;
+        break;
+      }
+    if (found == std::string::npos)
+      return false;
+    if (++k == 6)
+    {
+      at = found;
+      break;
+    }
+    at = found + 4;
+  }
+  const std::size_t g = at + 0x10;
+  if (Be32(d, g) != 0x47565254u || d[g + 0xB] != 8 || Be16(d, g + 0xC) != 256 || Be16(d, g + 0xE) != 256)
+    return false;
+  const std::size_t palette = g + 0x10, texels = palette + 0x20;
+  if (texels + 256 * 256 / 2 > d.size())
+    return false;
+  colours->resize(16);
+  for (std::size_t c = 0; c < 16; ++c)
+    (*colours)[c] = Rgb5a3(Be16(d, palette + 2 * c));
+  indices->assign(256 * 256, 0);
+  std::size_t n = 0;
+  for (int ty = 0; ty < 256; ty += 8)
+    for (int tx = 0; tx < 256; tx += 8)
+      for (int y = 0; y < 8; ++y)
+        for (int x = 0; x < 8; ++x, ++n)
+        {
+          const std::uint8_t b = d[texels + n / 2];
+          (*indices)[static_cast<std::size_t>(ty + y) * 256 + static_cast<std::size_t>(tx + x)] =
+              static_cast<std::uint8_t>(n % 2 == 0 ? b >> 4 : b & 15);
+        }
+  return true;
+}
 }  // namespace
 
+GamePicture NameText(const std::string& text)
+{
+  return Cached("srnp name font: " + text, 0, [&] {
+    Decoded out;
+    std::vector<std::uint8_t> names;
+    std::vector<std::uint32_t> colours;
+    if (!NamesTexture(&names, &colours))
+      return out;
+    int w = 0;
+    const std::vector<std::uint8_t> laid = NameFontText(names, text, &w);
+    if (laid.empty() || w <= 0)
+      return out;
+    out.width = w, out.height = 16;
+    out.rgba.resize(laid.size());
+    for (std::size_t i = 0; i < laid.size(); ++i)
+      out.rgba[i] = colours[laid[i]];  // index 0 is clear in the names' palette
+    return out;
+  });
+}
