+// Text in the font of the game's results names (Gibax, 2026-11-25: the counts, "YOU" and the players'
+// tags as the results screen writes the names), `height` tall with its outline (16 texels), centred,
+// narrowed to `max_width`; the tint colours its white. False without the game's GTSE.
+bool NameTextCentred(ImDrawList* list, const std::string& text, ImVec2 centre, float height, ImU32 tint,
+                     float max_width = 1e9f)
+{
+  const GamePicture p = NameText(text);
+  if (!p.ok || p.height <= 0.0f)
+    return false;
+  float h = height, w = p.width * height / p.height;
+  if (w > max_width)
+    h *= max_width / w, w = max_width;
+  Picture(list, p, ImVec2(centre.x - w * 0.5f, centre.y - h * 0.5f), ImVec2(centre.x + w * 0.5f, centre.y + h * 0.5f),
+          ImVec2(0, 0), ImVec2(1, 1), tint);
+  return true;
+}
