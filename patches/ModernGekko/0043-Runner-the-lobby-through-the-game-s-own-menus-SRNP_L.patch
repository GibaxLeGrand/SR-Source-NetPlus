+        Off("the lobby through the game's menus needs a start state (--load-state)");
     }
     else if (std::getenv("SRNP_RELAY"))
       Off("cannot reach the relay");
   }
   if (!s_relay.on)
     return;
+  if (LobbyVanilla() && !VanillaStep(&frame))
+    return;
 
   if (s_relay.check_every > 0 && frame % static_cast<std::uint64_t>(s_relay.check_every) == 0)
   {
