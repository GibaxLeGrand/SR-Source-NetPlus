 {
   if (!s_relay.tried)
@@ -943,16 +1164,22 @@ void RelayStep(std::uint64_t frame)
           s_relay.racers ? ", racers mode, camera on racer " + std::to_string(s_relay.camera) : "";
       std::fprintf(stderr,
