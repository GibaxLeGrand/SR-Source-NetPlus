 namespace
 {
+std::uint32_t GuestWord(std::uint32_t address)
+{
+  const std::uint8_t* p = GuestByte(address);
+  return p ? (static_cast<std::uint32_t>(p[0]) << 24) | (static_cast<std::uint32_t>(p[1]) << 16) |
+                 (static_cast<std::uint32_t>(p[2]) << 8) | p[3] :
+             0;
+}
+
+// The player's pad in the game's menus (port 0, this machine only): the real one, or SRNP_LOBBY_KEYS for
+// tests (one key every 30 frames, held 12, from frame 120). The start state is on Player Entry's "ARE
+// YOU READY?": B at frames 30 and 60 (held 6) brings the player back to the character choice first
+// (Gibax, 2026-11-25: start where you choose).
+Pad VanillaPad(std::uint64_t frame)
+{
+  Pad pad{};
+  if ((frame >= 30 && frame < 36) || (frame >= 60 && frame < 66))
+  {
+    pad[1] = 0x2;  // B
+    return pad;
+  }
+  if (frame < 90)
+    return pad;
+  static const char* keys = std::getenv("SRNP_LOBBY_KEYS");
+  if (keys && *keys)
+  {
+    if (frame >= 120 && (frame - 120) / 30 < std::strlen(keys) && (frame - 120) % 30 < 12)
+    {
+      const unsigned bits = KeyBits(keys[(frame - 120) / 30]);
+      pad[0] = static_cast<std::uint8_t>(bits >> 8);
+      pad[1] = static_cast<std::uint8_t>(bits);
+    }
+    return pad;
+  }
+  return s_relay.input_mode == "manette" ? RealPad() : pad;
+}
+
+// The lobby through the game's menus, before the lockstep: one call a game frame. Free: the game runs
+// alone, the player's pad on port 0, until the player presses Start on Player Entry (the menu writes
+// the race's racers: the racer count leaves 1); then this player's character and gear (racer 0), the
+// host's course and laps (its own Track Select and Rule Settings), READY, and the waiting screen until
+// GO. At GO the start state is loaded again (on another thread: the CPU must reach a point where it can
+// stop); once it is back (the racer count is 1 again, the Player Entry's) the rules are written, the
+// game frames count from 1 again, and the lockstep starts as from the boot. True once in the lockstep
+// (*frame from 1).
+bool VanillaStep(std::uint64_t* frame)
+{
+  constexpr std::uint32_t kRacerCount = 0x8021B8C0u, kRacer0 = 0x80609440u;
+  static std::uint32_t last_count = 0;
+  static std::uint64_t setup_at = 0;
+  switch (s_vanilla.load())
+  {
+  case Vanilla::Free:
+  {
+    while (LineReady(0))  // the relay's lines between frames: nothing waits on them here
+    {
+      std::string line;
+      if (!ReadLine(&line))
+      {
+        Off("relay lost in the menus");
+        return false;
+      }
+      if (!TakeTags(line) && !TakePicks(line))
+        TakeRules(line);
+    }
+    ApplyPad(0, VanillaPad(*frame));
+    const std::uint32_t count = GuestWord(kRacerCount);
+    if (count != 1 && last_count == 1 && setup_at == 0)
+      setup_at = *frame;
+    last_count = count;
+    if (setup_at == 0 || *frame < setup_at + 2)
+      return false;
+    const int seat = s_relay.local.front();
+    const std::uint8_t* racer = GuestByte(kRacer0);
+    const int character = racer ? racer[0xBA] : 0, gear = racer ? racer[0xBB] : 0;
+    ApplyPad(0, Pad{});
+    SendLine("PICK " + std::to_string(seat) + " " + std::to_string(character) + " " + std::to_string(gear));
+    if (seat == 0)
+    {
+      const std::uint8_t* c = GuestByte(kRuleCourse);
+      const std::uint8_t* l = GuestByte(kRuleLaps);
+      if (c && l && *c >= 1 && *c <= kCourses && *l >= 1 && *l <= kMaxLaps)
+        SendRules(*c, *l, std::max(s_relay.seats, RacersWanted() ? RacersWanted() : 8));
+    }
+    SendLine("READY " + std::to_string(seat));
+    std::fprintf(stderr, "[srnp relay] chosen in the game's menus: character %d, gear %d (frame %llu)\n",
+                 character, gear, static_cast<unsigned long long>(*frame));
+    s_vanilla = Vanilla::Waiting;
+    s_veil = true;  // from now until the race's loading: the waiting screen, not the game
+    WaitForGo();
+    if (!s_relay.on)
+      return false;
+    s_vanilla = Vanilla::Reloading;
+    std::thread([] {
+      State::LoadAs(Core::System::GetInstance(), s_start_state);
+      std::fprintf(stderr, "[srnp relay] start state asked again: %s\n", s_start_state.c_str());
+    }).detach();
+    return false;
+  }
+  case Vanilla::Reloading:
+    if (GuestWord(kRacerCount) != 1)
+      return false;  // still the menus' race: the start state is not back yet
+    s_game_frames.store(1);
+    *frame = 1;
+    ApplyRules();
+    s_vanilla = Vanilla::Synced;
+    std::fprintf(stderr, "[srnp relay] start state back: the lockstep starts\n");
+    return true;
+  case Vanilla::Synced:
+  {
+    // The veil comes off 15 frames after seat 0's Start has set the race up (the racer count leaves 1,
+    // at the end of the menu's fade): the screen is black by then (Gibax: "juste avant que le
+    // chargement commence").
+    static std::uint64_t loading_at = 0;
+    if (s_veil && loading_at == 0 && GuestWord(kRacerCount) != 1)
+      loading_at = *frame;
+    if (s_veil && loading_at != 0 && *frame >= loading_at + 15)
+    {
+      s_veil = false;
+      std::fprintf(stderr, "[srnp relay] waiting screen off: the race loads (frame %llu)\n",
+                   static_cast<unsigned long long>(*frame));
+    }
+    return true;
+  }
+  default:
+    return false;
+  }
+}
+
