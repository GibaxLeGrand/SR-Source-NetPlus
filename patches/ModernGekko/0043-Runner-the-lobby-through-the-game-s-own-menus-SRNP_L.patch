+// The relay's bits for a key of SRNP_LOBBY_KEYS (tests): L R U D (D-pad), A B X Y, + - (R, L), Z,
+// S (Start).
+unsigned KeyBits(char k)
+{
+  switch (k)
+  {
+  case 'L': return 0x100u;
+  case 'R': return 0x200u;
+  case 'U': return 0x40u;
+  case 'D': return 0x80u;
+  case 'A': return 0x1u;
+  case 'B': return 0x2u;
+  case 'X': return 0x4u;
+  case 'Y': return 0x8u;
+  case '+': return 0x800u;
+  case '-': return 0x400u;
+  case 'Z': return 0x10u;
+  case 'S': return 0x20u;
+  default: return 0u;
+  }
+}
+
+// The waiting screen of the lobby through the game's menus: the host still sets the racers (Z, from the
+// seats to 8); course and laps came from its own menus.
+bool VanillaWaitStep()
+{
+  if (s_relay.local.front() != 0 || s_rule_course < 1)
+    return false;
+  static unsigned previous = 0;
+  g_controller_interface.UpdateInput();  // the game stands still: nothing else reads the pads now
+  const Pad pad = s_relay.input_mode == "manette" ? RealPad() : Pad{};
+  const unsigned bits = (static_cast<unsigned>(pad[0]) << 8) | pad[1];
+  const unsigned pressed = bits & ~previous;
+  previous = bits;
+  if (!(pressed & 0x10u))
+    return false;
+  const int racers = std::max(s_relay.seats, static_cast<int>(s_rule_racers));
+  SendRules(s_rule_course, s_rule_laps, racers >= 8 ? s_relay.seats : racers + 1);
+  return true;
+}
