@@ -38,6 +38,8 @@ struct WaitView
 {
   bool waiting = false;
   bool lobby = false;
+  bool host = false;  // this machine has seat 0: it sets the rules
+  int course = -1, laps = -1;  // the host's rules (-1: the save state's)
   int seats = 0;
   std::string states;
   std::vector<int> local;
diff --git a/src/runtime/srnp_waiting_screen.cpp b/src/runtime/srnp_waiting_screen.cpp
index b5da4a5..1651920 100644
--- a/src/runtime/srnp_waiting_screen.cpp
+++ b/src/runtime/srnp_waiting_screen.cpp
@@ -48,6 +48,13 @@ constexpr const char* kGearNames[] = {
     "GRINDER",      "ADVANTAGE S", "ADVANTAGE F", "ADVANTAGE P",   "CANNONBALL"};
 static_assert(std::size(kGearNames) == 41);
 
+// The courses by the game's number (1-16: measured on 2026-11-25, the race's title for 1, 2, 9, 13, 16).
+constexpr const char* kCourseNames[] = {
+    "",           "METAL CITY",  "SPLASH CANYON", "EGG FACTORY", "GREEN CAVE",        "SAND RUINS",
+    "BABYLON GARDEN", "DIGITAL DIMENSION", "SEGA CARNIVAL", "NIGHT CHASE", "RED CANYON", "ICE FACTORY",
+    "WHITE CAVE", "DARK DESERT", "SKY ROAD",      "BABYLON GUARDIAN", "SEGA ILLUSION"};
+static_assert(std::size(kCourseNames) == 17);
+
 std::atomic<bool> s_redraw_queued{false};
 
 ImU32 Rgba(int r, int g, int b, float a = 1.0f)
@@ -160,6 +167,27 @@ void LobbyHint(const WaitView& view, ImDrawList* list, ImFont* font, ImVec2 disp
   const ImVec2 at(display.x * 0.5f, display.y * 0.93f);
   if (!(name_font && NameTextCentred(list, hint, at, unit * 0.75f, Rgba(255, 214, 64), display.x * 0.9f)))
     TextCentred(list, font, unit * 0.55f, at, Rgba(255, 214, 64), hint);
+  // the host's rules, while it chooses
+  if (view.host && s == 'O' && view.course >= 1)
+  {
+    const char* rules = "X/Y  TRACK      L/R  LAPS";
+    const ImVec2 above(display.x * 0.5f, display.y * 0.865f);
+    if (!(name_font && NameTextCentred(list, rules, above, unit * 0.75f, Rgba(120, 220, 255), display.x * 0.9f)))
+      TextCentred(list, font, unit * 0.55f, above, Rgba(120, 220, 255), rules);
+  }
+}
+
+// The host's rules (the course and the laps), under the counts.
+void RulesLine(const WaitView& view, ImDrawList* list, ImFont* font, ImVec2 display, float unit, bool name_font,
+               float y)
+{
+  if (view.course < 1 || view.course >= static_cast<int>(std::size(kCourseNames)) || view.laps < 1)
+    return;
+  char text[48];
+  std::snprintf(text, sizeof(text), "%s   %d LAP%s", kCourseNames[view.course], view.laps, view.laps > 1 ? "S" : "");
+  const ImVec2 at(display.x * 0.5f, display.y * y);
+  if (!(name_font && NameTextCentred(list, text, at, unit * 0.75f, Rgba(120, 220, 255), display.x * 0.9f)))
+    TextCentred(list, font, unit * 0.6f, at, Rgba(120, 220, 255), text);
 }
 
 // Gibax's mockup in the game's look: the blue of the menus (Player Entry), the game's "ARE YOU READY?",
@@ -315,6 +343,7 @@ void DrawWithGamePictures(const WaitView& view, ImDrawList* list, ImFont* font,
       TextCentred(list, font, unit * 0.5f, ImVec2(x, below), Rgba(255, 214, 64), "YOU");
   }
   LobbyHint(view, list, font, display, unit, name_font);
+  RulesLine(view, list, font, display, unit, name_font, 0.255f);
 }
 
 void Draw(const WaitView& view)
@@ -394,6 +423,7 @@ void Draw(const WaitView& view)
       TextCentred(list, font, unit * 0.5f, ImVec2(x, display.y * 0.86f), Rgba(255, 214, 64), "YOU");
   }
   LobbyHint(view, list, font, display, unit, false);
+  RulesLine(view, list, font, display, unit, false, 0.37f);
 }
 }  // namespace
 
