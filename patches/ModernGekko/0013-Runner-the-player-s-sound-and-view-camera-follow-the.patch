+// SRNP_WATCH=<address>,... (hexadecimal): words of guest memory logged whenever they change, with the
+// race frame (read at the head of the game's frame, as the checksums).
+void WatchWords()
+{
+  static std::vector<std::pair<std::uint32_t, std::uint32_t>> watched = [] {
+    std::vector<std::pair<std::uint32_t, std::uint32_t>> list;
+    const char* v = std::getenv("SRNP_WATCH");
+    for (const char* p = v; p && *p;)
+    {
+      char* end = nullptr;
+      const unsigned long address = std::strtoul(p, &end, 16);
+      if (end == p)
+        break;
+      list.emplace_back(static_cast<std::uint32_t>(address) & ~3u, 0u);
+      p = *end == ',' ? end + 1 : nullptr;
+    }
+    return list;
+  }();
+  for (auto& [address, last] : watched)
+  {
+    const std::uint32_t now = Read32(address);
+    if (now != last)
+      std::fprintf(stderr, "[srnp watch] frame %llu 0x%08X %08X -> %08X\n",
+                   static_cast<unsigned long long>(s_frames), address, last, now);
+    last = now;
+  }
+}
