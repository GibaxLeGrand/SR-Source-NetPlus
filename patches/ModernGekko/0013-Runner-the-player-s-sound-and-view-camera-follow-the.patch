+namespace
+{
+// SRNP_TRACE: counts of (address, racer), shown with the race frame.
+std::map<std::pair<std::uint32_t, int>, std::uint64_t> s_trace;
+
+void TraceReport()
+{
+  if (s_trace.empty())
+    return;
+  std::string line;
+  for (const auto& [key, count] : s_trace)
+  {
+    char item[48];
+    std::snprintf(item, sizeof(item), " %08X/r%d:%llu", key.first, key.second,
+                  static_cast<unsigned long long>(count));
+    line += item;
+  }
+  std::fprintf(stderr, "[srnp trace] frame %llu:%s\n", static_cast<unsigned long long>(s_frames),
+               line.c_str());
+}
+}  // namespace
+
+std::vector<std::uint32_t> TraceAddresses()
+{
+  std::vector<std::uint32_t> list;
+  const char* v = std::getenv("SRNP_TRACE");
+  for (const char* p = v; p && *p;)
+  {
+    char* end = nullptr;
+    const unsigned long address = std::strtoul(p, &end, 16);
+    if (end == p)
+      break;
+    list.push_back(static_cast<std::uint32_t>(address) & ~3u);
+    p = *end == ',' ? end + 1 : nullptr;
+  }
+  return list;
+}
+
+void TraceHook(CPUState* state)
+{
+  int racer = -1;
+  for (int r = 31; r >= 14 && racer < 0; --r)
+  {
+    const std::uint32_t v = state->gpr[r];
+    if (v >= kRacers && v < kRacers + 8 * kRacerSize && (v - kRacers) % kRacerSize == 0)
+      racer = static_cast<int>((v - kRacers) / kRacerSize);
+  }
+  if (s_trace[{state->pc, racer}]++ == 0)
+    std::fprintf(stderr, "[srnp trace] 0x%08X racer %d first at race frame %llu\n", state->pc, racer,
+                 static_cast<unsigned long long>(s_frames));
+}
