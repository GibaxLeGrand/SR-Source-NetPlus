+// Reads of a racer's index (+0x1029, lbz rD) by code that treats the racers below the player count
+// (0x8021B8C8) as "the player": on a 1P machine, racer 0. For this machine's seat to be the player
+// there, each read goes through three words of code in free low memory (right after the seats' pads;
+// 0x80002E00-0x80002FBC is the 5P-8P labels'): lbz, addi rD, rD, -seat, blr. The seat's racer then
+// reads 0 (player 0, view 0, pad 0) and the others read a number past the player count (unsigned).
+// Only presentation: none of these paths allocates or writes a racer; with all eleven of the game's
+// player tests forced to "not a player", a whole race kept the same positions (2026-11-25).
+// SRNP_JOUEUR=0 keeps only the minimap's.
+struct IndexRead
+{
+  std::uint32_t address, original;
+  bool game_logic;  // in race logic rather than the HUD
+};
+constexpr IndexRead kIndexReads[] = {
+    // The minimap (task 0x80414758): every racer's head, the player's blinking.
+    {0x80415C54, 0x89331029, false},  // lbz r9, 0x1029(r19)
+    // 0x80453300 (racer events): a sound for the player (0x80089120, 0xA9120100), and [0x80612D40],
+    // the frame of the last such sound (only read by the same "once a frame" sound code).
+    {0x8045390C, 0x88FF1029, true},  // lbz r7, 0x1029(r31)
+    // 0x805735EC: two bytes of the player's view camera (0x80601D28 + index x 0x25C: +0x24A, +0x24B).
+    {0x80574608, 0x889C1029, true},  // lbz r4, 0x1029(r28)
+    // Left as the game has them until understood: 0x80484A3C (0x804874FC: the player's task
+    // 0x80604784[index], state 5 to 4) and 0x8054E644 (0x8054E714, 0x8054E820: an effect drawn from the
+    // player's camera, then [0x80604428] + index x 0x30).
+};
+constexpr std::uint32_t kIndexCaves = 0x80002D80;  // 12 bytes each, up to 0x80002DC8
 int s_hud_seat = 0;
 
+void PatchIndexReads(int seat)
+{
+  static const bool logic_off = [] {
+    const char* v = std::getenv("SRNP_JOUEUR");
+    return v && *v == '0';
+  }();
+  auto& jit = Core::System::GetInstance().GetJitInterface();
+  for (std::size_t i = 0; i < std::size(kIndexReads); ++i)
+  {
+    const IndexRead& read = kIndexReads[i];
+    if (read.game_logic && logic_off)
+      continue;
+    std::uint8_t* p = Guest(read.address, 4);
+    const std::uint32_t cave = kIndexCaves + static_cast<std::uint32_t>(i) * 12u;
+    std::uint8_t* c = Guest(cave, 12);
+    const std::uint32_t call = 0x48000001u | ((cave - read.address) & 0x03FFFFFCu);  // bl cave
+    if (!p || !c || (Get32(p) != read.original && Get32(p) != call))
+    {
+      std::fprintf(stderr, "[srnp racers] index read 0x%08X holds %08X: left alone\n", read.address,
+                   p ? Get32(p) : 0u);
+      continue;
+    }
+    const std::uint32_t rd = (read.original >> 21) & 31u;
+    Put32(c, read.original);
+    Put32(c + 4, 0x38000000u | rd << 21 | rd << 16 |
+                     ((0u - static_cast<std::uint32_t>(seat)) & 0xFFFFu));  // addi rD, rD, -seat
+    Put32(c + 8, 0x4E800020u);                                              // blr
+    jit.InvalidateICache(cave, 12, true);
+    Put32(p, seat ? call : read.original);  // seat 0: the game's own lbz
+    jit.InvalidateICache(read.address, 4, true);
+  }
+}
