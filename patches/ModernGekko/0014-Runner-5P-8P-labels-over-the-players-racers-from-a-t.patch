new file mode 100644
index 0000000..c5577b7
--- /dev/null
+++ b/src/runtime/srnp_labels.hpp
@@ -0,0 +1,30 @@
+// SR-Source Net Plus: the "1P".."8P" labels above the players' racers in Sonic Riders (GXEE8P).
+// SPDX-License-Identifier: GPL-3.0-or-later
+//
+// The game draws "1P".."4P" above human racers 0..3 and "COM" above CPUs, from a 36x30 rectangle of
+// its HUD atlas ("Icon_Eff_E", 256x256 C8, in the GTSE file), picked in a table (REL data
+// 0x805D3DB4) by the racer's index; a human racer 4..7 would read other sprites. The atlas has no
+// room left for four more labels, so they come from a texture of our own: the srnp_etiquettes file
+// mod appends it to GTSE (the file decompressed, the block added, compressed again, no bigger than
+// the game's), after a 0x20-byte header "SRNPLBL1": a palette and 256x32 C8 texels (5P..8P).
+//
+// Two functions draw the labels: 0x8042F47C for the 1P HUD, 0x804297C8 for the split-screen HUD.
+// When the loaded GTSE carries that block, the runner patches both (display only; it writes no
+// racer and no game state):
+// - the rectangle is taken in a table of ours, by the racer's index and its CPU flag (+0xBD): the
+//   game's 1P..4P and COM, our 5P..8P;
+// - the label's quad is drawn by a small routine (in zero padding of the game's first code
+//   section: code in low memory hangs the game); for 5P..8P, it binds our texture
+//   (the game's own loader, 0x8007D1EC, given a texture entry of ours) around the game's quad
+//   function (0x800087CC), then binds the game's texture again (0x80053C54).
+// The table and the entry live in low memory the game leaves at zero (0x80002E00-0x80002F40).
+// Without the block (no mod, another language), the game's code is put back. SRNP_ETIQUETTES=0
+// leaves everything alone. The label left out (the player's own racer) is not changed here: the game's
+// (racer 0, or the viewport's), or the phase 2 runner's "spotter" (the seat's racer).
+#pragma once
+
+namespace srnp
+{
+// On the emulation thread, after each present.
+void LabelsOnFrame();
+}  // namespace srnp
