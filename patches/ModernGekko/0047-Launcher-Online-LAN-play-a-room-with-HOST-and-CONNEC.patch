+#pragma once
+
+// SR-Source Net Plus: Online/LAN play from the launcher (PLAY > ONLINE / LAN).
+// SPDX-License-Identifier: GPL-3.0-or-later
+//
+// HOST runs the relay inside the launcher (Relay: the lockstep of tools/srnp/relais.py, the same lines
+// for the runners, plus a room before the match); CONNECT joins the room of a host. Every launcher, the
+// host's too, is a client of that room (Client): its player gets a seat (P1 is the host), says ready;
+// the host sets the race (course, laps, racers, input delay) and starts it. Each launcher then starts
+// its game with the relay's address and its seat in the match, in the lobby through the game's own
+// menus (SRNP_LOBBY=2): every player chooses character and gear in the game's Player Entry and presses
+// Start, the waiting screen shows everyone, then the race runs in lockstep from the same start state.
+// When every game has closed, the room is back for the next race.
+//
+// Room lines (text, LF), on the relay's port, from a launcher:
+//   JOIN <protocol> <tag> <state> [<host key>]   first line; <state>: the start state's fingerprint
+//   LREADY <0|1>                                 ready or not (the host is always ready)
+//   LRULES <course> <laps> <racers> <delay>      the host's race
+//   LSTART                                       the host starts the match
+//   LGONE                                        this launcher's game has closed (or did not start)
+// to the launchers:
+//   WELCOME <seat> <host 0|1>  |  REFUSED <why>  (version, full, running)
+//   MEMBERS <seat>:<tag>:<ready>:<state>:<playing>,...   at every change
+//   LRULES <course> <laps> <racers> <delay>
+//   MATCH <seats> <seat> <delay>                 start the game: this seat of that many
+//   ROOM                                         every game has closed: the room again
+// A connection whose first line is HELLO is a runner's: from there on, relais.py's protocol (see its
+// docstring and srnp_relay.cpp), the race's rules being the room's (the runners' RULES are ignored).
+
+#include "netplay_address.hpp"
+
+#include <array>
+#include <cstdint>
+#include <filesystem>
+#include <memory>
+#include <optional>
+#include <string>
+#include <string_view>
+#include <utility>
+#include <vector>
+
+namespace moderngekko::frontend::online
+{
+inline constexpr const char* PROTOCOL = "SRNP-ONLINE-1";
+inline constexpr std::uint16_t DEFAULT_PORT = 7845;
+inline constexpr int MAX_PLAYERS = 8;
+inline constexpr int COURSES = 16;
+inline constexpr int MAX_LAPS = 9;
+inline constexpr int MAX_DELAY = 10;
+
+// The courses by the game's number (1-16), as the game's title cards name them (the runner's waiting
+// screen has the same list).
+inline constexpr std::array<const char*, 17> COURSE_NAMES = {
+    "",           "Metal City",     "Splash Canyon",     "Egg Factory",   "Green Cave",
+    "Sand Ruins", "Babylon Garden", "Digital Dimension", "SEGA Carnival", "Night Chase",
+    "Red Canyon", "Ice Factory",    "White Cave",        "Dark Desert",   "Sky Road",
+    "Babylon Guardian", "SEGA Illusion"};
+
+// The race the host sets: the course (1-16), laps (1-9), racers (the players to 8: the AI drives the
+// others) and the input delay in frames ("delay based": a press reaches every machine that many frames
+// later).
+struct Rules
+{
+  int course = 1;
+  int laps = 3;
+  int racers = 8;
+  int delay = 2;
+
+  bool operator==(const Rules&) const = default;
+};
+
+Rules Clamped(Rules rules);
+
+// A player in the room.
+struct Member
+{
+  int seat = -1;       // 0 = P1, the host
+  std::string tag;     // up to 8 of A-Z 0-9
+  bool ready = false;  // the host always is
+  std::string state;   // the start state's fingerprint, "-" without one
+  bool playing = false;  // its game is open (a match is on)
+};
+
+// What a launcher knows of the room, read each frame by the lobby.
+struct RoomView
+{
+  enum class Link
+  {
+    Connecting,
+    Joined,
+    Refused,  // the host said no: error says why
+    Lost,     // could not connect, or the connection closed: error says why
+  };
+  Link link = Link::Connecting;
+  std::string error;
+  int seat = -1;
+  bool host = false;
+  std::vector<Member> members;
+  Rules rules;
+  bool match = false;  // a match is on
+};
+
+// MATCH: this launcher starts its game, as that seat of that many.
+struct MatchStart
+{
+  int seats = 1;
+  int seat = 0;
+  int delay = 2;
+};
+
+// The host's relay, on its own thread: the room, then the lockstep of the match.
+class Relay
+{
+public:
+  Relay();
+  ~Relay();
+  Relay(const Relay&) = delete;
+  Relay& operator=(const Relay&) = delete;
+
+  // Listens on every IPv4 address of this computer. The journal says who came, the rules, the
+  // frames closed and the checksums ("identical" or "DIVERGENCE"). False, with why, when the port
+  // can't be had.
+  bool Start(std::uint16_t port, const std::filesystem::path& journal, std::string* error);
+  // The key the host's own launcher joins with, to be P1.
+  const std::string& HostKey() const;
+
+private:
+  struct Impl;
+  std::unique_ptr<Impl> m_impl;
+};
+
+// A launcher in a room, on its own thread.
+class Client
+{
+public:
+  Client(std::string host, std::uint16_t port, std::string tag, std::string state,
+         std::string host_key = {});
+  ~Client();
+  Client(const Client&) = delete;
+  Client& operator=(const Client&) = delete;
+
+  RoomView View() const;
+  // The match to start, once.
+  std::optional<MatchStart> TakeMatch();
+  void SetReady(bool ready);
+  void SetRules(const Rules& rules);
+  void StartMatch();
+  void GameClosed();
+  const std::string& Host() const;
+  std::uint16_t Port() const;
+
+private:
+  struct Impl;
+  std::unique_ptr<Impl> m_impl;
+};
+
+// Up to 8 characters, A-Z and 0-9, upper case (the runner's tag).
+std::string CleanTag(std::string_view text);
+// FNV-1a 64 of the file, 16 hex digits; "-" when it can't be read.
+std::string Fingerprint(const std::filesystem::path& file);
+
+// This computer's IPv4 addresses that others may reach, with the kind of network each is on (home
+// first), as "ip:port".
+std::vector<std::pair<AddressKind, std::string>> ThisComputersAddresses(std::uint16_t port);
+
+// The choices of Online/LAN play, in <user folder>/online.ini.
+struct Settings
+{
+  std::string tag;
+  std::string address = "127.0.0.1";
+  std::uint16_t port = DEFAULT_PORT;
+  std::filesystem::path start_state;
+  Rules rules;
+};
+Settings LoadSettings(const std::filesystem::path& user_directory, std::string_view nickname);
+bool SaveSettings(const std::filesystem::path& user_directory, const Settings& settings);
+
+// The game's own user folder for online play, <user folder>/Online, made again before each match
+// from the player's: Dolphin.ini and config.ini as theirs, with the online changes (the pad on port 4,
+// which the game does not see, read by the runner and sent to the relay; port 1 a keyboard with no
+// key, so that only the relay's presses reach the game), the textures of their Load folder, and
+// the labels mod (srnp_etiquettes) on when one of `mod_folders` has it. Empty, with why, on failure.
+std::filesystem::path PrepareGameFolder(const std::filesystem::path& user_directory,
+                                        std::string_view keyboard_device,
+                                        const std::vector<std::filesystem::path>& mod_folders,
+                                        std::string* error);
+
+// The runner's environment for the match (SRNP_*): set ones replace the launcher's, kept ones only
+// when the launcher's environment has none (tests set their own).
+struct RunnerEnvironment
+{
+  std::vector<std::pair<std::string, std::string>> set;
+  std::vector<std::pair<std::string, std::string>> kept;
+};
+RunnerEnvironment MatchEnvironment(const MatchStart& match, const std::string& relay_address,
+                                   const std::string& tag);
+}  // namespace moderngekko::frontend::online
