+namespace moderngekko::frontend::ui
+{
+// What the Online/LAN play window shows and edits.
+struct OnlineDialog
+{
+  bool hosting = true;
+  std::array<char, 16> tag{};
+  std::array<char, 256> address{};
+  int port = online::DEFAULT_PORT;
+  std::array<char, 1024> start_state{};
+  bool show_address = false;
+};
+
+enum class OnlineChoice
+{
+  None,
+  Host,
+  Connect,
+  Cancel,
+};
+
+inline void OnlineDialogFrom(OnlineDialog& dialog, const online::Settings& settings)
+{
+  std::snprintf(dialog.tag.data(), dialog.tag.size(), "%s", settings.tag.c_str());
+  std::snprintf(dialog.address.data(), dialog.address.size(), "%s", settings.address.c_str());
+  dialog.port = settings.port;
+  std::snprintf(dialog.start_state.data(), dialog.start_state.size(), "%s",
+                text::PathText(settings.start_state).c_str());
+}
+
+inline void OnlineDialogTo(const OnlineDialog& dialog, online::Settings& settings)
+{
+  settings.tag = online::CleanTag(dialog.tag.data());
+  settings.address = dialog.address.data();
+  settings.port = static_cast<std::uint16_t>(std::clamp(dialog.port, 1, 65535));
+  settings.start_state = text::TextPath(dialog.start_state.data());
+}
+
+// The "Online/LAN play" window (a modal popup the caller opened as "Online/LAN play##online"):
+// HOST or CONNECT, the player's tag, the host's address (CONNECT), the TCP port, and the start state
+// (the game state every match starts from: the same file for everyone). `savestates`: the user's,
+// offered in a list. `firewall` (Windows): the host can let the launcher through.
+inline OnlineChoice DrawOnlineDialog(OnlineDialog& dialog, std::span<const fs::path> savestates,
+                                     FirewallRule& firewall, const fs::path& launcher, ImFont* bold,
+                                     float scale, bool cancel)
+{
+  OnlineChoice choice = OnlineChoice::None;
+  ImGui::SetNextWindowPos(ImGui::GetMainViewport()->GetCenter(), ImGuiCond_Always, ImVec2(0.5f, 0.5f));
+  ImGui::SetNextWindowSize(ImVec2(600 * scale, 0.0f));
+  if (!ImGui::BeginPopupModal("Online/LAN play##online", nullptr, ImGuiWindowFlags_NoResize))
+    return choice;
+  ImGui::PushFont(bold, 0.0f);
+  ImGui::TextUnformatted(Tr("Online / LAN play"));
+  ImGui::PopFont();
+  ImGui::Spacing();
+  const float half = (ImGui::GetContentRegionAvail().x - ImGui::GetStyle().ItemSpacing.x) * 0.5f;
+  if (DrawChoiceButton(Tr("HOST"), dialog.hosting, ImVec2(half, 34 * scale), bold, scale))
+    dialog.hosting = true;
+  ImGui::SameLine();
+  if (DrawChoiceButton(Tr("CONNECT"), !dialog.hosting, ImVec2(half, 34 * scale), bold, scale))
+    dialog.hosting = false;
+  ImGui::Spacing();
+  ImGui::PushTextWrapPos(0.0f);
+  ImGui::TextDisabled("%s", dialog.hosting
+                                ? Tr("Up to 8 players, one per computer. Your friends connect to this "
+                                     "computer's address; you set the race and start it.")
+                                : Tr("Type the address the host gives you (its TCP port after a colon)."));
+  ImGui::TextDisabled("%s", Tr("Everyone chooses a character and a gear in the game's Player Entry, "
+                               "then the race starts for everyone at once."));
+  ImGui::PopTextWrapPos();
+  ImGui::Spacing();
+
+  float label_width = 0.0f;
+  for (const char* label : {Tr("Player tag"), Tr("Host address"), Tr("TCP port"), Tr("Start state")})
+    label_width = std::max(label_width, ImGui::CalcTextSize(label).x);
+  label_width += ImGui::GetStyle().ItemInnerSpacing.x;
+
+  ImGui::SetNextItemWidth(160 * scale);
+  ImGui::InputText(Tr("Player tag"), dialog.tag.data(), 9, ImGuiInputTextFlags_CharsUppercase |
+                                                              ImGuiInputTextFlags_CharsNoBlank);
+  ImGui::SameLine();
+  ImGui::TextDisabled("%s", Tr("(3 to 8 letters or digits)"));
+  if (!dialog.hosting)
+  {
+    // Hidden until Show, as the Netplay window does: an address identifies a connection.
+    const char* toggle = dialog.show_address ? Tr("Hide") : Tr("Show");
+    const float toggle_width =
+        ImGui::CalcTextSize(toggle).x + ImGui::GetStyle().FramePadding.x * 2.0f;
+    ImGui::SetNextItemWidth(-label_width - toggle_width - ImGui::GetStyle().ItemSpacing.x);
+    ImGui::InputText("##online_address", dialog.address.data(), dialog.address.size(),
+                     dialog.show_address ? 0 : ImGuiInputTextFlags_Password);
+    ImGui::SameLine();
+    if (ImGui::Button(toggle))
+      dialog.show_address = !dialog.show_address;
+    ImGui::SameLine();
+    ImGui::TextUnformatted(Tr("Host address"));
+  }
+  else
+  {
+    ImGui::SetNextItemWidth(150 * scale);
+    ImGui::InputInt(Tr("TCP port"), &dialog.port);
+    dialog.port = std::clamp(dialog.port, 1, 65535);
+  }
+
+  // The start state: one of the user's savestates, or any file.
+  ImGui::SetNextItemWidth(-label_width);
+  const std::string chosen = text::PathText(text::TextPath(dialog.start_state.data()).filename());
+  if (ImGui::BeginCombo(Tr("Start state"), chosen.empty() ? Tr("(none)") : chosen.c_str()))
+  {
+    for (const fs::path& state : savestates)
+    {
+      const std::string name = text::PathText(state.filename());
+      const bool selected = text::PathText(state) == dialog.start_state.data();
+      if (ImGui::Selectable(name.c_str(), selected))
+        std::snprintf(dialog.start_state.data(), dialog.start_state.size(), "%s",
+                      text::PathText(state).c_str());
+    }
+    if (savestates.empty())
+      ImGui::TextDisabled("%s", Tr("No savestate in StateSaves: type the file's path below."));
+    ImGui::EndCombo();
+  }
+  ImGui::SetNextItemWidth(-label_width);
+  ImGui::InputText("##online_state_path", dialog.start_state.data(), dialog.start_state.size());
+  ImGui::PushTextWrapPos(0.0f);
+  std::error_code ec;
+  const bool state_there =
+      dialog.start_state[0] != '\0' && fs::is_regular_file(text::TextPath(dialog.start_state.data()), ec);
+  if (!state_there)
+    ImGui::TextColored(LOBBY_AMBER, "%s",
+                       Tr("A match starts from a savestate made on Player Entry. Every player needs "
+                          "the same file."));
+  else
+    ImGui::TextDisabled("%s", Tr("Every player needs this same file: the lobby checks it."));
+  ImGui::PopTextWrapPos();
+
+  // Delay based now; rollback later.
+  ImGui::Spacing();
+  ImGui::TextDisabled("%s", Tr("NETCODE"));
+  DrawChoiceButton(Tr("DELAY BASED"), true, ImVec2(half, 30 * scale), bold, scale);
+  ImGui::SameLine();
+  ImGui::BeginDisabled();
+  DrawChoiceButton(Tr("ROLLBACK (LATER)"), false, ImVec2(half, 30 * scale), bold, scale);
+  ImGui::EndDisabled();
+
+#if defined(_WIN32)
+  if (dialog.hosting)
+  {
+    const FirewallResult result = firewall.Result();
+    ImGui::Spacing();
+    ImGui::PushTextWrapPos(0.0f);
+    ImGui::TextDisabled("%s", Tr("If your friends can't connect, the Windows firewall may be "
+                                 "blocking the launcher. Windows asks for permission to change it."));
+    ImGui::BeginDisabled(result == FirewallResult::Working);
+    ImGui::PushStyleColor(ImGuiCol_Text, LAUNCHER_ACCENT);
+    const bool allow = ImGui::Button(Tr("Allow the launcher in the Windows firewall"));
+    ImGui::PopStyleColor();
+    ImGui::EndDisabled();
+    if (allow)
+      firewall.Allow(launcher, "SR-Source Net Plus Online");
+    if (result == FirewallResult::Allowed)
+      ImGui::TextColored(LAUNCHER_ACCENT, "%s", Tr("Done: Windows lets online players in."));
+    else if (result == FirewallResult::Declined || result == FirewallResult::Failed)
+      ImGui::TextColored(LOBBY_AMBER, "%s", Tr("Windows did not change its firewall."));
+    ImGui::PopTextWrapPos();
+  }
+#else
+  (void)firewall;
+  (void)launcher;
+#endif
+
+  const std::string tag = online::CleanTag(dialog.tag.data());
+  const bool address_missing = !dialog.hosting && dialog.address[0] == '\0';
+  const bool can_go = tag.size() >= 3 && state_there && !address_missing;
+  ImGui::Spacing();
+  ImGui::Separator();
+  ImGui::Spacing();
+  ImGui::BeginDisabled(!can_go);
+  if (DrawLobbyButton(dialog.hosting ? Tr("HOST") : Tr("CONNECT"), ImVec2(half, 38 * scale),
+                      LobbyButtonLook::Primary, bold))
+    choice = dialog.hosting ? OnlineChoice::Host : OnlineChoice::Connect;
+  ImGui::EndDisabled();
+  ImGui::SameLine();
+  if (ImGui::Button(Tr("Cancel"), ImVec2(half, 38 * scale)) || cancel)
+    choice = OnlineChoice::Cancel;
+  if (choice != OnlineChoice::None)
+    ImGui::CloseCurrentPopup();
+  ImGui::EndPopup();
+  return choice;
+}
+
+// What the room shows besides the room itself.
+struct OnlineLobbyInfo
+{
+  bool hosting = false;
+  std::string host_address;  // the address this launcher connected to
+  std::vector<std::pair<AddressKind, std::string>> addresses;  // the host's, for its friends
+  std::string own_state;     // this player's start state fingerprint
+  std::string state_name;    // its file name
+  std::string status;        // the last thing that happened (a game that did not start...)
+};
+
+struct OnlineLobbyActions
+{
+  bool leave = false;
+  bool toggle_ready = false;
+  bool start = false;
+  bool rules_changed = false;
+};
+
+// The room, filling the launcher's window (a modal popup the caller opened as "##online_lobby").
+// `rules`: the host edits them here (rules_changed says when); the others see the room's.
+inline OnlineLobbyActions DrawOnlineLobby(const online::RoomView& room, const OnlineLobbyInfo& info,
+                                          online::Rules& rules, LobbyState& state, ImFont* bold,
+                                          float scale)
+{
+  OnlineLobbyActions actions;
+  const ImGuiViewport* viewport = ImGui::GetMainViewport();
+  ImGui::SetNextWindowPos(viewport->WorkPos);
+  ImGui::SetNextWindowSize(viewport->WorkSize);
+  ImGui::PushStyleColor(ImGuiCol_ModalWindowDimBg, ImVec4(0.0f, 0.0f, 0.0f, 0.55f));
+  const bool open = ImGui::BeginPopupModal(
+      "##online_lobby", nullptr,
+      ImGuiWindowFlags_NoDecoration | ImGuiWindowFlags_NoMove | ImGuiWindowFlags_NoSavedSettings);
+  ImGui::PopStyleColor();
+  if (!open)
+    return actions;
+  const ImGuiStyle& style = ImGui::GetStyle();
+  // The card in the middle, not wider than it needs.
+  const float width = std::min(ImGui::GetContentRegionAvail().x, 860.0f * scale);
+  ImGui::SetCursorPosX(ImGui::GetCursorPosX() + (ImGui::GetContentRegionAvail().x - width) * 0.5f);
+  ImGui::PushStyleColor(ImGuiCol_ChildBg, ImVec4(0.067f, 0.067f, 0.075f, 0.92f));
+  ImGui::PushStyleVar(ImGuiStyleVar_WindowPadding, ImVec2(22.0f * scale, 16.0f * scale));
+  ImGui::PushStyleVar(ImGuiStyleVar_ChildRounding, 14.0f * scale);
+  ImGui::BeginChild("##online_card", ImVec2(width, ImGui::GetContentRegionAvail().y),
+                    ImGuiChildFlags_NavFlattened | ImGuiChildFlags_AlwaysUseWindowPadding);
+  ImGui::PopStyleVar(2);
+  ImGui::PopStyleColor();
+
+  // Title line: what this is, this computer's part, the netcode.
+  ImGui::PushFont(bold, style.FontSizeBase * 1.5f);
+  ImGui::AlignTextToFramePadding();
+  ImGui::TextUnformatted(Tr("ONLINE / LAN"));
+  ImGui::PopFont();
+  ImGui::SameLine(0.0f, 14.0f * scale);
+  DrawStatusPill(info.hosting ? Tr("HOST") : Tr("CONNECTED"), LAUNCHER_ACCENT, scale, false);
+  ImGui::SameLine();
+  DrawStatusPill(Tr("DELAY BASED"), LOBBY_FREE_SEAT, scale, false);
+  ImGui::PushTextWrapPos(0.0f);
+  ImGui::TextDisabled("%s", Format(Tr("Input delay: %d frames  \xC2\xB7  start state: %s"),
+                                   room.rules.delay, info.state_name.c_str())
+                                .c_str());
+  ImGui::PopTextWrapPos();
+  ImGui::Spacing();
+
+  using Link = online::RoomView::Link;
+  if (room.link != Link::Joined)
+  {
+    BeginSection("##online_link", info.hosting ? Tr("OPENING THE ROOM") : Tr("HOST"));
+    ImGui::PushTextWrapPos(0.0f);
+    if (room.link == Link::Connecting)
+    {
+      ImGui::TextUnformatted(Format(Tr("Connecting to %s..."), info.host_address.c_str()).c_str());
+    }
+    else
+    {
+      std::string why = room.error;
+      if (why == "version")
+        why = Tr("the host runs another version of SR-Source Net Plus");
+      else if (why == "full")
+        why = Tr("the room is full (8 players)");
+      else if (why == "running")
+        why = Tr("a race is on: try again when it is over");
+      else if (why == "no answer" || why == "unknown address")
+        why = Tr("nobody answered at this address. Check the address and the port, and that the "
+                 "host's firewall lets the launcher in");
+      ImGui::TextColored(LOBBY_RED, "%s",
+                         Format(Tr("Could not join %s: %s."), info.host_address.c_str(), why.c_str())
+                             .c_str());
+    }
+    ImGui::PopTextWrapPos();
+    EndSection();
+    if (DrawLobbyButton(Tr("BACK"), ImVec2(-1.0f, 42.0f * scale), LobbyButtonLook::Plain, bold))
+      actions.leave = true;
+    ImGui::EndChild();
+    if (actions.leave)
+      ImGui::CloseCurrentPopup();
+    ImGui::EndPopup();
+    return actions;
+  }
+
+  // Two columns: the players on the left; where friends connect and the race on the right.
+  const bool columns = BeginPageColumns("##online_columns", 0.48f);
+
+  // The players, P1 to P8.
+  const online::Member* host_member = nullptr;
+  for (const online::Member& member : room.members)
+    host_member = member.seat == 0 ? &member : host_member;
+  const std::string host_state = host_member ? host_member->state : info.own_state;
+  BeginSection("##online_players",
+               Format(Tr("PLAYERS  \xC2\xB7  %d / 8"), static_cast<int>(room.members.size())).c_str());
+  if (ImGui::BeginTable("##online_players_table", 3, ImGuiTableFlags_None))
+  {
+    ImGui::TableSetupColumn("seat", ImGuiTableColumnFlags_WidthFixed);
+    ImGui::TableSetupColumn("tag", ImGuiTableColumnFlags_WidthStretch);
+    ImGui::TableSetupColumn("state", ImGuiTableColumnFlags_WidthFixed);
+    const float text_offset = 3.0f * scale;
+    for (int seat = 0; seat < online::MAX_PLAYERS; ++seat)
+    {
+      const online::Member* member = nullptr;
+      for (const online::Member& m : room.members)
+        member = m.seat == seat ? &m : member;
+      ImGui::PushID(seat);
+      ImGui::TableNextRow(ImGuiTableRowFlags_None, ImGui::GetFrameHeight());
+      ImGui::TableNextColumn();
+      DrawStatusPill(Format("P%d", seat + 1).c_str(), member ? LAUNCHER_ACCENT : LOBBY_FREE_SEAT, scale,
+                     false);
+      ImGui::TableNextColumn();
+      ImGui::SetCursorPosY(ImGui::GetCursorPosY() + text_offset);
+      if (!member)
+      {
+        ImGui::TextDisabled("%s", Tr("Free"));
+      }
+      else
+      {
+        ImGui::PushFont(bold, 0.0f);
+        ImGui::TextUnformatted(member->tag.empty() ? "-" : member->tag.c_str());
+        ImGui::PopFont();
+        const char* tag = seat == room.seat ? Tr("(you)") : seat == 0 ? Tr("(host)") : nullptr;
+        if (tag)
+        {
+          ImGui::SameLine();
+          ImGui::TextDisabled("%s", tag);
+        }
+      }
+      ImGui::TableNextColumn();
+      if (member)
+      {
+        if (member->state != host_state)
+          DrawStatusPill(Tr("OTHER START STATE"), LOBBY_RED, scale, false);
+        else if (member->playing)
+          DrawStatusPill(Tr("RACING"), LAUNCHER_ACCENT, scale, false);
+        else if (seat == 0)
+          DrawStatusPill(Tr("HOST"), LAUNCHER_ACCENT, scale, false);
+        else
+          DrawStatusPill(member->ready ? Tr("READY") : Tr("NOT READY"),
+                         member->ready ? LAUNCHER_ACCENT : LOBBY_AMBER, scale, false);
+      }
+      ImGui::PopID();
+    }
+    ImGui::EndTable();
+  }
+  ImGui::PushTextWrapPos(0.0f);
+  ImGui::TextDisabled("%s", Tr("A free place is the AI's when the host sets more racers than players."));
+  ImGui::PopTextWrapPos();
+  EndSection();
+
+  if (columns)
+    NextPageColumn();
+  // Where friends connect.
+  if (info.hosting)
+  {
+    BeginSection("##online_invite", Tr("INVITE YOUR FRIENDS"));
+    if (!info.addresses.empty())
+      DrawShowAddressesSwitch(state);
+    float label_width = 0.0f;
+    for (const auto& [kind, address] : info.addresses)
+      label_width = std::max(label_width, ImGui::CalcTextSize(LobbyAddressLabel(kind)).x);
+    label_width += 24.0f * scale;
+    for (const auto& [kind, address] : info.addresses)
+      DrawAddressRow(LobbyAddressLabel(kind), address, label_width, state);
+    ImGui::PushTextWrapPos(0.0f);
+    ImGui::TextDisabled("%s", info.addresses.empty()
+                                  ? Tr("No network found. Connect this computer to your network or "
+                                       "to Tailscale.")
+                                  : Tr("Your friends choose ONLINE / LAN, then CONNECT, and type this "
+                                       "address. Over the internet: Tailscale, or this TCP port opened "
+                                       "on your router."));
+    ImGui::PopTextWrapPos();
+    EndSection();
+  }
+  else
+  {
+    BeginSection("##online_host", Tr("HOST"));
+    DrawShowAddressesSwitch(state);
+    ImGui::TextUnformatted(LobbyShownAddress(state, info.host_address).c_str());
+    EndSection();
+  }
+
+  // The race: the host sets it, the others see it.
+  const int players = std::max(1, static_cast<int>(room.members.size()));
+  BeginSection("##online_race", Tr("THE RACE"));
+  if (info.hosting && !room.match)
+  {
+    const float field = std::min(320.0f * scale, ImGui::GetContentRegionAvail().x * 0.5f);
+    online::Rules edited = rules;
+    ImGui::SetNextItemWidth(field);
+    if (ImGui::BeginCombo(Tr("Course"), online::COURSE_NAMES[static_cast<std::size_t>(edited.course)]))
+    {
+      for (int course = 1; course <= online::COURSES; ++course)
+      {
+        const bool selected = course == edited.course;
+        if (ImGui::Selectable(online::COURSE_NAMES[static_cast<std::size_t>(course)], selected))
+          edited.course = course;
+        if (selected)
+          ImGui::SetItemDefaultFocus();
+      }
+      ImGui::EndCombo();
+    }
+    ImGui::SetNextItemWidth(field);
+    ImGui::SliderInt(Tr("Laps"), &edited.laps, 1, online::MAX_LAPS);
+    ImGui::SetNextItemWidth(field);
+    edited.racers = std::max(edited.racers, players);
+    ImGui::SliderInt(Tr("Racers"), &edited.racers, players, online::MAX_PLAYERS);
+    ImGui::SameLine();
+    ImGui::TextDisabled("%s", edited.racers > players
+                                  ? Format(Tr("(the AI drives %d)"), edited.racers - players).c_str()
+                                  : Tr("(no AI)"));
+    ImGui::SetNextItemWidth(field);
+    ImGui::SliderInt(Tr("Input delay (frames)"), &edited.delay, 0, online::MAX_DELAY);
+    edited = online::Clamped(edited);
+    if (edited != rules)
+    {
+      rules = edited;
+      actions.rules_changed = true;
+    }
+  }
+  else
+  {
+    const online::Rules& r = room.rules;
+    const int ai = std::max(0, r.racers - players);
+    ImGui::TextUnformatted(online::COURSE_NAMES[static_cast<std::size_t>(r.course)]);
+    ImGui::SameLine();
+    ImGui::TextDisabled("%s", Format(Tr("\xC2\xB7  %d lap(s)  \xC2\xB7  %d racers%s"), r.laps,
+                                     std::max(r.racers, players),
+                                     ai ? Format(Tr(" (the AI drives %d)"), ai).c_str() : "")
+                                  .c_str());
+  }
+  ImGui::PushTextWrapPos(0.0f);
+  ImGui::TextDisabled("%s", Tr("Once the host starts: choose your character and gear in the game's "
+                               "Player Entry and press Start. The race begins when everyone has."));
+  ImGui::PopTextWrapPos();
+  EndSection();
+  if (columns)
+    EndPageColumns();
+
+  // Bottom: Ready or Start, and Leave.
+  const bool everyone_ready = std::ranges::all_of(room.members, [&](const online::Member& m) {
+    return (m.ready || m.seat == 0) && m.state == host_state;
+  });
+  const float buttons_height = 46.0f * scale;
+  std::string note = info.status;
+  const char* missing = nullptr;
+  if (room.match)
+    missing = Tr("A race is on.");
+  else if (info.hosting && !everyone_ready)
+    missing = Tr("Everyone must be ready, with the same start state, before the race can start.");
+  else if (!info.hosting)
+    missing = Tr("Press I'M READY, then wait for the host to start.");
+  if (missing)
+    note += (note.empty() ? "" : "  \xC2\xB7  ") + std::string(missing);
+  const float note_height =
+      ImGui::CalcTextSize(note.c_str(), nullptr, false, ImGui::GetContentRegionAvail().x).y;
+  ImGui::SetCursorPosY(std::max(ImGui::GetCursorPosY(), ImGui::GetWindowHeight() - 16.0f * scale -
+                                                            buttons_height - style.ItemSpacing.y -
+                                                            note_height));
+  const float third = (ImGui::GetContentRegionAvail().x - style.ItemSpacing.x) / 3.0f;
+  const online::Member* me = nullptr;
+  for (const online::Member& m : room.members)
+    me = m.seat == room.seat ? &m : me;
+  if (info.hosting)
+  {
+    ImGui::BeginDisabled(!everyone_ready || room.match);
+    if (DrawLobbyButton(Tr("START THE RACE"), ImVec2(third * 2.0f, buttons_height),
+                        everyone_ready && !room.match ? LobbyButtonLook::Primary : LobbyButtonLook::Plain,
+                        bold))
+      actions.start = true;
+    ImGui::EndDisabled();
+  }
+  else
+  {
+    const bool ready = me && me->ready;
+    ImGui::BeginDisabled(room.match);
+    if (DrawLobbyButton(ready ? Tr("READY  \xC2\xB7  CANCEL") : Tr("I'M READY"),
+                        ImVec2(third * 2.0f, buttons_height),
+                        ready ? LobbyButtonLook::Ready : LobbyButtonLook::Primary, bold))
+      actions.toggle_ready = true;
+    ImGui::EndDisabled();
+  }
+  ImGui::SameLine();
+  if (DrawLobbyButton(info.hosting ? Tr("CLOSE THE ROOM") : Tr("LEAVE"), ImVec2(-1.0f, buttons_height),
+                      LobbyButtonLook::Plain, bold))
+    actions.leave = true;
+  ImGui::PushTextWrapPos(0.0f);
+  if (!note.empty())
+    ImGui::TextDisabled("%s", note.c_str());
+  ImGui::PopTextWrapPos();
+
+  ImGui::EndChild();
+  if (actions.leave)
+    ImGui::CloseCurrentPopup();
+  ImGui::EndPopup();
+  return actions;
+}
