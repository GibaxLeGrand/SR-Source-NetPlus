+// ---------------------------------------------------------------------------------------------------
+// Settings, the game's folder, the runner's environment
+
+namespace
+{
+std::string ReadText(const fs::path& file)
+{
+  std::ifstream stream(file, std::ios::binary);
+  std::stringstream text;
+  text << stream.rdbuf();
+  return text.str();
+}
+
+bool WriteText(const fs::path& file, const std::string& text)
+{
+  std::ofstream stream(file, std::ios::binary | std::ios::trunc);
+  stream << text;
+  return static_cast<bool>(stream);
+}
+
+std::vector<std::string> Lines(const std::string& text)
+{
+  std::vector<std::string> lines;
+  std::stringstream stream(text);
+  std::string line;
+  while (std::getline(stream, line))
+  {
+    if (!line.empty() && line.back() == '\r')
+      line.pop_back();
+    lines.push_back(line);
+  }
+  return lines;
+}
+
+std::string Trimmed(std::string_view text)
+{
+  const std::size_t first = text.find_first_not_of(" \t");
+  if (first == std::string_view::npos)
+    return {};
+  const std::size_t last = text.find_last_not_of(" \t");
+  return std::string(text.substr(first, last - first + 1));
+}
+
+// Sets `key = value` in [section] of an INI text (Dolphin's style), adding the section or the key.
+void SetIni(std::vector<std::string>& lines, std::string_view section, std::string_view key,
+            std::string_view value)
+{
+  const std::string header = "[" + std::string(section) + "]";
+  std::size_t start = lines.size();
+  for (std::size_t i = 0; i < lines.size(); ++i)
+  {
+    if (Trimmed(lines[i]) == header)
+    {
+      start = i;
+      break;
+    }
+  }
+  const std::string entry = std::string(key) + " = " + std::string(value);
+  if (start == lines.size())
+  {
+    lines.push_back(header);
+    lines.push_back(entry);
+    return;
+  }
+  std::size_t i = start + 1;
+  for (; i < lines.size() && !Trimmed(lines[i]).starts_with("["); ++i)
+  {
+    const std::string line = Trimmed(lines[i]);
+    const std::size_t equals = line.find('=');
+    if (equals != std::string::npos && Trimmed(std::string_view(line).substr(0, equals)) == key)
+    {
+      lines[i] = entry;
+      return;
+    }
+  }
+  lines.insert(lines.begin() + static_cast<std::ptrdiff_t>(i), entry);
+}
+
+// The lines of [section], without its header.
+std::vector<std::string> IniSection(const std::vector<std::string>& lines, std::string_view section)
+{
+  const std::string header = "[" + std::string(section) + "]";
+  std::vector<std::string> body;
+  bool inside = false;
+  for (const std::string& line : lines)
+  {
+    const std::string trimmed = Trimmed(line);
+    if (trimmed.starts_with("["))
+    {
+      if (inside)
+        break;
+      inside = trimmed == header;
+      continue;
+    }
+    if (inside && !trimmed.empty())
+      body.push_back(line);
+  }
+  return body;
+}
+
+std::string Joined(const std::vector<std::string>& lines)
+{
+  std::string text;
+  for (const std::string& line : lines)
+    text += line + "\n";
+  return text;
+}
+
+std::string PathUtf8(const fs::path& path)
+{
+  const std::u8string text = path.u8string();
+  return std::string(text.begin(), text.end());
+}
+
+fs::path Utf8Path(const std::string& text)
+{
+  return fs::path(std::u8string(text.begin(), text.end()));
+}
+}  // namespace
+
+Settings LoadSettings(const fs::path& user_directory, std::string_view nickname)
+{
+  Settings settings;
+  settings.tag = CleanTag(nickname);
+  for (const std::string& line : Lines(ReadText(user_directory / "online.ini")))
+  {
+    const std::size_t equals = line.find('=');
+    if (equals == std::string::npos || line.starts_with("#"))
+      continue;
+    const std::string key = Trimmed(std::string_view(line).substr(0, equals));
+    const std::string value = Trimmed(std::string_view(line).substr(equals + 1));
+    const int number = std::atoi(value.c_str());
+    if (key == "tag")
+      settings.tag = CleanTag(value);
+    else if (key == "address")
+      settings.address = value;
+    else if (key == "port" && number >= 1 && number <= 65535)
+      settings.port = static_cast<std::uint16_t>(number);
+    else if (key == "start_state")
+      settings.start_state = Utf8Path(value);
+    else if (key == "course")
+      settings.rules.course = number;
+    else if (key == "laps")
+      settings.rules.laps = number;
+    else if (key == "racers")
+      settings.rules.racers = number;
+    else if (key == "delay")
+      settings.rules.delay = number;
+  }
+  settings.rules = Clamped(settings.rules);
+  return settings;
+}
+
+bool SaveSettings(const fs::path& user_directory, const Settings& settings)
+{
+  std::error_code ignored;
+  fs::create_directories(user_directory, ignored);
+  std::string text = "# Online/LAN play (SR-Source Net Plus)\n";
+  text += "tag=" + settings.tag + "\n";
+  text += "address=" + settings.address + "\n";
+  text += "port=" + std::to_string(settings.port) + "\n";
+  text += "# The game state every match starts from (Player Entry): every player needs the same file\n";
+  text += "start_state=" + PathUtf8(settings.start_state) + "\n";
+  text += "course=" + std::to_string(settings.rules.course) + "\n";
+  text += "laps=" + std::to_string(settings.rules.laps) + "\n";
+  text += "racers=" + std::to_string(settings.rules.racers) + "\n";
+  text += "delay=" + std::to_string(settings.rules.delay) + "\n";
+  return WriteText(user_directory / "online.ini", text);
+}
+
+fs::path PrepareGameFolder(const fs::path& user_directory, std::string_view keyboard_device,
+                           const std::vector<fs::path>& mod_folders, std::string* error)
+{
+  const fs::path folder = user_directory / "Online";
+  std::error_code ec;
+  fs::create_directories(folder / "Config", ec);
+  fs::create_directories(folder / "Logs", ec);
+  if (ec)
+  {
+    if (error)
+      *error = "can't make " + PathUtf8(folder) + ": " + ec.message();
+    return {};
+  }
+  // Dolphin.ini: the player's, with the online changes.
+  std::vector<std::string> dolphin = Lines(ReadText(user_directory / "Config" / "Dolphin.ini"));
+  SetIni(dolphin, "Core", "SIDevice1", "0");  // ports 2-4: no controller in the game
+  SetIni(dolphin, "Core", "SIDevice2", "0");
+  SetIni(dolphin, "Core", "SIDevice3", "0");
+  SetIni(dolphin, "Core", "EmulationSpeed", "1.0");
+  // Background input stays the player's choice (off by default), as in the test scripts' runs: on, a
+  // pad also opened the menu of a game in the background (two games on one computer, 2026-11-25).
+  // SRNP_ONLINE_BACKGROUND=0|1 (tests) sets it.
+  if (const char* background = std::getenv("SRNP_ONLINE_BACKGROUND"); background && *background)
+    SetIni(dolphin, "Input", "BackgroundInput", *background == '1' ? "True" : "False");
+  SetIni(dolphin, "Interface", "UsePanicHandlers", "False");
+  if (fs::is_directory(user_directory / "Load", ec))
+    SetIni(dolphin, "General", "LoadPath", PathUtf8(user_directory / "Load") + "/");
+  // GCPadNew.ini: port 1 a keyboard with no key (a device, so that the relay's presses reach the
+  // menus, but nothing of its own); port 4 the player's controller as they set it up, read by the
+  // runner (SRNP_INPUT=manette) and sent to the relay.
+  const std::vector<std::string> pads = Lines(ReadText(user_directory / "Config" / "GCPadNew.ini"));
+  std::vector<std::string> own = IniSection(pads, "GCPad1");
+  std::string profile = "[GCPad1]\nDevice = " + std::string(keyboard_device) +
+                        "\nOptions/Always Connected = True\n[GCPad4]\n";
+  if (own.empty())
+    profile += "Device = " + std::string(keyboard_device) + "\n";
+  else
+    profile += Joined(own);
+  bool written = WriteText(folder / "Config" / "Dolphin.ini", Joined(dolphin)) &&
+                 WriteText(folder / "Config" / "GCPadNew.ini", profile);
+  // The rest as the player has it.
+  for (const char* name : {"GFX.ini", "GCKeyNew.ini", "Hotkeys.ini"})
+  {
+    if (fs::is_regular_file(user_directory / "Config" / name, ec))
+      fs::copy_file(user_directory / "Config" / name, folder / "Config" / name,
+                    fs::copy_options::overwrite_existing, ec);
+  }
+  // config.ini: the player's; the labels of SR-Source Net Plus (players 5P-8P, the tags: the mod
+  // srnp_etiquettes) on when it is installed. Measured on 2026-11-25: without it, the relay's Start
+  // did not get past the game's Player Entry (0 of 2 games, 2 of 2 with it).
+  std::vector<std::string> frontend = Lines(ReadText(user_directory / "config.ini"));
+  bool labels_on = false;
+  for (const std::string& line : frontend)
+    labels_on = labels_on || Trimmed(line) == "mod=srnp_etiquettes";
+  bool labels_there = false;
+  for (const fs::path& mods : mod_folders)
+    labels_there = labels_there || fs::is_directory(mods / "srnp_etiquettes", ec);
+  if (labels_there && !labels_on)
+  {
+    bool added = false;
+    for (std::size_t i = 0; i < frontend.size() && !added; ++i)
+    {
+      if (Trimmed(frontend[i]) == "[Mods]")
+      {
+        frontend.insert(frontend.begin() + static_cast<std::ptrdiff_t>(i + 1), "mod=srnp_etiquettes");
+        added = true;
+      }
+    }
+    if (!added)
+    {
+      frontend.push_back("[Mods]");
+      frontend.push_back("mod=srnp_etiquettes");
+    }
+  }
+  if (!frontend.empty() || labels_there)
+    written = written && WriteText(folder / "config.ini", Joined(frontend));
+  // The file mods turned on: the runner looks for them beside itself and in the game's user folder's
+  // Mods only, so the player's are copied there (again only when a file changed).
+  for (const std::string& line : frontend)
+  {
+    const std::string entry = Trimmed(line);
+    if (!entry.starts_with("mod="))
+      continue;
+    const std::string name = Trimmed(std::string_view(entry).substr(4));
+    const fs::path source = user_directory / "Mods" / Utf8Path(name);
+    if (name.empty() || !fs::is_directory(source, ec))
+      continue;
+    // Folders reached through links and junctions too (fs::status follows them).
+    const auto copy_tree = [&ec](const auto& self, const fs::path& from, const fs::path& to) -> void {
+      fs::create_directories(to, ec);
+      for (fs::directory_iterator it(from, ec); !ec && it != fs::directory_iterator(); it.increment(ec))
+      {
+        const fs::file_status status = fs::status(it->path(), ec);
+        if (fs::is_directory(status))
+          self(self, it->path(), to / it->path().filename());
+        else if (fs::is_regular_file(status))
+          fs::copy_file(it->path(), to / it->path().filename(), fs::copy_options::update_existing, ec);
+      }
+    };
+    copy_tree(copy_tree, source, folder / "Mods" / Utf8Path(name));
+    if (ec)
+    {
+      if (error)
+        *error = "can't copy the mod " + name + ": " + ec.message();
+      return {};
+    }
+  }
+  if (!written || ec)
+  {
+    if (error)
+      *error = "can't write the settings in " + PathUtf8(folder) + (ec ? ": " + ec.message() : "");
+    return {};
+  }
+  return folder;
+}
+
+RunnerEnvironment MatchEnvironment(const MatchStart& match, const std::string& relay_address,
+                                   const std::string& tag)
+{
+  RunnerEnvironment environment;
+  environment.set = {
+      {"SRNP_RELAY", relay_address},
+      {"SRNP_SEAT", std::to_string(match.seat)},
+      {"SRNP_SEATS", std::to_string(match.seats)},
+      {"SRNP_RACERS", "1"},
+      {"SRNP_LOBBY", "2"},
+      {"SRNP_DELAY", std::to_string(match.delay)},
+      {"SRNP_TAG", tag},
+  };
+  environment.kept = {
+      {"SRNP_INPUT", "manette"},
+      {"SRNP_CHECK", "60"},
+      {"MODERNGEKKO_STATICRECOMP", "1"},
+  };
+  return environment;
+}
