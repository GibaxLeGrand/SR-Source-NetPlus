+// The tags' entry: the atlas' entry with the tags' texture, 128x128 C4 (its 16-word RGB5A3 palette
+// just before the texels, where the game's loader looks for it).
+void WriteTagEntry(std::uint32_t atlas, std::uint32_t texels)
+{
+  std::uint8_t* out = Guest(kTagEntry, kEntrySize);
+  const std::uint8_t* in = Guest(atlas, kEntrySize);
+  if (!out || !in)
+    return;
+  std::memcpy(out, in, kEntrySize);
+  Put32(out + 0x08, (Get32(in + 0x08) & ~0xFFu) | 8u);   // palette flags kept, C4
+  Put32(out + 0x0C, (kTagSize << 16) | kTagSize);         // 128, 128
+  Put32(out + 0x18, (kTagSize - 1) | ((kTagSize - 1) << 10) | (8u << 20));  // image0: C4
+  Put32(out + 0x1C, (texels & 0x01FFFFFFu) >> 5);
+  Put32(out + 0x24, 8);                                   // format
+  Put32(out + 0x2C, (0x0100u << 16) | (Get32(in + 0x2C) & 0xFFFFu));  // load count: 0x2000 / 32
+  Put32(out + 0x30, texels - 0x20);                       // the palette
+}
+
+// SRNP_TAGS: one tag per seat (racer k), upper case, up to 8 characters; '?' for one the font lacks.
+const std::array<std::string, 8>& Tags()
+{
+  static const std::array<std::string, 8> tags = [] {
+    std::array<std::string, 8> out{};
+    const char* v = std::getenv("SRNP_TAGS");
+    for (std::size_t k = 0; v && *v && k < 8; ++k)
+    {
+      const char* end = std::strchr(v, ',');
+      std::string tag(v, end ? static_cast<std::size_t>(end - v) : std::strlen(v));
+      for (char& c : tag)
+        c = static_cast<char>(std::toupper(static_cast<unsigned char>(c)));
+      out[k] = tag.substr(0, 8);
+      v = end ? end + 1 : nullptr;
+    }
+    return out;
+  }();
+  return tags;
+}
+
+const Glyph& GlyphOf(char c)
+{
+  for (const Glyph& g : kFont)
+    if (g.c == c)
+      return g;
+  for (const Glyph& g : kFont)
+    if (g.c == '?')
+      return g;
+  return kFont[0];
+}
+
+// The tags as the texture's C4 texels (8x8 tiles, high nibble first) and their widths. Palette
+// indices: 1 the navy outline, 3..9 the fill, row by row (construire_mod.py).
+void RenderTags(std::array<std::uint8_t, kTagSize * kTagSize / 2>* texels, std::array<int, 8>* widths)
+{
+  texels->fill(0);
+  for (std::size_t k = 0; k < 8; ++k)
+  {
+    const std::string& tag = Tags()[k];
+    (*widths)[k] = 0;
+    if (tag.empty())
+      continue;
+    // the fill, one column at a time (1 texel between two letters), then the outline around it
+    std::vector<std::array<bool, 7>> cols;
+    for (std::size_t i = 0; i < tag.size(); ++i)
+    {
+      const Glyph& g = GlyphOf(tag[i]);
+      if (i)
+        cols.push_back({});
+      for (int x = 0; x < g.w; ++x)
+      {
+        std::array<bool, 7> col{};
+        for (int y = 0; y < 7; ++y)
+          col[y] = (g.rows[y] >> (7 - x)) & 1;
+        cols.push_back(col);
+      }
+    }
+    const int w = std::min(static_cast<int>(cols.size()) + 2, static_cast<int>(kTagSize));
+    const int h = static_cast<int>(kTagHeight);
+    auto fill = [&](int x, int y) {
+      return x >= 1 && x - 1 < static_cast<int>(cols.size()) && y >= 1 && y <= 7 && cols[x - 1][y - 1];
+    };
+    for (int y = 0; y < h; ++y)
+    {
+      for (int x = 0; x < w; ++x)
+      {
+        int index = 0;
+        if (fill(x, y))
+          index = 3 + (y - 1);
+        else
+          for (int dy = -1; dy <= 1 && !index; ++dy)
+            for (int dx = -1; dx <= 1 && !index; ++dx)
+              if (fill(x + dx, y + dy))
+                index = 1;
+        if (!index)
+          continue;
+        const int ty = static_cast<int>(k) * 16 + y;
+        const std::size_t tile = static_cast<std::size_t>((ty / 8) * (kTagSize / 8) + x / 8);
+        std::uint8_t& byte = (*texels)[tile * 32 + (ty % 8) * 4 + (x % 8) / 2];
+        byte = static_cast<std::uint8_t>((x % 2) ? (byte & 0xF0) | index : (byte & 0x0F) | (index << 4));
+      }
+    }
+    (*widths)[k] = w;
+  }
+}
+
+// The tags' table: per racer, u0 v0 u1 v1 (floats) over the texture, then width and height in
+// texels (u16), the size of the quad on screen; width 0: no tag.
+void WriteTagTable(const std::array<int, 8>& widths)
+{
+  std::uint8_t* t = Guest(kTagTable, 8 * 0x18);
+  if (!t)
+    return;
+  auto put_float = [](std::uint8_t* p, float f) {
+    std::uint32_t v;
+    std::memcpy(&v, &f, 4);
+    Put32(p, v);
+  };
+  for (std::uint32_t k = 0; k < 8; ++k)
+  {
+    std::uint8_t* r = t + k * 0x18;
+    const float size = static_cast<float>(kTagSize);
+    put_float(r + 0x00, 0.0f);
+    put_float(r + 0x04, static_cast<float>(k * 16) / size);
+    put_float(r + 0x08, static_cast<float>(widths[k]) / size);
+    put_float(r + 0x0C, static_cast<float>(k * 16 + kTagHeight) / size);
+    r[0x10] = static_cast<std::uint8_t>(widths[k] >> 8);
+    r[0x11] = static_cast<std::uint8_t>(widths[k]);
+    r[0x12] = 0;
+    r[0x13] = widths[k] ? static_cast<std::uint8_t>(kTagHeight) : 0;
+    Put32(r + 0x14, 0);
+  }
+}
