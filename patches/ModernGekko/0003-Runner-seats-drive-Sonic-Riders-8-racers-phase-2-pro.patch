+// SR-Source Net Plus, phase 2 prototype: Sonic Riders' 8 racers driven by the relay's seats.
+// SPDX-License-Identifier: GPL-3.0-or-later
+//
+// Sonic Riders (GXEE8P) gives each racer a control byte (+0xBC: 0 human, 1 CPU) that picks the
+// function writing its controls each frame: the human one reads the controller structure the racer
+// points to (+0x0), the CPU one is the AI. Both write the same fields of the racer (+0xA28 actions,
+// +0xA38 stick, +0xA3A trigger). With SRNP_RACERS=1, seat k drives racer k: the runner fills a
+// controller structure for each seat, the way the game fills its own from a pad (main.dol
+// 0x80006778, without the rumble), in memory the game leaves alone, points racer k to it and makes
+// it human. A seat whose input carries kSeatAI gives its racer back to the AI for the rest of the
+// race, as for a player who left. When the game makes a racer CPU itself (at the finish line), the
+// runner leaves it alone. Viewport 0's camera follows the local seat's racer.
+#pragma once
+
+#include <array>
+#include <cstdint>
+#include <vector>
+
+namespace srnp
+{
+// A seat's input: buttons (bit 0..11: A B X Y Z Start Up Down Left Right L R; kSeatAI), main stick
+// X, Y and C-stick X, Y (signed, as PADClamp leaves them: about -72..72 and -59..59), L, R.
+using Pad = std::array<std::uint8_t, 8>;
+constexpr std::uint16_t kSeatAI = 0x8000;
+
+// On the emulation thread, after a present, with the official inputs of the next frame.
+void DriveRacers(const std::vector<Pad>& pads, int camera_seat);
+
+// FNV-1a 64 of the 8 racers, without the fields that follow the camera (measured on 2026-11-25).
+std::uint64_t RacersHash();
+
+// SRNP_PADCHECK=1: after each present, fills a copy of port 0's controller structure from the
+// PADStatus the game used and compares it with the game's (counts in the runner's log).
+void PadCheckOnFrame(std::uint64_t frame);
+}  // namespace srnp
