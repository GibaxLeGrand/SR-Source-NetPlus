+// SR-Source Net Plus, phase 2 prototype: Sonic Riders' 8 racers driven by the relay's seats.
+// See srnp_racers.hpp.
+// SPDX-License-Identifier: GPL-3.0-or-later
+#include "srnp_racers.hpp"
+
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <utility>
+
+#include "Core/HW/Memmap.h"
+#include "Core/System.h"
+
+namespace srnp
+{
+namespace
+{
+// GXEE8P, _Main.rel loaded at 0x803FBD00 (read in the game's code on 2026-11-25).
+constexpr std::uint32_t kRacers = 0x80609440;  // 8 racers of 0x1080 bytes
+constexpr std::uint32_t kRacerSize = 0x1080;
+constexpr std::uint32_t kGamePads = 0x801AF9F0;  // the game's controller structures (ports 0-3 filled)
+constexpr std::uint32_t kSeatPads = 0x80002C00;  // ours: low memory that stays at zero in races
+constexpr std::uint32_t kPadSize = 0x30;
+constexpr std::uint32_t kRacerCount = 0x8021B8C0;  // racers in the race (CPUs + humans)
+constexpr std::uint32_t kRacePhase = 0x801DFC80;   // 0x10 before the start, 0xE racing (and on results)
+constexpr std::uint32_t kCameraRacer = 0x80601F71;  // racer followed by viewport 0's camera
+constexpr std::uint32_t kPadStatusNow = 0x8021BB44;  // -> this frame's PADStatus[4] (12 bytes each)
+constexpr std::uint32_t kControl = 0xBC;           // racer byte: 0 human, 1 CPU
+
+std::uint8_t* Guest(std::uint32_t address, std::uint32_t size)
+{
+  return Core::System::GetInstance().GetMemory().GetPointerForRange(address, size);
+}
+std::uint32_t Get32(const std::uint8_t* p)
+{
+  return (std::uint32_t{p[0]} << 24) | (std::uint32_t{p[1]} << 16) | (std::uint32_t{p[2]} << 8) | p[3];
+}
+void Put32(std::uint8_t* p, std::uint32_t v)
+{
+  p[0] = static_cast<std::uint8_t>(v >> 24);
+  p[1] = static_cast<std::uint8_t>(v >> 16);
+  p[2] = static_cast<std::uint8_t>(v >> 8);
+  p[3] = static_cast<std::uint8_t>(v);
+}
+std::uint32_t Read32(std::uint32_t address)
+{
+  const std::uint8_t* p = Guest(address, 4);
+  return p ? Get32(p) : 0;
+}
+
+// A PADStatus after PADClamp: buttons (PAD_BUTTON_*), stick, substick, triggers.
+struct PadStatus
+{
+  std::uint16_t buttons = 0;
+  std::int8_t x = 0, y = 0, cx = 0, cy = 0;
+  std::uint8_t l = 0, r = 0;
+};
+
+// The game's conversion: single-precision product, truncated (fctiwz), low byte stored.
+std::uint8_t Scale(int v, float k)
+{
+  return static_cast<std::uint8_t>(static_cast<std::int32_t>(static_cast<float>(v) * k));
+}
+
+// One port of the game's controller update (main.dol 0x80006778), rumble left out, on a 0x30-byte
+// structure in the game's byte order.
+void FillPad(std::uint8_t* s, const PadStatus& in)
+{
+  const std::uint32_t old = Get32(s + 0x08);
+  const std::uint32_t b = in.buttons;
+  std::uint32_t held = ((b >> 8) & 0xF)                         // A B X Y -> 1 2 4 8
+                       | ((b << 1) & 0x10) | ((b << 3) & 0x20)  // up, down
+                       | ((b << 6) & 0x40) | ((b << 6) & 0x80)  // left, right
+                       | ((b >> 4) & 0x100)                     // start
+                       | ((b << 3) & 0x200) | ((b << 5) & 0x400) | ((b << 7) & 0x800);  // L R Z
+  s[0x18] = Scale(in.x, 1.38888883590698242f);
+  s[0x19] = Scale(in.y, 1.38888883590698242f);
+  s[0x1C] = Scale(in.cx, 1.69491529464721680f);
+  s[0x1D] = Scale(in.cy, 1.69491529464721680f);
+  s[0x1A] = Scale(in.l, 0.666666686534881592f);
+  s[0x1B] = Scale(in.r, 0.666666686534881592f);
+  const int sx = static_cast<std::int8_t>(s[0x18]);
+  const int sy = static_cast<std::int8_t>(s[0x19]);
+  held |= (sy > 10 ? 0x1000u : 0u) | (sy < -10 ? 0x2000u : 0u) | (sx < -10 ? 0x4000u : 0u) |
+          (sx > 10 ? 0x8000u : 0u);
+  std::uint32_t rep = Get32(s + 0x00), rep2 = Get32(s + 0x04), repeat = 0;
+  if (held == old)
+  {
+    if (++rep > 20)
+    {
+      if (++rep2 > 3)
+      {
+        rep2 = 0;
+        repeat = held;
+      }
+    }
+    else if (rep == 1)
+      repeat = held;
+  }
+  else
+    rep = rep2 = 0;
+  std::uint32_t idle = Get32(s + 0x24);
+  if (held == 0)
+  {
+    if (++idle >= 300)
+    {
+      s[0x20] = s[0x21] = s[0x22] = s[0x23] = 0;
+    }
+  }
+  else
+    idle = 0;
+  Put32(s + 0x00, rep);
+  Put32(s + 0x04, rep2);
+  Put32(s + 0x08, held);
+  Put32(s + 0x0C, held & (old ^ held));
+  Put32(s + 0x10, old & (old ^ held));
+  Put32(s + 0x14, repeat);
+  Put32(s + 0x24, idle);
+  s[0x28] = 1;
+}
+
+PadStatus FromSeat(const Pad& p)
+{
+  const unsigned bits = (static_cast<unsigned>(p[0]) << 8) | p[1];
+  // A B X Y Z Start Up Down Left Right L R -> PAD_BUTTON_*
+  static constexpr std::uint16_t kPad[] = {0x0100, 0x0200, 0x0400, 0x0800, 0x0010, 0x1000,
+                                           0x0008, 0x0004, 0x0001, 0x0002, 0x0040, 0x0020};
+  PadStatus s;
+  for (unsigned i = 0; i < 12; ++i)
+    if ((bits >> i) & 1)
+      s.buttons |= kPad[i];
+  s.x = static_cast<std::int8_t>(p[2]);
+  s.y = static_cast<std::int8_t>(p[3]);
+  s.cx = static_cast<std::int8_t>(p[4]);
+  s.cy = static_cast<std::int8_t>(p[5]);
+  s.l = p[6];
+  s.r = p[7];
+  return s;
+}
+
+struct SeatState
+{
+  int written = -1;       // last value we wrote to the racer's control byte
+  bool released = false;  // the AI has the racer until the end of the race
+  bool cpu_at_start = false;  // a CPU when the game set the race up: the AI can take it back
+  bool neutral = false;   // asked for the AI but cannot have it (human at the start): neutral pad
+};
+std::array<SeatState, 8> s_seats;
+bool s_race = false;
+std::uint64_t s_frames = 0;
+}  // namespace
+
+void DriveRacers(const std::vector<Pad>& pads, int camera_seat)
+{
+  ++s_frames;
+  std::uint8_t* racers = Guest(kRacers, 8 * kRacerSize);
+  std::uint8_t* seat_pads = Guest(kSeatPads, 8 * kPadSize);
+  if (!racers || !seat_pads)
+    return;
+  const std::uint32_t phase = Read32(kRacePhase);
+  const bool racing = Read32(kRacerCount) == 8 && (phase == 0x10 || phase == 0xE);
+  if (racing && !s_race && Get32(racers) == kGamePads)
+  {
+    // A race the game has set up (racer 0 points to port 0's structure), not taken yet.
+    s_race = true;
+    s_seats = {};
+    for (std::size_t k = 0; k < 8; ++k)
+      s_seats[k].cpu_at_start = racers[k * kRacerSize + kControl] == 1;
+    std::memset(seat_pads, 0, 8 * kPadSize);
+    std::fprintf(stderr, "[srnp racers] race (phase 0x%X): %zu seats drive racers 0-%zu\n", phase,
+                 pads.size(), pads.size() - 1);
+  }
+  if (!s_race)
+    return;
+  if (!racing)
+  {
+    // Race over: the AI finishes for the seats still driven (the game's CPUs only: the AI of a
+    // racer that was human at the start reads data the game did not make, 2026-11-25).
+    for (std::size_t k = 0; k < 8; ++k)
+      if (!s_seats[k].released && s_seats[k].written == 0 && s_seats[k].cpu_at_start)
+        racers[k * kRacerSize + kControl] = 1;
+    s_race = false;
+    std::fprintf(stderr, "[srnp racers] race phase 0x%X: racers back to the game\n", phase);
+    return;
+  }
+  for (std::size_t k = 0; k < pads.size() && k < 8; ++k)
+  {
+    std::uint8_t* racer = racers + k * kRacerSize;
+    SeatState& seat = s_seats[k];
+    if (seat.released)
+      continue;
+    if (seat.written >= 0 && racer[kControl] != seat.written)
+    {
+      seat.released = true;  // the game took the racer (finish line)
+      std::fprintf(stderr, "[srnp racers] racer %zu: made CPU by the game (finish?)\n", k);
+      continue;
+    }
+    Pad pad = pads[k];
+    if (((pad[0] << 8) | pad[1]) & kSeatAI)
+    {
+      if (seat.cpu_at_start)
+      {
+        racer[kControl] = 1;
+        seat.released = true;
+        std::fprintf(stderr, "[srnp racers] racer %zu: seat %zu gives it to the AI\n", k, k);
+        continue;
+      }
+      if (!seat.neutral)
+        std::fprintf(stderr, "[srnp racers] racer %zu: human at the start, no AI for it: neutral\n", k);
+      seat.neutral = true;
+      pad = {};
+    }
+    FillPad(seat_pads + k * kPadSize, FromSeat(pad));
+    Put32(racer, kSeatPads + static_cast<std::uint32_t>(k) * kPadSize);
+    racer[kControl] = 0;
+    seat.written = 0;
+  }
+  if (camera_seat >= 0 && camera_seat < 8)
+    if (std::uint8_t* camera = Guest(kCameraRacer, 1))
+      *camera = static_cast<std::uint8_t>(camera_seat);
+}
+
+std::uint64_t RacersHash()
+{
+  const std::uint8_t* racers = Guest(kRacers, 8 * kRacerSize);
+  if (!racers)
+    return 0;
+  // Fields that differ when the camera follows another racer (same positions and speeds over a
+  // whole race, 2026-11-25; 0xDC4-0xE74: two 0x58-byte records of the followed racer, colours,
+  // vectors and positions, likely a light or a shadow): left out of the checksum.
+  static constexpr std::pair<std::uint32_t, std::uint32_t> kCameraFields[] = {
+      {0x370, 0x394},   {0x8C0, 0x8C4},   {0xDC4, 0xE74},  {0xFD8, 0xFDC},
+      {0x1000, 0x1004}, {0x102C, 0x102D}, {0x1036, 0x1037}, {0x105C, 0x1060}};
+  std::uint64_t hash = 0xCBF29CE484222325ull;
+  for (std::uint32_t k = 0; k < 8; ++k)
+  {
+    for (std::uint32_t i = 0; i < kRacerSize; ++i)
+    {
+      bool skip = false;
+      for (const auto& [a, b] : kCameraFields)
+        skip = skip || (i >= a && i < b);
+      hash ^= skip ? 0 : racers[k * kRacerSize + i];
+      hash *= 0x100000001B3ull;
+    }
+  }
+  return hash;
+}
+
+void PadCheckOnFrame(std::uint64_t frame)
+{
+  static const bool on = [] {
+    const char* v = std::getenv("SRNP_PADCHECK");
+    return v && *v && *v != '0';
+  }();
+  if (!on)
+    return;
+  static std::uint8_t shadow[kPadSize];
+  static bool started = false;
+  static std::uint32_t last_status = 0;
+  static std::uint64_t checked = 0, wrong = 0, skipped = 0;
+  const std::uint8_t* game = Guest(kGamePads, kPadSize);
+  const std::uint32_t status_at = Read32(kPadStatusNow);
+  const std::uint8_t* status = status_at ? Guest(status_at, 12) : nullptr;
+  if (!game || !status)
+    return;
+  if (status_at == last_status)
+  {
+    ++skipped;  // the game did not read the pads since the last present
+    return;
+  }
+  last_status = status_at;
+  if (!started || status[10] != 0)
+  {
+    std::memcpy(shadow, game, kPadSize);  // start (or a pad error): copy the game's
+    started = true;
+    return;
+  }
+  PadStatus in;
+  in.buttons = static_cast<std::uint16_t>((status[0] << 8) | status[1]);
+  in.x = static_cast<std::int8_t>(status[2]);
+  in.y = static_cast<std::int8_t>(status[3]);
+  in.cx = static_cast<std::int8_t>(status[4]);
+  in.cy = static_cast<std::int8_t>(status[5]);
+  in.l = status[6];
+  in.r = status[7];
+  FillPad(shadow, in);
+  ++checked;
+  bool same = std::memcmp(shadow, game, 0x1E) == 0 && std::memcmp(shadow + 0x24, game + 0x24, 5) == 0;
+  if (!same)
+  {
+    if (++wrong <= 5)
+    {
+      std::fprintf(stderr, "[srnp padcheck] frame %llu differs; status %02x%02x %d %d %d %d %u %u\n",
+                   static_cast<unsigned long long>(frame), status[0], status[1], in.x, in.y, in.cx,
+                   in.cy, in.l, in.r);
+      for (int part = 0; part < 2; ++part)
+      {
+        const std::uint8_t* p = part ? game : shadow;
+        std::fprintf(stderr, "[srnp padcheck]   %s:", part ? "game" : "ours");
+        for (std::uint32_t i = 0; i < 0x2C; i += 4)
+          std::fprintf(stderr, " %08x", Get32(p + i));
+        std::fprintf(stderr, "\n");
+      }
+    }
+    std::memcpy(shadow, game, kPadSize);
+  }
+  if (checked % 600 == 0)
+    std::fprintf(stderr, "[srnp padcheck] %llu frames compared, %llu different, %llu skipped\n",
+                 static_cast<unsigned long long>(checked), static_cast<unsigned long long>(wrong),
+                 static_cast<unsigned long long>(skipped));
+}
+}  // namespace srnp
