+bool s_object_zones_on = false;
+int s_object_zones_seat = 0;
+
+std::uint32_t ZoneSiteWord(const ZoneSite& z, int seat)
+{
+  return (z.original & 0xFFFF0000u) | ((z.original + z.step * static_cast<std::uint32_t>(seat)) & 0xFFFFu);
+}
+
+void PatchObjectZones(int seat)
+{
+  static const bool off = [] {
+    const char* v = std::getenv("SRNP_OBJETS");
+    return v && *v == '0';
+  }();
+  const bool on = !off && seat >= 0 && seat < 8;
+  if (on == s_object_zones_on)
+    return;
+  const int from = s_object_zones_on ? s_object_zones_seat : 0;
+  const int to = on ? seat : 0;
+  for (const ZoneSite& z : kObjectZoneSites)
+  {
+    if (Read32(z.address) != ZoneSiteWord(z, from))
+    {
+      std::fprintf(stderr, "[srnp racers] objects: 0x%08X holds %08X, not %08X: left alone\n", z.address,
+                   Read32(z.address), ZoneSiteWord(z, from));
+      return;
+    }
+  }
+  auto& jit = Core::System::GetInstance().GetJitInterface();
+  for (const ZoneSite& z : kObjectZoneSites)
+  {
+    if (std::uint8_t* p = Guest(z.address, 4))
+      Put32(p, ZoneSiteWord(z, to));
+    jit.InvalidateICache(z.address, 4, true);
+  }
+  s_object_zones_on = on;
+  s_object_zones_seat = to;
+  std::fprintf(stderr, "[srnp racers] objects: %zu sites drawn for racer %d's zone\n",
+               std::size(kObjectZoneSites), to);
+}
