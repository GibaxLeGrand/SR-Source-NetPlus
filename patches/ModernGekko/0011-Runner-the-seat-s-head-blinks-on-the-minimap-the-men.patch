 #include <imgui.h>
 
@@ -734,7 +735,10 @@ std::unique_ptr<GameMenu> GameMenu::Create(const GameMenuSettings& settings, Gam
   auto impl = std::make_unique<Impl>();
   impl->settings = settings;
