diff --git a/src/runtime/srnp_racers.cpp b/src/runtime/srnp_racers.cpp
index 1a30c93..21a2cea 100644
--- a/src/runtime/srnp_racers.cpp
+++ b/src/runtime/srnp_racers.cpp
@@ -171,7 +171,15 @@ constexpr CodeWord kHudCode[] = {
     {0x8042EEF8, 0x809A0B98},  // lwz r4, 0xB98(r26)
     {0x8042BC10, 0x39C49440},  // addi r14, r4, -0x6BC0: racer 0 in the HUD task 0x8042BBEC
     {0x80421D20, 0x3B649440},  // addi r27, r4, -0x6BC0: racer 0 in the HUD task 0x80421D00 (rank)
+    {0x80415C54, 0x89331029},  // lbz r9, 0x1029(r19): the minimap's racer index (below)
 };
+// The minimap (task 0x80414758) draws every racer's head, from last place to first, the players'
+// heads (index +0x1029 below the player count, 0x8021B8C8) bright and the others greyed: on a 1P
+// machine, racer 0. For this machine's seat to be the bright one, the index is read through a few
+// words of code in free low memory (after the seats' pads): index - seat, so that only the seat's
+// racer is below 1 (unsigned). 2026-11-25.
+constexpr std::uint32_t kMinimapIndex = 0x80415C54;
+constexpr std::uint32_t kMinimapCave = 0x80002E00;
 int s_hud_seat = 0;
 
 void PatchHud(int seat)
@@ -189,6 +197,8 @@ void PatchHud(int seat)
       0x809A0000u | ((0x0B98u - shift) & 0xFFFFu),           // lwz r4, 0xB98 - shift(r26)
       0x39C40000u | ((0x9440u + shift) & 0xFFFFu),           // addi r14, r4, -0x6BC0 + shift
       0x3B640000u | ((0x9440u + shift) & 0xFFFFu),           // addi r27, r4, -0x6BC0 + shift
+      // bl kMinimapCave (seat 0: the game's lbz)
+      seat ? 0x48000001u | ((kMinimapCave - kMinimapIndex) & 0x03FFFFFCu) : 0x89331029u,
   };
   if (s_hud_seat == 0)  // the game's code must be there (same game, same version)
   {
@@ -203,6 +213,13 @@ void PatchHud(int seat)
     }
   }
   auto& jit = Core::System::GetInstance().GetJitInterface();
+  if (std::uint8_t* cave = Guest(kMinimapCave, 12))
+  {
+    Put32(cave, 0x89331029u);                                              // lbz r9, 0x1029(r19)
+    Put32(cave + 4, 0x39290000u | ((0u - static_cast<std::uint32_t>(seat)) & 0xFFFFu));  // addi r9, r9, -seat
+    Put32(cave + 8, 0x4E800020u);                                          // blr
+    jit.InvalidateICache(kMinimapCave, 12, true);
+  }
   for (std::size_t i = 0; i < std::size(kHudCode); ++i)
   {
     if (std::uint8_t* p = Guest(kHudCode[i].address, 4))
@@ -366,6 +383,56 @@ void PatchAnimation(bool on)
                on ? "moved on (every machine alike)" : "the game's");
 }
 
+// SRNP_PATCH=<address>=<word>,... (hexadecimal): code words written for the race, for experiments
+// (finding which HUD task shows what); the game's words come back at the end of the race.
+std::vector<std::pair<std::uint32_t, std::uint32_t>> s_test_patch_saved;
+
+void PatchTest(bool on)
+{
+  static const std::vector<std::pair<std::uint32_t, std::uint32_t>> words = [] {
+    std::vector<std::pair<std::uint32_t, std::uint32_t>> list;
+    const char* v = std::getenv("SRNP_PATCH");
+    for (const char* p = v; p && *p;)
+    {
+      char* end = nullptr;
+      const unsigned long address = std::strtoul(p, &end, 16);
+      if (!end || *end != '=')
+        break;
+      const unsigned long word = std::strtoul(end + 1, &end, 16);
+      list.emplace_back(static_cast<std::uint32_t>(address), static_cast<std::uint32_t>(word));
+      p = end && *end == ',' ? end + 1 : nullptr;
+    }
+    return list;
+  }();
+  if (words.empty() || on == !s_test_patch_saved.empty())
+    return;
+  auto& jit = Core::System::GetInstance().GetJitInterface();
+  if (on)
+  {
+    for (const auto& [address, word] : words)
+    {
+      if (std::uint8_t* p = Guest(address, 4))
+      {
+        s_test_patch_saved.emplace_back(address, Get32(p));
+        Put32(p, word);
+        jit.InvalidateICache(address, 4, true);
+        std::fprintf(stderr, "[srnp racers] test patch: 0x%08X %08X -> %08X\n", address,
+                     s_test_patch_saved.back().second, word);
+      }
+    }
+  }
+  else
+  {
+    for (const auto& [address, word] : s_test_patch_saved)
+    {
+      if (std::uint8_t* p = Guest(address, 4))
+        Put32(p, word);
+      jit.InvalidateICache(address, 4, true);
+    }
+    s_test_patch_saved.clear();
+  }
+}
+
 bool DriveRacers(const std::vector<Pad>& pads, int camera_seat, int camera_seat2)
 {
   ++s_frames;
@@ -394,6 +461,7 @@ bool DriveRacers(const std::vector<Pad>& pads, int camera_seat, int camera_seat2
                  std::min<std::size_t>(pads.size(), count) - 1);
     PatchHud(camera_seat);
     PatchAnimation(true);
+    PatchTest(true);
   }
   if (!s_race)
     return false;
@@ -407,6 +475,7 @@ bool DriveRacers(const std::vector<Pad>& pads, int camera_seat, int camera_seat2
     s_race = false;
     PatchHud(0);
     PatchAnimation(false);
+    PatchTest(false);
     std::fprintf(stderr, "[srnp racers] race phase 0x%X: racers back to the game\n", phase);
     return false;
   }
