 void LobbySend(int seat, const LobbyLocal& l)
 {
   SendLine("PICK " + std::to_string(seat) + " " + std::to_string(l.character) + " " +
@@ -593,7 +601,7 @@ bool LobbyStep(LobbyLocal* l)
     const std::uint8_t* c = GuestByte(kRuleCourse);
     const std::uint8_t* laps = GuestByte(kRuleLaps);
     if (seat == 0 && c && laps && *c >= 1 && *c <= kCourses && *laps >= 1 && *laps <= kMaxLaps)
-      SendLine("RULES 0 " + std::to_string(*c) + " " + std::to_string(*laps));
+      SendRules(*c, *laps, std::max(s_relay.seats, RacersWanted() ? RacersWanted() : 8));
   }
   const auto set_ready = [&](bool ready) {
     l->ready = ready;
@@ -627,7 +635,7 @@ bool LobbyStep(LobbyLocal* l)
     {
       const char k = keys[i];
       bits = k == 'L' ? 0x100u : k == 'R' ? 0x200u : k == 'U' ? 0x40u : k == 'D' ? 0x80u : k == 'A' ? 0x1u :
-             k == 'B' ? 0x2u : k == 'X' ? 0x4u : k == 'Y' ? 0x8u : k == '+' ? 0x800u : k == '-' ? 0x400u : 0u;
+             k == 'B' ? 0x2u : k == 'X' ? 0x4u : k == 'Y' ? 0x8u : k == '+' ? 0x800u : k == '-' ? 0x400u : k == 'Z' ? 0x10u : 0u;
     }
   }
