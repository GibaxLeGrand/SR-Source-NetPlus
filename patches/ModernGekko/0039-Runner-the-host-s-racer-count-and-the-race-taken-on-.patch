-// The host (seat 0) also sets the rules while choosing: X/Y the course, R/L the laps (keys X Y + -).
+// The host (seat 0) also sets the rules while choosing: X/Y the course, R/L the laps, Z the racers
+// (keys X Y + - Z).
 struct LobbyLocal
 {
   int character = 0, gear = 0;
@@ -574,6 +577,11 @@ struct LobbyLocal
   std::chrono::steady_clock::time_point since;
 };
 
+void SendRules(int course, int laps, int racers)
+{
+  SendLine("RULES 0 " + std::to_string(course) + " " + std::to_string(laps) + " " + std::to_string(racers));
+}
