-  // The host's rules: X/Y the course, R/L the laps.
-  if (seat == 0 && s_rule_course >= 1 && (pressed & (0x4u | 0x8u | 0x400u | 0x800u)))
+  // The host's rules: X/Y the course, R/L the laps, Z the racers (from the seats to 8).
+  if (seat == 0 && s_rule_course >= 1 && (pressed & (0x4u | 0x8u | 0x10u | 0x400u | 0x800u)))
   {
