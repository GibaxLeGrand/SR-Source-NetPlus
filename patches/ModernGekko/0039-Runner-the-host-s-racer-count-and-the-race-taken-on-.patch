From 1a7eccaa7873e3479fe6599a14399592cc239845 Mon Sep 17 00:00:00 2001
From: GibaxLeGrand <48137851+GibaxLeGrand@users.noreply.github.com>
Date: Wed, 25 Nov 2026 21:33:06 +0100
Subject: [PATCH] Runner: the host's racer count, and the race taken on every
 course

The lobby host also sets the racers (Z: from the seats to 8; the AI drives the ones no seat has):
RULES carries it, every runner sets SRNP_NB_RACERS's count from it at GO, and the waiting screen shows
it ("4 RACERS").
On SEGA Illusion the runner never took the race (one view for all, the HUD of racer 0): 0x801DFC80 is
not a race phase but a value of the course's world (measured on the 16 courses: 0x10 on Player Entry
and while loading, then 0xE, 0xD, 0x16, 3, or still 0x10 on Digital Dimension and Babylon Guardian).
Sampled from Start on courses 1 and 7, 0x8021BB88 is 1 while the race loads and 0x8021C1C0 goes from 0
to 4 at the sample where 0x801DFC80 changed on Metal City: the race is taken on those.
Measured: SEGA Illusion with 3 seats and 4 racers, one view a runner (4th, 1st, 2nd), 39 identical
checksums; Digital Dimension and Metal City races taken as before, 39 and 40 identical checksums. The
16 course names checked on each race's title card.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/runtime/srnp_racers.cpp         | 32 +++++++++++++++++++----
 src/runtime/srnp_racers.hpp         |  5 ++++
 src/runtime/srnp_relay.cpp          | 40 +++++++++++++++++++----------
 src/runtime/srnp_relay.hpp          |  1 +
 src/runtime/srnp_waiting_screen.cpp | 11 ++++----
 5 files changed, 65 insertions(+), 24 deletions(-)

diff --git a/src/runtime/srnp_racers.cpp b/src/runtime/srnp_racers.cpp
index 52c9ec4..2aafead 100644
--- a/src/runtime/srnp_racers.cpp
+++ b/src/runtime/srnp_racers.cpp
@@ -4,6 +4,7 @@
 #include "srnp_racers.hpp"
 
 #include <algorithm>
+#include <atomic>
 #include <cstdio>
 #include <cstdlib>
 #include <cstring>
@@ -27,7 +28,14 @@ constexpr std::uint32_t kGamePads = 0x801AF9F0;  // the game's controller struct
 constexpr std::uint32_t kSeatPads = 0x80002C00;  // ours: low memory that stays at zero in races
 constexpr std::uint32_t kPadSize = 0x30;
 constexpr std::uint32_t kRacerCount = 0x8021B8C0;  // racers in the race (CPUs + humans)
-constexpr std::uint32_t kRacePhase = 0x801DFC80;   // 0x10 before the start, 0xE racing (and on results)
+// Not a phase (measured on 2026-11-25 on the 16 courses): 0x10 on Player Entry and while the race loads,
+// then a value of the course's world (0xE Metal City, 0xD Egg Factory, 3 SEGA Carnival, 0x10 still for
+// Digital Dimension and Babylon Guardian). Only logged now.
+constexpr std::uint32_t kRacePhase = 0x801DFC80;
+// The race runs (measured on 2026-11-25, courses 1 and 7, sampled from Start): 0x8021BB88 is 1 while the
+// race loads (from the racer count's change), 0 after; 0x8021C1C0 goes from 0 to 4 at the same sample
+// (when 0x801DFC80 changed on Metal City, where the runner took the race until then).
+constexpr std::uint32_t kRaceLoading = 0x8021BB88, kRaceScene = 0x8021C1C0;
 constexpr std::uint32_t kCameraRacer = 0x80601F71;  // racer followed by viewport 0's camera
 constexpr std::uint32_t kCameraRacer1 = 0x806021CD;  // viewport 1's (viewports 0x25C apart)
 constexpr std::uint32_t kPlayerCount = 0x8021B8C8;  // players (viewports)
@@ -375,6 +383,7 @@ int AllCpuMode()
 
 // SRNP_NB_RACERS=<n>: the number of racers the race is set up with (the menu only makes 8, or 4
 // with 3 or more players).
+std::atomic<int> s_nb_racers{-1};  // the lobby host's count (SetNbRacers), else SRNP_NB_RACERS
 int NbRacers()
 {
   static const int n = [] {
@@ -382,7 +391,8 @@ int NbRacers()
     const int x = v ? std::atoi(v) : 0;
     return x >= 1 && x <= 8 ? x : 0;
   }();
-  return n;
+  const int host = s_nb_racers;
+  return host >= 1 ? host : n;
 }
 
 // Between the menu's writing of the racers (after Start, the racer count leaves 1, the Player
@@ -461,6 +471,17 @@ int SeatGear(int seat)
   return seat >= 0 && seat < 8 ? Lobby()[static_cast<std::size_t>(seat)].gear : -1;
 }
 
+void SetNbRacers(int racers)
+{
+  if (racers >= 1 && racers <= 8)
+    s_nb_racers = racers;
+}
+
+int RacersWanted()
+{
+  return NbRacers();
+}
+
 int GearCount()
 {
   return kGears;
@@ -668,8 +689,8 @@ bool DriveRacers(const std::vector<Pad>& pads, int camera_seat, int camera_seat2
     SetUpRace(racers);
   const std::uint32_t phase = Read32(kRacePhase);
   const std::uint32_t count = Read32(kRacerCount);
-  // 0xE: the race is set up (0x10 while it loads: the game still writes the racers then).
-  const bool racing = count >= 2 && count <= 8 && phase == 0xE;
+  // The race is set up and runs (while it loads, the game still writes the racers).
+  const bool racing = count >= 2 && count <= 8 && Read32(kRaceLoading) == 0 && Read32(kRaceScene) == 4;
   if (racing && !s_race && Get32(racers) == kGamePads)
   {
     // A race the game has set up (racer 0 points to port 0's structure), not taken yet.
@@ -763,7 +784,8 @@ bool DriveRacers(const std::vector<Pad>& pads, int camera_seat, int camera_seat2
     PatchAnimation(false);
     PatchZones(false);
     PatchTest(false);
-    std::fprintf(stderr, "[srnp racers] race phase 0x%X: racers back to the game\n", phase);
+    std::fprintf(stderr, "[srnp racers] race over (0x%X, loading %u, scene %u): racers back to the game\n",
+                 phase, Read32(kRaceLoading), Read32(kRaceScene));
     return false;
   }
   for (std::size_t k = 0; k < pads.size() && k < count; ++k)
diff --git a/src/runtime/srnp_racers.hpp b/src/runtime/srnp_racers.hpp
