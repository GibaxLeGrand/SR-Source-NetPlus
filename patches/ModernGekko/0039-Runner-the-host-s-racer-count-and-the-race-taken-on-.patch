+    int racers = std::max(s_relay.seats, static_cast<int>(s_rule_racers));
     if (pressed & 0x4u)
       course = course % kCourses + 1;
     if (pressed & 0x8u)
@@ -695,7 +704,9 @@ bool LobbyStep(LobbyLocal* l)
