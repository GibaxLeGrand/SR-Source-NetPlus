--- a/src/runtime/srnp_racers.hpp
+++ b/src/runtime/srnp_racers.hpp
@@ -48,6 +48,11 @@ void SetSeatChoice(int seat, int character, int gear);
 int SeatCharacter(int seat);
 int SeatGear(int seat);
 
+// The racers in the race (the AI drives the ones no seat has): the lobby host's count, else
+// SRNP_NB_RACERS (0: the menu's).
+void SetNbRacers(int racers);
+int RacersWanted();
+
