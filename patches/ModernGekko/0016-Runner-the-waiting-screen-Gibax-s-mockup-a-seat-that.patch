+// SR-Source Net Plus: the waiting screen, while the runner waits for the relay's GO. See srnp_relay.hpp.
+// SPDX-License-Identifier: GPL-3.0-or-later
+//
+// Gibax's mockup (2026-11-25): at the top, "<n> Players", "<n> Racers", "<n>/<n> Ready"; then one
+// column a seat: its label ("1P".."8P", "COM" for a seat that left and that the AI takes over), its
+// character, and its state: a blue circle while the player is still on their way (the character drawn
+// faded), a green tick once there, a red cross for a seat that left. The labels and the characters'
+// heads are the game's own pictures: they are not in this repository, so this first version draws the
+// labels in the game's colours and the characters' names.
+//
+// The emulation thread waits in the relay's hook, so the game presents no frame: like the runner's menu
+// over a paused game, the last frame is presented again, on the video thread, with the screen over it.
+
+#include "srnp_relay.hpp"
+
+#include <imgui.h>
+
+#include "VideoCommon/AsyncRequests.h"
+#include "VideoCommon/Present.h"
+
+#include <algorithm>
+#include <atomic>
+#include <cmath>
+#include <cstdio>
+#include <string>
+
+namespace srnp
+{
+namespace
+{
+constexpr const char* kCharacters[] = {"Sonic",  "Tails",       "Knuckles", "Amy",  "Jet",    "Storm",
+                                       "Wave",   "Eggman",      "Cream",    "Rouge", "Shadow", "Super Sonic",
+                                       "NiGHTS", "AiAi",        "Ulala",    "E-10000G", "E-10000R"};
+
+std::atomic<bool> s_redraw_queued{false};
+
+ImU32 Rgba(int r, int g, int b, float a = 1.0f)
+{
+  return IM_COL32(r, g, b, static_cast<int>(std::clamp(a, 0.0f, 1.0f) * 255.0f));
+}
+
+void TextCentred(ImDrawList* list, ImFont* font, float size, ImVec2 centre, ImU32 colour,
+                 const char* text)
+{
+  const ImVec2 extent = font->CalcTextSizeA(size, 1e6f, 0.0f, text);
+  const ImVec2 at(centre.x - extent.x * 0.5f, centre.y - extent.y * 0.5f);
+  // A dark outline first, as the game's HUD text has.
+  for (const ImVec2 d : {ImVec2(-2, 0), ImVec2(2, 0), ImVec2(0, -2), ImVec2(0, 2)})
+    list->AddText(font, size, ImVec2(at.x + d.x, at.y + d.y), Rgba(8, 16, 48, 0.9f), text);
+  list->AddText(font, size, at, colour, text);
+}
+
+// The label over a racer, as the game draws it: a dark blue plate, white letters, an arrow under it.
+void Label(ImDrawList* list, ImFont* font, ImVec2 centre, float unit, const char* text, bool com)
+{
+  const float w = unit * 2.2f, h = unit * 1.15f;
+  const ImVec2 a(centre.x - w * 0.5f, centre.y - h * 0.5f), b(centre.x + w * 0.5f, centre.y + h * 0.5f);
+  const ImU32 top = com ? Rgba(70, 76, 96) : Rgba(36, 70, 160);
+  const ImU32 bottom = com ? Rgba(30, 32, 44) : Rgba(12, 26, 80);
+  list->AddRectFilledMultiColor(a, b, top, top, bottom, bottom);
+  list->AddRect(a, b, Rgba(230, 236, 255), unit * 0.25f, 0, unit * 0.08f);
+  const float t = unit * 0.32f;
+  list->AddTriangleFilled(ImVec2(centre.x - t, b.y), ImVec2(centre.x + t, b.y),
+                          ImVec2(centre.x, b.y + t * 1.2f), Rgba(230, 236, 255));
+  TextCentred(list, font, unit * 0.85f, centre, Rgba(255, 255, 255), text);
+}
+
+void Draw(const WaitView& view)
+{
+  ImDrawList* list = ImGui::GetForegroundDrawList();
+  ImFont* font = ImGui::GetFont();
+  const ImVec2 display = ImGui::GetIO().DisplaySize;
+  if (!list || !font || display.x <= 0.0f || display.y <= 0.0f || view.seats <= 0)
+    return;
+  const int seats = std::min(view.seats, 8);
+  const auto state = [&](int k) {
+    return k < static_cast<int>(view.states.size()) ? view.states[static_cast<std::size_t>(k)] : 'O';
+  };
+  int left = 0, ready = 0;
+  for (int k = 0; k < seats; ++k)
+  {
+    left += state(k) == 'X';
+    ready += state(k) == 'V';
+  }
+  const int players = seats - left;
+
+  list->AddRectFilled(ImVec2(0, 0), display, Rgba(6, 10, 28, 0.78f));
+  const float unit = std::min(display.y / 16.0f, display.x / (seats * 3.2f + 1.0f));
+  char line[64];
+  std::snprintf(line, sizeof(line), "%d Players", players);
+  TextCentred(list, font, unit * 1.1f, ImVec2(display.x * 0.5f, display.y * 0.14f), Rgba(255, 255, 255), line);
+  std::snprintf(line, sizeof(line), "%d Racers", seats);
+  TextCentred(list, font, unit * 1.1f, ImVec2(display.x * 0.5f, display.y * 0.22f), Rgba(255, 255, 255), line);
+  std::snprintf(line, sizeof(line), "%d/%d Ready", ready, players);
+  TextCentred(list, font, unit * 1.1f, ImVec2(display.x * 0.5f, display.y * 0.30f), Rgba(255, 214, 64), line);
+
+  const float column = unit * 3.2f;
+  const float x0 = display.x * 0.5f - column * (seats - 1) * 0.5f;
+  const double now = ImGui::GetTime();
+  for (int k = 0; k < seats; ++k)
+  {
+    const char s = state(k);
+    const float x = x0 + column * k;
+    const bool mine = std::find(view.local.begin(), view.local.end(), k) != view.local.end();
+    // The label: "nP", or "COM" for a seat the AI takes over.
+    char label[8];
+    std::snprintf(label, sizeof(label), s == 'X' ? "COM" : "%dP", k + 1);
+    Label(list, font, ImVec2(x, display.y * 0.45f), unit, label, s == 'X');
+    // The character: its name for now (the game's heads come later), faded while on the way.
+    const int character = view.characters[static_cast<std::size_t>(k)];
+    const char* name = s == 'X' ? "?" :
+                       character >= 0 && character < static_cast<int>(std::size(kCharacters)) ?
+                                         kCharacters[character] :
+                                         "...";
+    const float alpha = s == 'O' ? 0.45f : 1.0f;
+    const ImVec2 head(x, display.y * 0.60f);
+    list->AddCircleFilled(head, unit * 1.0f, s == 'O' ? Rgba(90, 140, 230, 0.35f) : Rgba(30, 40, 80, 0.85f));
+    list->AddCircle(head, unit * 1.0f, Rgba(230, 236, 255, alpha), 0, unit * 0.06f);
+    TextCentred(list, font, unit * 0.45f, head, Rgba(255, 255, 255, alpha), name);
+    // The state: blue circle (on the way, pulsing), green tick (there), red cross (left).
+    const ImVec2 mark(x, display.y * 0.76f);
+    const float r = unit * 0.45f;
+    if (s == 'V')
+    {
+      list->AddPolyline(std::array<ImVec2, 3>{ImVec2(mark.x - r, mark.y), ImVec2(mark.x - r * 0.3f, mark.y + r * 0.7f),
+                                              ImVec2(mark.x + r, mark.y - r * 0.8f)}.data(),
+                        3, Rgba(40, 200, 80), 0, unit * 0.22f);
+    }
+    else if (s == 'X')
+    {
+      list->AddLine(ImVec2(mark.x - r, mark.y - r), ImVec2(mark.x + r, mark.y + r), Rgba(230, 40, 40), unit * 0.22f);
+      list->AddLine(ImVec2(mark.x - r, mark.y + r), ImVec2(mark.x + r, mark.y - r), Rgba(230, 40, 40), unit * 0.22f);
+    }
+    else
+    {
+      const float pulse = 0.6f + 0.4f * static_cast<float>(std::sin(now * 4.0));
+      list->AddCircle(mark, r, Rgba(30, 150, 240, pulse), 0, unit * 0.2f);
+    }
+    if (mine)
+      TextCentred(list, font, unit * 0.5f, ImVec2(x, display.y * 0.86f), Rgba(255, 214, 64), "YOU");
+  }
+}
+}  // namespace
+
+void RedrawWhileWaiting()
+{
+  // One redraw queued at a time: the relay's lines come every 2 s at most, the video thread keeps up.
+  if (s_redraw_queued.exchange(true))
+    return;
+  AsyncRequests::GetInstance()->PushEvent([] {
+    s_redraw_queued = false;
+    const WaitView view = RelayWaitView();
+    if (!view.waiting || !g_presenter)
+      return;
+    Draw(view);
+    g_presenter->Present();
+    static int drawn = 0;
+    if (++drawn == 1 || drawn % 10 == 0)
+      std::fprintf(stderr, "[srnp relay] waiting screen drawn (%d): %s\n", drawn, view.states.c_str());
+  });
+}
+}  // namespace srnp
