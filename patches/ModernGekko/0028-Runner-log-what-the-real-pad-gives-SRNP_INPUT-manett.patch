From 664ea7a71b495084843c7539730b7f1875bd8f00 Mon Sep 17 00:00:00 2001
From: GibaxLeGrand <48137851+GibaxLeGrand@users.noreply.github.com>
Date: Wed, 25 Nov 2026 18:30:32 +0100
Subject: [PATCH] Runner: log what the real pad gives (SRNP_INPUT=manette): the
 first press, then every 600 reads

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/runtime/srnp_relay.cpp | 11 +++++++++++
 1 file changed, 11 insertions(+)

diff --git a/src/runtime/srnp_relay.cpp b/src/runtime/srnp_relay.cpp
index 773dd53..3716c3e 100644
--- a/src/runtime/srnp_relay.cpp
+++ b/src/runtime/srnp_relay.cpp
@@ -207,6 +207,17 @@ Pad RealPad()
     return p >= 1 && p <= 4 ? p - 1 : 3;
   }();
   const GCPadStatus s = ::Pad::GetStatus(port);
+  // What the pad gives: the first time anything is pressed, then every 600 calls.
+  static int calls = 0;
+  static bool seen = false;
+  const bool pressed = s.button != 0 || s.stickX < 100 || s.stickX > 156 || s.stickY < 100 ||
+                       s.stickY > 156 || s.triggerLeft > 40 || s.triggerRight > 40;
+  if ((pressed && !seen) || ++calls % 600 == 1)
+    std::fprintf(stderr,
+                 "[srnp relay] pad (GCPad%d): buttons %04X stick %u,%u C %u,%u L %u R %u connected %d\n",
+                 port + 1, s.button, s.stickX, s.stickY, s.substickX, s.substickY, s.triggerLeft,
+                 s.triggerRight, s.isConnected ? 1 : 0);
+  seen = seen || pressed;
   // PAD_BUTTON_* -> the relay's bits: A B X Y Z Start Up Down Left Right L R.
   static constexpr std::uint16_t kButtons[] = {0x0100, 0x0200, 0x0400, 0x0800, 0x0010, 0x1000,
                                                0x0008, 0x0004, 0x0001, 0x0002, 0x0040, 0x0020};
