+std::vector<std::string> MatchFileMods(const std::vector<fs::path>& mod_folders,
+                                       std::vector<std::string> enabled)
+{
+  std::error_code ec;
+  const bool labels_there = std::ranges::any_of(
+      mod_folders, [&](const fs::path& folder) { return fs::is_directory(folder / "srnp_etiquettes", ec); });
+  if (labels_there && std::ranges::find(enabled, "srnp_etiquettes") == enabled.end())
+    enabled.insert(enabled.begin(), "srnp_etiquettes");
+  return enabled;
+}
+
+std::string ModsFingerprint(const std::vector<fs::path>& mod_folders, const std::vector<std::string>& mods)
+{
+  std::uint64_t hash = 0xCBF29CE484222325ull;
+  const auto add = [&hash](std::string_view text) {
+    for (const char c : text)
+    {
+      hash ^= static_cast<unsigned char>(c);
+      hash *= 0x100000001B3ull;
+    }
+    hash ^= 0xFF;
+    hash *= 0x100000001B3ull;
+  };
+  std::error_code ec;
+  for (const std::string& id : mods)
+  {
+    // The first folder that has it, as the runner looks (its own Mods, then the user's).
+    fs::path folder;
+    for (const fs::path& mods_folder : mod_folders)
+    {
+      if (folder.empty() && fs::is_regular_file(mods_folder / id / "mod.ini", ec))
+        folder = mods_folder / id;
+    }
+    add(id);
+    if (folder.empty())
+    {
+      add("(missing)");
+      continue;
+    }
+    std::ifstream ini(folder / "mod.ini", std::ios::binary);
+    std::stringstream text;
+    text << ini.rdbuf();
+    add(text.str());
+    std::vector<std::string> entries;
+    for (const char* part : {"files", "patches.ini"})
+    {
+      const fs::path root = folder / part;
+      if (fs::is_regular_file(root, ec))
+        entries.push_back(std::string(part) + ":" + std::to_string(fs::file_size(root, ec)));
+      if (!fs::is_directory(root, ec))
+        continue;
+      // Folders reached through links and junctions too (fs::status follows them), as the copy does.
+      const auto list = [&](const auto& self, const fs::path& directory, const std::string& prefix) -> void {
+        for (fs::directory_iterator it(directory, ec); !ec && it != fs::directory_iterator(); it.increment(ec))
+        {
+          const std::u8string name8 = it->path().filename().u8string();
+          const std::string name = prefix + std::string(name8.begin(), name8.end());
+          const fs::file_status status = fs::status(it->path(), ec);
+          if (fs::is_directory(status))
+            self(self, it->path(), name + "/");
+          else if (fs::is_regular_file(status))
+            entries.push_back(name + ":" + std::to_string(fs::file_size(it->path(), ec)));
+        }
+      };
+      list(list, root, std::string(part) + "/");
+    }
+    std::ranges::sort(entries);
+    for (const std::string& entry : entries)
+      add(entry);
+  }
+  char text[17];
+  std::snprintf(text, sizeof(text), "%016llx", static_cast<unsigned long long>(hash));
+  return text;
+}
