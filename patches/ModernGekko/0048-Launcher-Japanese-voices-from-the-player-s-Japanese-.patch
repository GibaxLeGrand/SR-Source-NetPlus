new file mode 100644
index 0000000..a3a729c
--- /dev/null
+++ b/tools/launcher_voices.cpp
@@ -0,0 +1,179 @@
+// SR-Source Net Plus: the Japanese voices made from the player's Japanese disc. See launcher_voices.hpp.
+// SPDX-License-Identifier: GPL-3.0-or-later
+#include "launcher_voices.hpp"
+
+#include "text_paths.hpp"
+
+#include "DiscIO/DiscExtractor.h"
+#include "DiscIO/Filesystem.h"
+#include "DiscIO/Volume.h"
+
+#include <algorithm>
+#include <fstream>
+#include <map>
+#include <memory>
+#include <set>
+#include <system_error>
+#include <vector>
+
+namespace moderngekko::frontend::voices
+{
+namespace fs = std::filesystem;
+
+namespace
+{
+constexpr const char* MOD_INI =
+    "name=Japanese voices\n"
+    "game=GXEE8P\n"
+    "version=1.0\n"
+    "author=Gibax\n"
+    "description=The Japanese release's voices, cutscenes and movies (from your own Japanese "
+    "disc).\n";
+
+void Say(BuildState* state, std::string status)
+{
+  std::lock_guard lock(state->mutex);
+  state->status = std::move(status);
+}
+
+bool Fail(BuildState* state, std::string error)
+{
+  std::lock_guard lock(state->mutex);
+  state->error = std::move(error);
+  state->running = false;
+  return false;
+}
+
+// The two files hold the same bytes.
+bool SameFile(const fs::path& a, const fs::path& b)
+{
+  std::error_code ec;
+  if (fs::file_size(a, ec) != fs::file_size(b, ec) || ec)
+    return false;
+  std::ifstream fa(a, std::ios::binary), fb(b, std::ios::binary);
+  std::vector<char> ba(1 << 20), bb(1 << 20);
+  while (fa && fb)
+  {
+    fa.read(ba.data(), static_cast<std::streamsize>(ba.size()));
+    fb.read(bb.data(), static_cast<std::streamsize>(bb.size()));
+    if (fa.gcount() != fb.gcount() ||
+        !std::equal(ba.begin(), ba.begin() + fa.gcount(), bb.begin()))
+      return false;
+  }
+  return true;
+}
+}  // namespace
+
+std::string JapaneseName(std::string_view english)
+{
+  const std::string name(english);
+  if (name.starts_with("10") && name.ends_with(".DAT"))  // 10SONIC.DAT -> 10JSONIC.DAT
+    return "10J" + name.substr(2);
+  if (name == "VOICE_E.AFS")
+    return "VOICE.AFS";
+  if (name.starts_with("E") && name.ends_with("E.ADX"))  // E01E.ADX -> E01J.ADX
+    return name.substr(0, name.size() - 5) + "J.ADX";
+  // OP_E.ADX, OP_EPL2.ADX, TUTO_G_E.SFD, V_CHAO_E.AFS
+  std::string japanese = name;
+  for (std::size_t at = japanese.find("_E"); at != std::string::npos; at = japanese.find("_E", at + 2))
+    japanese.replace(at, 2, "_J");
+  return japanese;
+}
+
+bool Installed(const fs::path& mods_folder)
+{
+  std::error_code ec;
+  return fs::is_regular_file(mods_folder / MOD_ID / "mod.ini", ec) &&
+         fs::is_directory(mods_folder / MOD_ID / "files", ec);
+}
+
+bool BuildJapaneseVoices(const fs::path& japanese_disc, const fs::path& us_files,
+                         const fs::path& mods_folder, BuildState* state)
+{
+  Say(state, "Opening " + text::PathText(japanese_disc.filename()));
+  const std::unique_ptr<DiscIO::Volume> volume = DiscIO::CreateVolume(text::PathText(japanese_disc));
+  if (!volume)
+    return Fail(state, "This file is not a disc image the launcher can read.");
+  const DiscIO::Partition partition = volume->GetGamePartition();
+  const std::string disc_id = volume->GetGameID(partition);
+  if (disc_id != JAPANESE_DISC_ID)
+    return Fail(state, "This is not the Japanese Sonic Riders (" + std::string(JAPANESE_DISC_ID) +
+                           "): the disc says " + (disc_id.empty() ? std::string("nothing") : disc_id) +
+                           ".");
+  const DiscIO::FileSystem* filesystem = volume->GetFileSystem(partition);
+  if (!filesystem || !filesystem->IsValid())
+    return Fail(state, "The disc's files could not be read.");
+
+  // The files at the top of each disc, by name.
+  std::set<std::string> japanese;
+  for (const DiscIO::FileInfo& file : filesystem->GetRoot())
+  {
+    if (!file.IsDirectory())
+      japanese.insert(file.GetName());
+  }
+  std::set<std::string> english;
+  std::error_code ec;
+  for (fs::directory_iterator it(us_files, ec); !ec && it != fs::directory_iterator(); it.increment(ec))
+  {
+    if (it->is_regular_file(ec))
+      english.insert(text::PathText(it->path().filename()));
+  }
+  if (english.empty())
+    return Fail(state, "The US game's files were not found: extract Sonic Riders (GXEE8P) first.");
+
+  // The files only the US disc has, each with its Japanese counterpart.
+  std::vector<std::pair<std::string, std::string>> pairs;
+  for (const std::string& name : english)
+  {
+    if (japanese.contains(name))
+      continue;
+    const std::string counterpart = JapaneseName(name);
+    if (!japanese.contains(counterpart))
+      return Fail(state, "The Japanese disc has no " + counterpart + " for " + name + ".");
+    pairs.emplace_back(name, counterpart);
+  }
+  if (pairs.empty())
+    return Fail(state, "No voice file differs between the two discs.");
+
+  const fs::path folder = mods_folder / MOD_ID;
+  const fs::path files = folder / "files";
+  fs::create_directories(files, ec);
+  if (ec)
+    return Fail(state, "Can't make " + text::PathText(files) + ": " + ec.message());
+  // mod.ini last: until then the folder is no usable mod.
+  fs::remove(folder / "mod.ini", ec);
+  int copied = 0;
+  int same = 0;
+  for (std::size_t i = 0; i < pairs.size(); ++i)
+  {
+    const auto& [name, counterpart] = pairs[i];
+    Say(state, "Copying " + counterpart + " as " + name + " (" + std::to_string(i + 1) + "/" +
+                   std::to_string(pairs.size()) + ")");
+    const fs::path part = files / (name + ".part");
+    if (!DiscIO::ExportFile(*volume, partition, counterpart, text::PathText(part)))
+      return Fail(state, "Could not read " + counterpart + " from the disc.");
+    // A Japanese file identical to the English one changes nothing: left out.
+    if (SameFile(part, us_files / name))
+    {
+      fs::remove(part, ec);
+      fs::remove(files / name, ec);
+      ++same;
+      continue;
+    }
+    fs::rename(part, files / name, ec);
+    if (ec)
+      return Fail(state, "Can't write " + name + ": " + ec.message());
+    ++copied;
+  }
+  std::ofstream ini(folder / "mod.ini", std::ios::binary | std::ios::trunc);
+  ini << MOD_INI;
+  if (!ini)
+    return Fail(state, "Can't write the mod's mod.ini.");
+  ini.close();
+  std::lock_guard lock(state->mutex);
+  state->status = std::to_string(copied) + " files copied, " + std::to_string(same) + " identical left out";
+  state->finished = true;
+  state->running = false;
+  return true;
+}
+}  // namespace moderngekko::frontend::voices
