+#pragma once
+
+// SR-Source Net Plus: the Japanese voices, a file mod made from the player's own Japanese disc.
+// SPDX-License-Identifier: GPL-3.0-or-later
+//
+// Sonic Riders USA (GXEE8P) and the Japanese release (GXEJ8P) run the same code, and both know both
+// sets of names (10SONIC.DAT and 10JSONIC.DAT, E01E.ADX and E01J.ADX...): the US disc only has the
+// English ones. The mod srnp_voix_jp serves the Japanese files under the English names: voices in the
+// race (10*.DAT), the menus' (VOICE_E.AFS), the Chao's (V_CHAO_E.AFS), the story's cutscenes
+// (E01E-E16E.ADX), the films' sound (OP/ED/INSERT, PL2 too) and the tutorial film (TUTO_G_E.SFD).
+// Nothing of the game's code changes. The files come from the player's disc (any image the launcher
+// reads: ISO, RVZ...): nothing of the game is in this code. Made as tools/srnp's
+// construire_mod_voix_jp.py does: the files only the US disc has, each with its Japanese
+// counterpart; one identical to the English file (10AIAI.DAT, 10ULALA.DAT) is left out.
+//
+// Measured on 2026-11-25: the files of a mod do not load at the disc's pace (a cold start reaches the
+// demo race ~414 frames earlier with the mod), so online every player of a room needs the same mods
+// (the room checks it); a savestate keeps the voices it was made with.
+
+#include <filesystem>
+#include <mutex>
+#include <string>
+#include <string_view>
+
+namespace moderngekko::frontend::voices
+{
+inline constexpr const char* MOD_ID = "srnp_voix_jp";
+inline constexpr const char* JAPANESE_DISC_ID = "GXEJ8P";
+
+// The Japanese counterpart's name of a file only the US disc has.
+std::string JapaneseName(std::string_view english);
+
+// Where a build is, read by the launcher's page while it runs on its own thread.
+struct BuildState
+{
+  std::mutex mutex;
+  bool running = false;
+  bool finished = false;  // set once, when it succeeded
+  std::string status;
+  std::string error;
+};
+
+// Makes <mods_folder>/srnp_voix_jp (mod.ini, files/) from the Japanese disc image and the US game's
+// files folder (games/GXEE8P/files). False, with state->error, when it can't.
+bool BuildJapaneseVoices(const std::filesystem::path& japanese_disc,
+                         const std::filesystem::path& us_files,
+                         const std::filesystem::path& mods_folder, BuildState* state);
+
+// The mod is there (its mod.ini and files).
+bool Installed(const std::filesystem::path& mods_folder);
+}  // namespace moderngekko::frontend::voices
