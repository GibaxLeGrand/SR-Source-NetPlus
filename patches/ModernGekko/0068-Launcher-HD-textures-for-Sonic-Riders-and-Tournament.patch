diff --git a/tools/launcher_textures.cpp b/tools/launcher_textures.cpp
new file mode 100644
index 0000000..9b03dd9
--- /dev/null
+++ b/tools/launcher_textures.cpp
@@ -0,0 +1,144 @@
+// SR-Source Net Plus: HD textures installed as a file mod of one game (launcher_textures.hpp).
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#include "launcher_textures.hpp"
+
+#include <algorithm>
+#include <cctype>
+#include <fstream>
+#include <system_error>
+#include <vector>
+
+namespace moderngekko::frontend::textures
+{
+namespace fs = std::filesystem;
+
+namespace
+{
+std::string Utf8(const fs::path& path)
+{
+  const std::u8string text = path.u8string();
+  return std::string(text.begin(), text.end());
+}
+
+// A custom texture as Dolphin names them: tex1_..., .png or .dds (any case).
+bool IsCustomTexture(const fs::path& path)
+{
+  std::string name = Utf8(path.filename());
+  for (char& c : name)
+    c = static_cast<char>(std::tolower(static_cast<unsigned char>(c)));
+  return name.starts_with("tex1_") && (name.ends_with(".png") || name.ends_with(".dds"));
+}
+
+void Say(InstallState* state, std::string text)
+{
+  std::lock_guard lock(state->mutex);
+  state->status = std::move(text);
+}
+
+bool Fail(InstallState* state, std::string text)
+{
+  std::lock_guard lock(state->mutex);
+  state->error = std::move(text);
+  state->status.clear();
+  state->running = false;
+  return false;
+}
+}  // namespace
+
+std::string ModId(std::string_view game)
+{
+  return "srnp_textures_hd_" + std::string(game);
+}
+
+bool Installed(const fs::path& mods_folder, std::string_view game)
+{
+  std::error_code ec;
+  const fs::path mod = mods_folder / ModId(game);
+  return fs::is_regular_file(mod / "mod.ini", ec) && fs::is_directory(mod / "textures", ec);
+}
+
+bool InstallPack(const fs::path& pack, const fs::path& mods_folder, const std::string& game,
+                 const std::string& game_name, InstallState* state)
+{
+  std::error_code ec;
+  const fs::path mod = mods_folder / ModId(game);
+  const fs::path target_root = mod / "textures";
+  if (!fs::is_directory(pack, ec))
+    return Fail(state, "Not a folder: " + Utf8(pack));
+  // The pack is this mod's own textures (chosen again): nothing to do but keep it.
+  if (fs::equivalent(pack, target_root, ec))
+    return Fail(state, "This folder is already the mod's.");
+  ec.clear();
+  // A pack folder that holds the Mods folder (the user folder, say) would be read while it is made.
+  {
+    const fs::path inside = fs::weakly_canonical(mods_folder, ec).lexically_relative(fs::weakly_canonical(pack, ec));
+    if (!ec && !inside.empty() && *inside.begin() != "..")
+      return Fail(state, "The pack's folder can't hold the Mods folder: choose the pack's own folder.");
+    ec.clear();
+  }
+
+  // The textures, in the order the runtime reads a folder (later ones win on duplicates).
+  Say(state, "Looking for textures...");
+  std::vector<fs::path> found;
+  for (fs::recursive_directory_iterator it(pack, fs::directory_options::skip_permission_denied, ec), end;
+       !ec && it != end; it.increment(ec))
+  {
+    std::error_code entry_ec;
+    if (it->is_regular_file(entry_ec) && IsCustomTexture(it->path()))
+      found.push_back(it->path());
+  }
+  if (ec && found.empty())
+    return Fail(state, "Can't read " + Utf8(pack) + ": " + ec.message());
+  if (found.empty())
+    return Fail(state, "No texture in this folder (files named tex1_..., .png or .dds).");
+
+  // mod.ini goes last: until it is there, the folder is no mod (a half install loads nothing).
+  fs::remove(mod / "mod.ini", ec);
+  fs::create_directories(target_root, ec);
+  if (ec)
+    return Fail(state, "Can't make " + Utf8(target_root) + ": " + ec.message());
+  std::size_t linked = 0;
+  std::size_t copied = 0;
+  for (std::size_t i = 0; i < found.size(); ++i)
+  {
+    const fs::path relative = found[i].lexically_relative(pack);
+    const fs::path target = target_root / relative;
+    std::error_code file_ec;
+    fs::create_directories(target.parent_path(), file_ec);
+    fs::remove(target, file_ec);  // an earlier install's (a link to the old pack, or a copy)
+    file_ec.clear();
+    fs::create_hard_link(found[i], target, file_ec);
+    if (!file_ec)
+    {
+      ++linked;
+    }
+    else
+    {
+      file_ec.clear();
+      fs::copy_file(found[i], target, fs::copy_options::overwrite_existing, file_ec);
+      if (file_ec)
+        return Fail(state, "Can't copy " + Utf8(relative) + ": " + file_ec.message());
+      ++copied;
+    }
+    if (i % 50 == 0 || i + 1 == found.size())
+      Say(state, "Textures: " + std::to_string(i + 1) + " / " + std::to_string(found.size()));
+  }
+
+  std::ofstream ini(mod / "mod.ini", std::ios::binary | std::ios::trunc);
+  ini << "name=HD textures (" << game_name << ")\n"
+      << "game=" << game << "\n"
+      << "author=the pack's authors\n"
+      << "description=" << found.size() << " textures from " << Utf8(pack) << "\n";
+  ini.close();
+  if (!ini)
+    return Fail(state, "Can't write " + Utf8(mod / "mod.ini"));
+
+  std::lock_guard lock(state->mutex);
+  state->status = std::to_string(found.size()) + " textures installed (" + std::to_string(linked) +
+                  " linked, " + std::to_string(copied) + " copied).";
+  state->running = false;
+  state->finished = true;
+  return true;
+}
+}  // namespace moderngekko::frontend::textures
diff --git a/tools/launcher_textures.hpp b/tools/launcher_textures.hpp
