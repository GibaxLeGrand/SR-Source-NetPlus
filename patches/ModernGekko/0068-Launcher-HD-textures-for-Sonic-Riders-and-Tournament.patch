   const auto open_mods_page = [&] {
     current_page = LauncherPage::Mods;
     installed_mods = moderngekko::frontend::ListInstalledMods(mod_folders);
@@ -6177,6 +6215,113 @@ int main(int argc, char** argv)
       ImGui::PopTextWrapPos();
     }
     EndSection();
+    // SR-Source Net Plus: HD textures (launcher_textures.hpp): a pack the player has, installed as a
+    // texture mod of Sonic Riders or of Tournament Edition; its switch is also in the list of mods.
+    BeginSection("##mods_textures", Tr("HD TEXTURES"));
+    {
+      namespace textures = moderngekko::frontend::textures;
+      std::optional<fs::path> pack;
+      {
+        std::lock_guard lock(textures_dialog.mutex);
+        pack = std::exchange(textures_dialog.selected, std::nullopt);
+      }
+      bool installing = false;
+      bool installed_now = false;
+      std::string install_game;
+      std::string install_status;
+      std::string install_error;
+      {
+        std::lock_guard lock(textures_install.mutex);
+        installing = textures_install.running;
+        installed_now = std::exchange(textures_install.finished, false);
+        install_game = textures_install.game;
+        install_status = textures_install.status;
+        install_error = textures_install.error;
+      }
+      const auto start_install = [&](const fs::path& folder, const std::string& game) {
+        if (textures_thread.joinable())
+          textures_thread.join();
+        {
+          std::lock_guard lock(textures_install.mutex);
+          textures_install.running = true;
+          textures_install.game = game;
+          textures_install.error.clear();
+          textures_install.status.clear();
+        }
+        const char* game_name = online::OnlineGameName(game);
+        textures_thread = std::jthread([&textures_install, folder, mods = user_directory / "Mods", game,
+                                        name = std::string(*game_name ? game_name : game.c_str())] {
+          textures::InstallPack(folder, mods, game, name, &textures_install);
+        });
+        installing = true;
+        install_game = game;
+      };
+      if (pack && !installing && !textures_dialog_game.empty())
+        start_install(*pack, textures_dialog_game);
+      if (installed_now)
+      {
+        // The new mod in the list, and on.
+        open_mods_page();
+        set_mod_on(textures::ModId(install_game), true);
+      }
+      ImGui::PushTextWrapPos(0.0f);
+      ImGui::TextUnformatted(Tr("A texture pack you have (a folder of tex1_ files, PNG or DDS), drawn "
+                                "in place of the game's textures. Nothing of the game changes: online, "
+                                "each player can have it or not."));
+      for (const auto& [game, name] : online::ONLINE_GAMES)
+      {
+        ImGui::PushID(game);
+        const GameSlot* slot = slot_of(game);
+        const bool extracted = slot && slot->metadata;
+        const std::string id = textures::ModId(game);
