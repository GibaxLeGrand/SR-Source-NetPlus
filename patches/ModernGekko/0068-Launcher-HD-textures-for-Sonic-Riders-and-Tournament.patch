@@ -0,0 +1,47 @@
+#pragma once
+
+// SR-Source Net Plus: HD textures, a texture pack the player already has (Sonic Riders' HD pack, a
+// Tournament Edition pack...) installed as a file mod of one game.
+// SPDX-License-Identifier: GPL-3.0-or-later
+//
+// A mod with a textures/ folder (tools/file_mods.hpp, src/runtime/texture_mods.hpp): the runtime
+// gathers its tex1_*.png/.dds files into <user>/Cache/textures/<disc ID>/ with hard links and turns
+// Dolphin's custom textures on (prefetched). The launcher makes one such mod per game,
+// srnp_textures_hd_<disc ID>, from the pack's folder: its textures, in their subfolders, are linked
+// (hard links, no extra space) when the pack is on the user folder's drive, else copied there, so
+// that the cache and the online game folder can link them in turn. A pack's textures are named after
+// the texture they replace, so one game's pack also dresses the textures another game shares (Sonic
+// Riders' pack on Tournament Edition). Textures only change what is drawn: online, each player can
+// have them or not (they don't count in the room's mods).
+
+#include <filesystem>
+#include <mutex>
+#include <string>
+#include <string_view>
+
+namespace moderngekko::frontend::textures
+{
+// The mod's folder name for a game: srnp_textures_hd_<disc ID>.
+std::string ModId(std::string_view game);
+
+// Where an install is, read by the launcher's page while it runs on its own thread.
+struct InstallState
+{
+  std::mutex mutex;
+  bool running = false;
+  bool finished = false;  // set once, when it succeeded
+  std::string game;       // the game being installed
+  std::string status;
+  std::string error;
+};
+
+// Makes <mods_folder>/srnp_textures_hd_<game> (textures/, then mod.ini) from the pack's folder: every
+// tex1_*.png or .dds in it and its subfolders, linked or copied. Over an earlier install, the
+// textures it already has are replaced. False, with state->error, when it can't (no texture in the
+// folder, no room...).
+bool InstallPack(const std::filesystem::path& pack, const std::filesystem::path& mods_folder,
+                 const std::string& game, const std::string& game_name, InstallState* state);
+
+// The game's mod is there (its mod.ini and textures/).
+bool Installed(const std::filesystem::path& mods_folder, std::string_view game);
+}  // namespace moderngekko::frontend::textures
