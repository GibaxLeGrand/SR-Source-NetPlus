+        bool on = std::ranges::find(config.mods, id) != config.mods.end();
+        ImGui::Spacing();
+        ImGui::AlignTextToFramePadding();
+        ImGui::TextUnformatted(name);
+        ImGui::SameLine();
+        DrawStatusPill(!installed ? Tr("NOT INSTALLED") : on ? Tr("ON") : Tr("OFF"),
+                       installed && on ? LAUNCHER_ACCENT : ImVec4(0.55f, 0.55f, 0.58f, 1.0f), scale,
+                       false);
+        if (installed)
+        {
+          if (ImGui::Checkbox(Tr("On"), &on))
+            set_mod_on(id, on);
+          ImGui::SameLine();
+        }
+        ImGui::BeginDisabled(installing || !extracted);
+        if (ImGui::Button(installed ? Tr("Choose another pack...") : Tr("Choose the pack's folder...")))
+        {
+          textures_dialog_game = game;
+          const std::string documents = PathText(DocumentsDirectory());
+          SDL_ShowOpenFolderDialog(FileDialogCallback, &textures_dialog, window, documents.c_str(),
+                                   false);
+        }
+        // Tournament Edition: Sonic Riders' pack dresses the textures it shares (same names).
+        if (std::string_view(game) == "GXSRTE" && textures::Installed(user_directory / "Mods", "GXEE8P"))
+        {
+          ImGui::SameLine();
+          if (ImGui::Button(Tr("Use Sonic Riders' pack")))
+            start_install(user_directory / "Mods" / textures::ModId("GXEE8P") / "textures", game);
+        }
+        ImGui::EndDisabled();
+        if (!extracted)
+          ImGui::TextDisabled("%s", Tr("Extract this game in Game Files first."));
+        if (install_game == game)
+        {
+          if (!install_error.empty() && !installing)
+            ImGui::TextColored(ImVec4(1.0f, 0.75f, 0.3f, 1.0f), "%s", install_error.c_str());
+          else if (!install_status.empty())
+            ImGui::TextDisabled("%s", install_status.c_str());
+        }
+        ImGui::PopID();
+      }
+      ImGui::Spacing();
+      ImGui::TextDisabled("%s", Tr("The pack is linked (or copied) into your Mods folder; the first "
