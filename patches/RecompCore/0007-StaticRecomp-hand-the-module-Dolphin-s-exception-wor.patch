   using SetNativeValidFn = void (*)(u32 start, u32 end, int valid);
   SetNativeValidFn m_set_native_valid = nullptr;
   using SetGatherPipeFn = void (*)(u8** position, u8* start, void (*flush)(CPUState*));
-  SetGatherPipeFn m_set_gather_pipe = nullptr;  // SRNP_NO_HOOK_FLUSH=1 turns FlushDispatchCharge off (for bisecting)
+  SetGatherPipeFn m_set_gather_pipe = nullptr;
+  // SR-Source Net Plus: a module built with DOLRECOMP_EE_EXIT=pending leaves for the run loop where
+  // a write sets MSR[EE] only when this word (Dolphin's PowerPCState::Exceptions) has an external
+  // interrupt pending, which is when the run loop would deliver one there.
+  using SetExceptionsFn = void (*)(u32* word);
