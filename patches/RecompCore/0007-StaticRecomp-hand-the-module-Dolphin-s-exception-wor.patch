diff --git a/Source/Core/Core/PowerPC/StaticRecomp/StaticRecompCore_Hooks.cpp b/Source/Core/Core/PowerPC/StaticRecomp/StaticRecompCore_Hooks.cpp
index 3697d7b4cf..0815ccae73 100644
--- a/Source/Core/Core/PowerPC/StaticRecomp/StaticRecompCore_Hooks.cpp
+++ b/Source/Core/Core/PowerPC/StaticRecomp/StaticRecompCore_Hooks.cpp
@@ -209,6 +209,19 @@ void StaticRecompCore::PublishGatherPipe()
                inline_ok ? "yes" : "no");
 }
 
+// SR-Source Net Plus: hands the module Dolphin's exception word (DOLRECOMP_EE_EXIT=pending).
+// SRNP_EE_EXIT_ALWAYS=1 hands it none: generated code then leaves at every MSR[EE] 0->1, as before.
+void StaticRecompCore::PublishExceptions()
+{
+  if (!m_set_exceptions)
+    return;
+  const char* always = std::getenv("SRNP_EE_EXIT_ALWAYS");
+  const bool give = !(always && always[0] == '1');
+  m_set_exceptions(give ? &m_system.GetPPCState().Exceptions : nullptr);
+  std::fprintf(stderr, "[staticrecomp] exception word given to generated code: %s\n",
+               give ? "yes" : "no");
+}
