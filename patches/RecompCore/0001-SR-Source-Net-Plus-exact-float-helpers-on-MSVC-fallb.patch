diff --git a/GXRuntime/src/core/fp_fast_classify.h b/GXRuntime/src/core/fp_fast_classify.h
new file mode 100644
index 0000000000..2ff17d245e
--- /dev/null
+++ b/GXRuntime/src/core/fp_fast_classify.h
@@ -0,0 +1,68 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// SR-Source Net Plus (local change, measured on Windows): MSVC's C <math.h> turns isnan,
+// isinf and signbit into calls to _dclass/_fdclass/_dsign in ucrtbase, and the FP helpers
+// call them on every emulated operation (~7 % of the native core's time in a profile).
+// These test the bits inline and give the same answer for every input. GCC and Clang
+// already inline the standard macros, so they keep them.
+#ifndef GXRUNTIME_FP_FAST_CLASSIFY_H
+#define GXRUNTIME_FP_FAST_CLASSIFY_H
+
+#include <math.h>
+#include <string.h>
+
+// 2^e built from the exponent bits: exact for e in [-126, 127] (f32) and
+// [-1022, 1023] (f64), the same values ldexpf(1.0f, e) and ldexp(1.0, e) give.
+static inline float gx_pow2_f32(int e) {
+    unsigned int bits = (unsigned int)(e + 127) << 23;
+    float value;
+    memcpy(&value, &bits, sizeof(value));
+    return value;
+}
+
+static inline double gx_pow2_f64(int e) {
+    unsigned long long bits = (unsigned long long)(e + 1023) << 52;
+    double value;
+    memcpy(&value, &bits, sizeof(value));
+    return value;
+}
+
+#if defined(_MSC_VER) && !defined(__clang__) && !defined(__cplusplus)
+static __forceinline int gx_isnan_f64(double x) {
+    unsigned long long b;
+    memcpy(&b, &x, sizeof(b));
+    return (b & 0x7FFFFFFFFFFFFFFFull) > 0x7FF0000000000000ull;
+}
+static __forceinline int gx_isinf_f64(double x) {
+    unsigned long long b;
+    memcpy(&b, &x, sizeof(b));
+    return (b & 0x7FFFFFFFFFFFFFFFull) == 0x7FF0000000000000ull;
+}
+static __forceinline int gx_signbit_f64(double x) {
+    unsigned long long b;
+    memcpy(&b, &x, sizeof(b));
+    return (int)(b >> 63);
+}
+static __forceinline int gx_isnan_f32(float x) {
+    unsigned int b;
+    memcpy(&b, &x, sizeof(b));
+    return (b & 0x7FFFFFFFu) > 0x7F800000u;
+}
+static __forceinline int gx_isinf_f32(float x) {
+    unsigned int b;
+    memcpy(&b, &x, sizeof(b));
+    return (b & 0x7FFFFFFFu) == 0x7F800000u;
+}
+static __forceinline int gx_signbit_f32(float x) {
+    unsigned int b;
+    memcpy(&b, &x, sizeof(b));
+    return (int)(b >> 31);
+}
+#undef isnan
+#undef isinf
+#undef signbit
+#define isnan(x) (sizeof(x) == sizeof(float) ? gx_isnan_f32((float)(x)) : gx_isnan_f64((double)(x)))
+#define isinf(x) (sizeof(x) == sizeof(float) ? gx_isinf_f32((float)(x)) : gx_isinf_f64((double)(x)))
+#define signbit(x) (sizeof(x) == sizeof(float) ? gx_signbit_f32((float)(x)) : gx_signbit_f64((double)(x)))
+#endif
+
+#endif
