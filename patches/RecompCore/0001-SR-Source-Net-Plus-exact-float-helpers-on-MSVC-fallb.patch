diff --git a/Source/Core/Core/PowerPC/StaticRecomp/StaticRecompCore_Hooks.cpp b/Source/Core/Core/PowerPC/StaticRecomp/StaticRecompCore_Hooks.cpp
index 7b3d845cee..e39c7559e6 100644
--- a/Source/Core/Core/PowerPC/StaticRecomp/StaticRecompCore_Hooks.cpp
+++ b/Source/Core/Core/PowerPC/StaticRecomp/StaticRecompCore_Hooks.cpp
@@ -14,6 +14,51 @@
 
 #include <cstdio>
 
+// SR-Source Net Plus, local measurement (not upstream): SRNP_FALLBACK_STATS=1 counts
+// HookInstructionFallback calls per guest address and the host time spent in them,
+// printed at shutdown by SrnpDumpFallbackStats().
+#include <algorithm>
+#include <chrono>
+#include <cstdlib>
+#include <optional>
+#include <unordered_map>
+#include <utility>
+#include <vector>
+namespace srnp_fallback_stats
+{
+const bool enabled = std::getenv("SRNP_FALLBACK_STATS") != nullptr;
+std::unordered_map<u32, std::pair<u32, u64>> per_cia;  // cia -> (raw, count)
+u64 total_ns = 0;
+struct Timer
+{
+  std::chrono::steady_clock::time_point start = std::chrono::steady_clock::now();
+  ~Timer()
+  {
+    total_ns += static_cast<u64>(std::chrono::duration_cast<std::chrono::nanoseconds>(
+                                     std::chrono::steady_clock::now() - start)
+                                     .count());
+  }
+};
+}  // namespace srnp_fallback_stats
+
+void SrnpDumpFallbackStats()
+{
+  using namespace srnp_fallback_stats;
+  if (!enabled)
+    return;
+  u64 calls = 0;
+  std::vector<std::pair<u32, std::pair<u32, u64>>> sites(per_cia.begin(), per_cia.end());
+  for (const auto& site : sites)
+    calls += site.second.second;
+  std::sort(sites.begin(), sites.end(),
+            [](const auto& l, const auto& r) { return l.second.second > r.second.second; });
+  std::fprintf(stderr, "[srnp] fallback: %llu calls at %zu sites, %.3f s in the hook\n",
+               static_cast<unsigned long long>(calls), sites.size(), total_ns / 1e9);
+  for (std::size_t i = 0; i < std::min<std::size_t>(sites.size(), 24); ++i)
+    std::fprintf(stderr, "[srnp] fallback-site pc=%08x raw=%08x count=%llu\n", sites[i].first,
+                 sites[i].second.first, static_cast<unsigned long long>(sites[i].second.second));
+}
+
 namespace
 {
 constexpr u32 LOCKED_CACHE_BASE = 0xE0000000u;
@@ -367,6 +412,14 @@ void StaticRecompCore::HookInstructionFallback(CPUState* cpu, u32 raw, u32 cia)
   auto* core = static_cast<StaticRecompCore*>(cpu->external_user_data);
   cia = core->TranslateRelAddress(cia);
   ++core->m_hook_fallback_instructions;
+  std::optional<srnp_fallback_stats::Timer> srnp_timer;
+  if (srnp_fallback_stats::enabled)
+  {
+    auto& site = srnp_fallback_stats::per_cia[cia];
+    site.first = raw;
+    ++site.second;
+    srnp_timer.emplace();
+  }
 
   // Lockstep: a block that fell back to the interpreter for an unmodeled
   // instruction (DMA mtspr, cache op, ...) performed side effects not captured
