+#include "fp_fast_classify.h" /* SR-Source Net Plus: exact 2^e, inline isnan on MSVC */
 #if defined(__x86_64__) || defined(_M_X64)
 #include <immintrin.h>
 #endif
@@ -194,7 +195,9 @@ static u32 psq_type_size(u8 type) {
 static f64 psq_dequant(f64 value, s32 scale) {
     if (scale == 0)
         return (f64)(f32)value;
-    return (f64)(f32)ldexp(value, -scale);
+    /* SR-Source Net Plus: value * 2^-scale is exact here (a 16-bit integer and
+     * scale in [-32, 31]), the same double ldexp gives, without MSVC's call. */
+    return (f64)(f32)(value * gx_pow2_f64(-scale));
 }
 
 static f64 psq_load_value(CPUState* cpu, u32 ea, u8 type, s32 scale) {
@@ -215,7 +218,7 @@ static f64 psq_load_value(CPUState* cpu, u32 ea, u8 type, s32 scale) {
 }
 
 static s64 psq_quantize_int(f64 value, s64 min_value, s64 max_value, s32 scale) {
-    f32 conv = (f32)value * ldexpf(1.0f, scale);
+    f32 conv = (f32)value * gx_pow2_f32(scale); /* SR-Source Net Plus: = ldexpf(1.0f, scale) */
     if (isnan(conv))
         return 0;
     if (conv <= (f32)min_value)
