 .../PowerPC/StaticRecomp/StaticRecompCore.cpp |  4 ++
 .../StaticRecomp/StaticRecompCore_Hooks.cpp   | 53 +++++++++++++++
 5 files changed, 131 insertions(+), 2 deletions(-)
 create mode 100644 GXRuntime/src/core/fp_fast_classify.h

